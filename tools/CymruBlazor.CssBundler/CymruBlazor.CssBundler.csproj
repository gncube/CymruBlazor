<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Internal build tool - not a library, not shipped in the CymruBlazor
      package. LangVersion/Nullable/ImplicitUsings are inherited from the
      repo-root Directory.Build.props.
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CymruBlazor.CssBundler</RootNamespace>
    <AssemblyName>CymruBlazor.CssBundler</AssemblyName>

    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
