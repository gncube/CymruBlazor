@page "/404"

@namespace CymruBlazor.Demo.Pages

<CyContainer Size="ContainerSize.Medium">
    <CyCenter FullHeight="true" Style="min-height:60vh">
        <CyStack Orientation="Orientation.Vertical"
                 Gap="ComponentSize.Medium"
                 AlignItems="AlignItems.Center">
            <div style="font-size:4rem;line-height:1" aria-hidden="true">🔍</div>
            <h1 style="font-size:var(--cymru-font-size-3xl);margin:0">Page not found</h1>
            <p style="margin:0;color:var(--cymru-color-text-muted);text-align:center;max-width:40ch">
                There is no page at this address. Check the URL or use the
                navigation to find what you are looking for.
            </p>
            <a href="/" style="color:var(--cymru-color-primary);font-weight:600">
                ← Back to home
            </a>
        </CyStack>
    </CyCenter>
</CyContainer>
