@page "/forms/checkbox"
@namespace CymruBlazor.Demo.Pages.Components.Forms
@using CymruBlazor.Components.Layout
@using CymruBlazor.Components.Forms
@using CymruBlazor.Demo.Shared
@using Microsoft.AspNetCore.Components.Forms

<CyPageHeader Title="CyCheckbox" Subtitle="A single labelled checkbox field.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Forms" />
            <CyBreadcrumbItem Text="CyCheckbox" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-controls="panel-examples" aria-selected="@(_activeTab == Tab.Examples)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-controls="panel-api" aria-selected="@(_activeTab == Tab.Api)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-controls="panel-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
    <span class="cb-panel-caption">Preview</span>
    <div class="cb-workbench-preview" style="justify-content: flex-start;">
        <EditForm Model="_model" style="width: 100%; max-width: 22rem;">
            <CyCheckbox @bind-Value="_model.Consent"
                        Label="I consent to being contacted about this appointment"
                        HintText="@(string.IsNullOrEmpty(_hintText) ? null : _hintText)"
                        Required="_required"
                        Disabled="_disabled" />
        </EditForm>
    </div>

    <div class="cb-playground-grid">
        <DemoPropertyControls>
            <DemoPropertyTextInput Label="Hint text" @bind-Value="_hintText" />
            <DemoPropertySwitch Label="Required" @bind-Value="_required" />
            <DemoPropertySwitch Label="Disabled" @bind-Value="_disabled" />
        </DemoPropertyControls>

        <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
            <span class="cb-panel-caption">Generated code</span>
            <DemoCodeBlock Code="@GeneratedCode" Language="razor" />
        </div>
    </div>
    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
    <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
    <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private sealed class DemoModel
    {
        public bool Consent { get; set; }
    }

    private Tab _activeTab = Tab.Examples;
    private readonly DemoModel _model = new();
    private string _hintText = string.Empty;
    private bool _required;
    private bool _disabled;

    private string GeneratedCode =>
        $"""
        <CyCheckbox @bind-Value="model.Consent"
                    Label="I consent to being contacted about this appointment"{(string.IsNullOrEmpty(_hintText) ? "" : $"\n    HintText=\"{_hintText}\"")}{(_required ? "\n    Required=\"true\"" : "")}{(_disabled ? "\n    Disabled=\"true\"" : "")} />
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Label", "string", "-", "The checkbox's visible, programmatically-associated label."),
        new("HintText", "string?", "null", "Optional supporting text."),
        new("Required", "bool", "false", "Adds aria-required and a visual indicator."),
        new("Disabled", "bool", "false", "Disables the field."),
        new("Value", "bool", "false", "The bound checked state; use @bind-Value.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Label click target", "The label is wired to the input via for/id, so clicking the label text toggles the checkbox too."),
        new("Direct boolean binding", "Binds straight to the checked state rather than round-tripping through a string, avoiding a class of parsing edge cases for assistive tech.")
    ];
}
