@page "/forms/checkbox-group"
@namespace CymruBlazor.Demo.Pages.Components.Forms
@using CymruBlazor.Components.Layout
@using CymruBlazor.Components.Forms
@using CymruBlazor.Demo.SharedComponents
@using Microsoft.AspNetCore.Components.Forms

<CyPageHeader Title="CyCheckboxGroup" Subtitle="A fieldset of multiple selectable options.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Forms" />
            <CyBreadcrumbItem Text="CyCheckboxGroup" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="@Strings.Nav.ComponentDocumentationTabs">
    <button type="button" role="tab" id="tab-examples" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" aria-selected="@(_activeTab == Tab.Examples)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">@Strings.Nav.Examples</button>
    <button type="button" role="tab" id="tab-api" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" aria-selected="@(_activeTab == Tab.Api)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">@Strings.Nav.Api</button>
    <button type="button" role="tab" id="tab-accessibility" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" aria-selected="@(_activeTab == Tab.Accessibility)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">@Strings.Nav.Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
    <span class="cb-panel-caption">Preview</span>
    <div class="cb-workbench-preview" style="justify-content: flex-start;">
        <EditForm Model="_model" style="width: 100%; max-width: 24rem;">
            <CyCheckboxGroup TValue="string"
                             @bind-Value="_model.Services"
                             Label="Which services do you need?"
                             HintText="@(string.IsNullOrEmpty(_hintText) ? null : _hintText)"
                             Required="_required"
                             Disabled="_disabled"
                             Items="_serviceOptions" />
        </EditForm>
    </div>

    <div class="cb-playground-grid">
        <DemoPropertyControls>
            <DemoPropertyTextInput Label="Hint text" @bind-Value="_hintText" />
            <DemoPropertySwitch Label="Required" @bind-Value="_required" />
            <DemoPropertySwitch Label="Disabled" @bind-Value="_disabled" />
        </DemoPropertyControls>

        <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
            <span class="cb-panel-caption">Generated code</span>
            <CyCodeBlock Code="@GeneratedCode" Language="razor" />
            <a class="cb-open-in-github"
               href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Forms/CyCheckboxGroup.razor"
               target="_blank" rel="noopener noreferrer">
                Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
            </a>
        </div>
    </div>
    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
    <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
    <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private sealed class DemoModel
    {
        public IEnumerable<string> Services { get; set; } = ["phone"];
    }

    private Tab _activeTab = Tab.Examples;
    private readonly DemoModel _model = new();
    private string _hintText = string.Empty;
    private bool _required;
    private bool _disabled;
    private readonly IReadOnlyList<CyOption<string>> _serviceOptions =
    [
        new CyOption<string>("phone", "Phone") { Hint = "We will call you during office hours." },
        new CyOption<string>("email", "Email") { Hint = "We'll email your care plan updates." },
        new CyOption<string>("sms", "Text message") { Hint = "Receive appointment reminders by SMS." },
        new CyOption<string>("post", "Post") { Disabled = true }
    ];

    private string GeneratedCode =>
        $"""
        <CyCheckboxGroup TValue="string"
                         @bind-Value="model.Services"
                         Label="Which services do you need?"
                         Items="serviceOptions"{(string.IsNullOrEmpty(_hintText) ? "" : $"\n    HintText=\"{_hintText}\"")}{(_required ? "\n    Required=\"true\"" : "")}{(_disabled ? "\n    Disabled=\"true\"" : "")} />
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Label", "string", "-", "The fieldset's visible, programmatically-associated legend text."),
        new("HintText", "string?", "null", "Optional supporting text for the whole group."),
        new("Required", "bool", "false", "Adds a visual indicator for required selection, without a native group-level aria-required attribute."),
        new("Disabled", "bool", "false", "Disables every option in the group."),
        new("Items", "IEnumerable<CyOption<TValue>>?", "null", "The group's offered choices, rendered one checkbox per value."),
        new("Comparer", "IEqualityComparer<TValue>?", "null", "Custom value comparison when model values should match by a non-default equality rule."),
        new("Value", "IEnumerable<TValue>", "-", "The bound collection of selected values; use @bind-Value.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Native fieldset/legend", "The group label is exposed through a native <fieldset>/<legend>, so screen readers announce the collection as one logical question."),
        new("Per-option hints", "A choice-specific Hint is associated with that checkbox via aria-describedby without repeating the same text for the whole group."),
        new("Multi-select semantics", "Each checkbox remains a real checkbox input with its own state, rather than a custom widget lacking native selection semantics.")
    ];
}
