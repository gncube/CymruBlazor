@page "/foundations/typography"
@namespace CymruBlazor.Demo.Pages.Components.Foundations
@using CymruBlazor.Components.Layout
@using CymruBlazor.Components.Content
@using CymruBlazor.Demo.Shared
@using CymruBlazor.Enums

<CyPageHeader Title="Typography" Subtitle="The NHS Wales type scale, via CyTypography.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Foundations" />
            <CyBreadcrumbItem Text="Typography" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-controls="panel-examples" aria-selected="@(_activeTab == Tab.Examples)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-controls="panel-api" aria-selected="@(_activeTab == Tab.Api)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-controls="panel-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
    <span class="cb-panel-caption">Preview</span>
    <div class="cb-workbench-preview" style="flex-direction: column; align-items: stretch; gap: 0.5rem;">
        @foreach (var variant in _variants)
        {
            <CyTypography Variant="@variant">@variant.ToString() - The quick brown fox</CyTypography>
        }
    </div>

    <span class="cb-panel-caption">Generated code</span>
    <DemoCodeBlock Code="@GeneratedCode" Language="razor" />
    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
    <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
    <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;

    private readonly IReadOnlyList<TypographyVariant> _variants =
    [
        TypographyVariant.H1, TypographyVariant.H2, TypographyVariant.H3,
        TypographyVariant.H4, TypographyVariant.H5, TypographyVariant.H6,
        TypographyVariant.BodyLarge, TypographyVariant.Body, TypographyVariant.BodySmall,
        TypographyVariant.Caption, TypographyVariant.Label
    ];

    private const string GeneratedCode =
        """
        <CyTypography Variant="TypographyVariant.H2">Section heading</CyTypography>
        <CyTypography Variant="TypographyVariant.Body">Body copy.</CyTypography>

        <!-- Visually H2, but semantically H3, to keep heading levels sequential -->
        <CyTypography Variant="TypographyVariant.H2" As="h3">Section heading</CyTypography>
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Variant", "TypographyVariant", "TypographyVariant.Body", "H1-H6, BodyLarge, Body, BodySmall, Caption, or Label. Drives both styling and the default HTML tag."),
        new("As", "string?", "null", "Overrides the rendered HTML tag while keeping Variant's visual styling."),
        new("ChildContent", "RenderFragment", "null", "The text content.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Sequential heading levels", "As exists specifically so a heading can look like an H2 while being semantically an H3+, avoiding the common WCAG 1.3.1/2.4.6 failure of skipping heading levels purely for visual effect."),
        new("Real semantic elements", "Renders actual <h1>-<h6>/<p>/<span> tags rather than styled <div>s, so headings show up correctly in a screen reader's headings list.")
    ];
}
