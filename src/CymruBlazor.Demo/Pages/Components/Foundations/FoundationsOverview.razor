@page "/foundations"
@namespace CymruBlazor.Demo.Pages.Components.Foundations
@implements IDisposable
@using CymruBlazor.Components.Content
@using CymruBlazor.Components.Layout
@using CymruBlazor.Enums

@if (Strings.Language == AppLanguage.Welsh)
{
    <div class="cb-page-header">
        <h1 class="cb-page-title">Seiliau</h1>
        <p class="cb-page-description">
            Blociau adeiladu gweledol a thechnegol craidd: tocynnau dylunio, darparwr thema,
            graddfa deipograffeg, gwasanaeth lleoleiddio, a phrimitifau rheoli ffocws.
        </p>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Sylfeini Craidd</h2>
        <CyGrid Columns="GridColumns.Three" Gap="GridGap.Medium">
            <CyCard Href="/foundations/tokens">
                <Header><strong>Tocynnau Dylunio</strong></Header>
                <ChildContent>Tocynnau lliw, bylchau a graddfa ffont wedi'u halinio â brand GIG Cymru.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/theme-provider">
                <Header><strong>Darparwr Thema</strong></Header>
                <ChildContent>Themu amser rhedeg ar draws yr ap gyda moddau golau, tywyll, a chyferbyniad uchel.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/typography">
                <Header><strong>Teipograffeg</strong></Header>
                <ChildContent>Graddfa deip hygyrch a hierarchaeth benawdau semantig.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/localisation">
                <Header><strong>Lleoleiddio</strong></Header>
                <ChildContent>Gwasanaeth llinynnau dwyieithog Cymraeg a Saesneg gyda newid amser rhedeg.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/focus-trap">
                <Header><strong>CyFocusTrap</strong></Header>
                <ChildContent>Primitif cynhwysiant ffocws bysellfwrdd ar gyfer haenau a droriau arferol.</ChildContent>
            </CyCard>
        </CyGrid>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Egwyddorion dylunio</h2>
        <ul style="color:var(--cymru-color-text);line-height:1.75;padding-inline-start:var(--cymru-space-6)">
            <li>
                <strong>Arddullio tocyn-gyntaf.</strong> Mae pob cydran yn defnyddio priodweddau personol CSS
                (<code>--cymru-*</code>) yn hytrach na lliwiau neu werthoedd picsel caled, gan sicrhau brandio cyson
                a themu di-drafferth.
            </li>
            <li>
                <strong>Dwyieithog yn ôl dyluniad.</strong> Mae gan y Gymraeg a'r Saesneg statws cyfartal o'r cychwyn cyntaf;
                mae cydrannau'n darparu labeli Saesneg rhagosodedig a throsiadau paramedr llawn ar gyfer y Gymraeg.
            </li>
            <li>
                <strong>Hygyrchedd safonol.</strong> Mae trefn ffocws, cymarebau cyferbyniad, a chydymffurfiaeth WCAG 2.2 AA
                wedi'u cynnwys yn uniongyrchol yn y tocynnau sylfaen a'r primitifau.
            </li>
        </ul>
    </div>
}
else
{
    <div class="cb-page-header">
        <h1 class="cb-page-title">Foundations</h1>
        <p class="cb-page-description">
            Core visual and technical building blocks: design tokens, theme provider,
            typography scale, localisation service, and focus management primitives.
        </p>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Core Foundations</h2>
        <CyGrid Columns="GridColumns.Three" Gap="GridGap.Medium">
            <CyCard Href="/foundations/tokens">
                <Header><strong>Design Tokens</strong></Header>
                <ChildContent>Colour, spacing, and font scale tokens aligned to NHS Wales branding.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/theme-provider">
                <Header><strong>Theme Provider</strong></Header>
                <ChildContent>App-wide runtime theming with light, dark, and high-contrast modes.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/typography">
                <Header><strong>Typography</strong></Header>
                <ChildContent>Accessible type scale and semantic heading hierarchy.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/localisation">
                <Header><strong>Localisation</strong></Header>
                <ChildContent>Bilingual English and Welsh string service with runtime switching.</ChildContent>
            </CyCard>
            <CyCard Href="/foundations/focus-trap">
                <Header><strong>CyFocusTrap</strong></Header>
                <ChildContent>Keyboard focus containment primitive for custom overlays and drawers.</ChildContent>
            </CyCard>
        </CyGrid>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Design principles</h2>
        <ul style="color:var(--cymru-color-text);line-height:1.75;padding-inline-start:var(--cymru-space-6)">
            <li>
                <strong>Token-first styling.</strong> All components consume CSS custom properties
                (<code>--cymru-*</code>) rather than hardcoded colors or pixel values, ensuring consistent
                branding and effortless theming.
            </li>
            <li>
                <strong>Bilingual by design.</strong> Welsh and English have equal status from the outset;
                components provide default English labels and full parameter overrides for Cymraeg.
            </li>
            <li>
                <strong>Standardized accessibility.</strong> Focus order, contrast ratios, and WCAG 2.2 AA
                compliance are built directly into the foundation tokens and primitives.
            </li>
        </ul>
    </div>
}

@code {
    protected override void OnInitialized() => Strings.Changed += HandleStringsChanged;
    private void HandleStringsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Strings.Changed -= HandleStringsChanged;
}
