@page "/content/card"
@namespace CymruBlazor.Demo.Pages.Components.Content
@using CymruBlazor.Components.Layout
@using CymruBlazor.Components.Content
@using CymruBlazor.Demo.SharedComponents

<CyPageHeader Title="CyCard" Subtitle="A content container with optional header, footer, and whole-card link.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Content" />
            <CyBreadcrumbItem Text="CyCard" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="@Strings.Nav.ComponentDocumentationTabs">
    <button type="button" role="tab" id="tab-examples" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" aria-selected="@(_activeTab == Tab.Examples)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">@Strings.Nav.Examples</button>
    <button type="button" role="tab" id="tab-api" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" aria-selected="@(_activeTab == Tab.Api)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">@Strings.Nav.Api</button>
    <button type="button" role="tab" id="tab-accessibility" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" aria-selected="@(_activeTab == Tab.Accessibility)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">@Strings.Nav.Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
    <span class="cb-panel-caption">Preview</span>
    <div class="cb-workbench-preview">
        @if (_asLink)
        {
            <CyCard Elevation="_elevation" Href="#" Style="max-width: 20rem;">
                <Header><strong>Cardiff and Vale clinic</strong></Header>
                <ChildContent>Next available appointment: Thursday, 9:15am.</ChildContent>
            </CyCard>
        }
        else
        {
            <CyCard Elevation="_elevation" Style="max-width: 20rem;">
                <Header><strong>Cardiff and Vale clinic</strong></Header>
                <ChildContent>Next available appointment: Thursday, 9:15am.</ChildContent>
                <Footer><a href="#">View details</a></Footer>
            </CyCard>
        }
    </div>

    <span class="cb-panel-caption">Title, variants and collapsible (1.12.0)</span>
    <div class="cb-workbench-preview" style="justify-content: flex-start; align-items: stretch; flex-direction: column; gap: var(--cymru-space-4);">
        <CyCard Title="Clinic details" HeadingLevel="2" Variant="CyCardVariant.Outlined" Padding="CyCardPadding.Compact">
            An outlined card with compact padding and a title.
        </CyCard>
        <CyCard Title="Flat panel" HeadingLevel="2" Variant="CyCardVariant.Flat">
            A flat, filled panel with no shadow.
        </CyCard>
        <CyCard Title="Collapsible card" HeadingLevel="2" Collapsible="true" @bind-Expanded="_expanded">
            The title is a button that opens and closes this body.
        </CyCard>
        <p>The collapsible card is @(_expanded ? "open" : "closed").</p>
    </div>

    <div class="cb-playground-grid">
        <DemoPropertyControls>
            <DemoPropertyToggleGroup Label="Elevation" @bind-Value="_elevation" Options="_elevationOptions" TValue="ComponentElevation" />
            @if (_elevation != ComponentElevation.None)
            {
                <p style="font-size: 0.8rem; color: var(--docs-text-muted); margin: -0.5rem 0 0;">
                    Small, Medium, and Large intentionally render the same shadow - see the API tab for why.
                </p>
            }
            <DemoPropertySwitch Label="Whole card is a link (Href)" @bind-Value="_asLink" />
        </DemoPropertyControls>

        <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
            <span class="cb-panel-caption">Generated code</span>
            <CyCodeBlock Code="@GeneratedCode" Language="razor" />
            <a class="cb-open-in-github"
               href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Content/CyCard.razor"
               target="_blank" rel="noopener noreferrer">
                Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
            </a>
        </div>
    </div>
    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
    <DemoApiTable Parameters="_apiDocs" />
    <p class="cb-section-description" style="margin-top:1rem;">
        <strong>Why Small/Medium/Large look identical:</strong> the design system defines exactly one shadow role
        for cards - a gentle "raised" lift, used only when a border alone isn't enough. The next level up
        ("overlay") is reserved for floating layers genuinely above the page - modals, drawers, tooltips - so
        using it for a merely-emphasised card would misrepresent that layering to the user. Medium/Large
        therefore intentionally resolve to the same value as Small, rather than a deeper one.
    </p>
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
    <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private ComponentElevation _elevation = ComponentElevation.Small;
    private bool _asLink;
    private bool _expanded = true;

    private readonly IReadOnlyList<ComponentElevation> _elevationOptions =
    [
        ComponentElevation.None, ComponentElevation.Small, ComponentElevation.Medium, ComponentElevation.Large
    ];

    private string GeneratedCode =>
        _asLink
            ? $"""
               <CyCard Elevation="ComponentElevation.{_elevation}" Href="/clinics/cardiff-vale">
                   <Header><strong>Cardiff and Vale clinic</strong></Header>
                   <ChildContent>Next available appointment: Thursday, 9:15am.</ChildContent>
               </CyCard>
               """
            : $"""
               <CyCard Elevation="ComponentElevation.{_elevation}">
                   <Header><strong>Cardiff and Vale clinic</strong></Header>
                   <ChildContent>Next available appointment: Thursday, 9:15am.</ChildContent>
                   <Footer><a href="#">View details</a></Footer>
               </CyCard>
               """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Header", "RenderFragment?", "null", "Optional content rendered above the body."),
        new("Footer", "RenderFragment?", "null", "Optional content rendered below the body."),
        new("Href", "string?", "null", "When set, the whole card renders as a single <a>. Don't nest another link inside ChildContent when set."),
        new("Elevation", "ComponentElevation", "ComponentElevation.Small", "Controls the card's shadow depth: None removes it, Small/Medium/Large all render the same 'raised' shadow (see note below) - only None vs. non-None is visually distinct."),
        new("ChildContent", "RenderFragment", "null", "The card's body content."),
        new("Title", "string?", "null", "Optional heading shown at the top of the card. Required when Collapsible is set. (1.12.0)"),
        new("HeadingLevel", "int", "3", "1 to 6, the level of Title. The visual size does not change. (1.12.0)"),
        new("Padding", "CyCardPadding", "Default", "Default, Compact or None. (1.12.0)"),
        new("Variant", "CyCardVariant", "Raised", "Raised (border and shadow), Outlined (border only) or Flat (filled, no border). (1.12.0)"),
        new("Collapsible", "bool", "false", "Makes the title a button that shows and hides the body. Not allowed together with Href. (1.12.0)"),
        new("Expanded", "bool", "true", "Whether a collapsible card is open. Two-way bindable. (1.12.0)"),
        new("ExpandedChanged", "EventCallback<bool>", "-", "Raised when the user opens or closes a collapsible card. (1.12.0)")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Single link target", "When Href is set, the entire card is one <a> - avoid nesting a second interactive element inside it, which would create invalid nested controls."),
        new("Neutral otherwise", "Without Href, CyCard is a plain, non-interactive container that doesn't add unexpected roles or tab stops."),
        new("Collapsible", "The title is a real button inside the heading, with aria-expanded and aria-controls pointing at the body. The chevron is decorative and the state is never shown by colour alone."),
        new("Heading level", "Choose HeadingLevel so the page outline stays in order; it does not change the size of the title.")
    ];
}
