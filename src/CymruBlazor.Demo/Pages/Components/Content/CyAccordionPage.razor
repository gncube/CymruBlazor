@page "/content/accordion"
@namespace CymruBlazor.Demo.Pages.Components.Content
@using CymruBlazor.Components.Content
@using CymruBlazor.Demo.SharedComponents

<CyPageHeader Title="CyAccordion" Subtitle="A vertically stacked set of expand/collapse sections.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Content" Href="/content" />
            <CyBreadcrumbItem Text="CyAccordion" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="@Strings.Nav.ComponentDocumentationTabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">@Strings.Nav.Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">@Strings.Nav.Api</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">@Strings.Nav.Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview" style="padding:0; align-items:stretch;">
            <CyAccordion AllowMultiple="_allowMultiple" DefaultExpandedItemId="eligibility" Style="width:100%;">
                <CyAccordionItem HeadingLevel="2" ItemId="eligibility" Title="Eligibility criteria">
                    <p>You must be registered with a GP in Wales and have lived at your current address for at least 3 months.</p>
                </CyAccordionItem>
                <CyAccordionItem HeadingLevel="2" ItemId="how-to-apply" Title="How to apply">
                    <p>Apply online through the NHS Wales portal, or by post using form NHW-12.</p>
                </CyAccordionItem>
                <CyAccordionItem HeadingLevel="2" ItemId="processing-time" Title="Processing time">
                    <p>Applications are typically processed within 10 working days.</p>
                </CyAccordionItem>
            </CyAccordion>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertySwitch Label="AllowMultiple" @bind-Value="_allowMultiple" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Content/CyAccordion.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <p class="cb-section-description" style="margin-top:1.5rem;">
            <code>DefaultExpandedItemId</code> is only read once, on first render - like most components'
            "default" props, it sets initial state rather than staying reactive to later changes,
            so it isn't included as a live property above. A disabled section is skipped entirely by
            keyboard navigation -
        </p>
        <CyCodeBlock Code="@DisabledItemExampleCode" Language="razor" />

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private bool _allowMultiple;

    private string GeneratedCode =>
        $"""
        <CyAccordion{(_allowMultiple ? " AllowMultiple=\"true\"" : "")} DefaultExpandedItemId="eligibility">
            <CyAccordionItem HeadingLevel="2" ItemId="eligibility" Title="Eligibility criteria">
                <p>...</p>
            </CyAccordionItem>
            <CyAccordionItem HeadingLevel="2" ItemId="how-to-apply" Title="How to apply">
                <p>...</p>
            </CyAccordionItem>
        </CyAccordion>
        """;

    private const string DisabledItemExampleCode =
        """
        <CyAccordionItem HeadingLevel="2" ItemId="unavailable" Title="Unavailable section" Disabled="true">
            ...
        </CyAccordionItem>
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("AllowMultiple (CyAccordion)", "bool", "false", "When false, expanding an item collapses any other open item."),
        new("DefaultExpandedItemId (CyAccordion)", "string?", "null", "The ItemId of the item that should start expanded. Read once, on first render."),
        new("ItemId (CyAccordionItem)", "string (required)", "-", "Stable identifier used for expanded state and keyboard focus order."),
        new("Title (CyAccordionItem)", "string (required)", "-", "The section header text."),
        new("Disabled (CyAccordionItem)", "bool", "false", "Renders the header disabled and skips it during keyboard navigation."),
        new("ChildContent (CyAccordionItem)", "RenderFragment", "-", "The section's panel content, shown when expanded.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("WAI-ARIA Accordion pattern", "Each header is a real <button> with aria-expanded/aria-controls; each panel is role=\"region\" labelled by its header via aria-labelledby."),
        new("Header keyboard navigation", "Up/Down arrow keys move focus between section headers (wrapping at the ends); Home/End jump to the first/last header, via real ElementReference.FocusAsync() focus moves."),
        new("Scroll side effect on Home/End", "Home/End's browser-default page-scroll behaviour is not suppressed alongside the focus move - conditionally calling preventDefault per key would require a JavaScript interop layer purely for this, which was judged not worth it for a minor scroll side effect."),
        new("Fails loudly when misused", "CyAccordionItem must be used inside a CyAccordion - using it standalone throws an InvalidOperationException rather than rendering silently broken.")
    ];
}
