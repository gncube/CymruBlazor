@page "/content/icons"
@namespace CymruBlazor.Demo.Pages.Components.Content
@using CymruBlazor.Icons
@using CymruBlazor.Demo.SharedComponents
@inject IJSRuntime JSRuntime
@inject IMediator Mediator

<CyPageHeader Title="CyIcon"
              Subtitle="Renders a single named icon from IconRegistry, the static source of truth for every icon in CymruBlazor.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Content" />
            <CyBreadcrumbItem Text="CyIcon" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)"
            aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")"
            @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api"
            class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)"
            aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")"
            @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview">
            <div class="cb-preview-icon-wrapper">
                <CyIcon Name="@_selectedIcon" Size="_size" Label="@(_asIconOnlyButton ? _selectedIcon : null)" />
            </div>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertySelect Label="Name" @bind-Value="_selectedIcon" Options="_iconOptions" TValue="string" />
                <DemoPropertyToggleGroup Label="Size" @bind-Value="_size" Options="_sizeOptions" TValue="int" />
                <DemoPropertySwitch Label="Icon-only (adds Label)" @bind-Value="_asIconOnlyButton" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Content/CyIcon.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <div style="margin-top: var(--docs-section-gap);">
            <h2 style="margin-bottom:0.25rem;">All icons (@IconRegistry.AllNames.Count)</h2>
            <p class="cb-icon-meta-bar">
                @IconRegistry.AllNames.Count icons &middot; @_iconsByDomain.Count domains &middot;
                Source: Lucide Icons &mdash; ISC licence &middot; Grid: 24 &times; 24 px &mdash; 2px stroke
            </p>
            <p class="cb-section-description">
                Grouped by domain. Click a tile to load it into the playground above and copy its
                <code>&lt;CyIcon /&gt;</code> markup to the clipboard.
            </p>

            <div class="cb-icon-toolbar">
                <div class="cb-icon-toolbar__search">
                    <label for="icon-search" class="cb-property-label">Search</label>
                    <div class="cb-icon-search-field">
                        <CyIcon Name="search" Size="16" />
                        <input id="icon-search" class="cb-icon-search-input" type="text"
                               placeholder="Search icons by name or domain..." value="@_searchText" @oninput="OnSearchInput" />
                        @if (!string.IsNullOrEmpty(_searchText))
                        {
                            <button type="button" class="cb-icon-search-clear" aria-label="Clear search" @onclick="ClearSearch">
                                <CyIcon Name="clear" Size="16" />
                            </button>
                        }
                    </div>
                </div>

                <DemoPropertyToggleGroup Label="Size" @bind-Value="_gallerySize" Options="_sizeOptions" TValue="int" />

                <span class="cb-badge cb-icon-count-badge" aria-live="polite">
                    @FilteredIconCount showing
                </span>
            </div>

            @if (FilteredIconCount == 0)
            {
                <p class="cb-section-description">No icons match &ldquo;@_searchText&rdquo;.</p>
            }

            @foreach (var group in FilteredGroups)
            {
                <div class="cb-icon-domain-group">
                    <div class="cb-icon-domain-header">
                        <span class="cb-icon-domain-title">@FriendlyDomainName(group.Domain)</span>
                        <span class="cb-badge">@group.Domain</span>
                        <span class="cb-icon-domain-count">@group.Names.Count</span>
                    </div>
                    <div class="cb-icon-grid">
                        @foreach (var name in group.Names)
                        {
                            <button type="button"
                                    class="cb-icon-tile @(_selectedIcon == name ? "cb-icon-tile--active" : "") @(_copiedIconName == name ? "cb-icon-tile--copied" : "")"
                                    title="@TileTitle(name)" @onclick="() => SelectAndCopyAsync(name)">
                                <span class="cb-icon-tile__graphic">
                                    <CyIcon Name="@name" Size="_gallerySize" />
                                </span>
                                <code class="cb-icon-tile__name">@name</code>
                                @if (_copiedIconName == name)
                                {
                                    <span class="cb-icon-tile__toast">Copied</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <h3>CyIcon</h3>
        <DemoApiTable Parameters="_apiDocs" />

        <h3 style="margin-top:2rem;">IconRegistry static members</h3>
        <p class="cb-section-description">
            Use the registry directly only when working with icon names/markup programmatically (validating a
            user-configurable icon name, building an icon picker) - most consumers only ever need
            <code>CyIcon</code> itself.
        </p>
        <table class="cb-api-table" aria-label="IconRegistry members">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Signature</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="cb-api-table__name">GetMarkup</td>
                    <td class="cb-api-table__type">static string GetMarkup(string name)</td>
                    <td>Inner SVG markup for the named icon. Throws KeyNotFoundException if the name isn't registered.</td>
                </tr>
                <tr>
                    <td class="cb-api-table__name">Exists</td>
                    <td class="cb-api-table__type">static bool Exists(string name)</td>
                    <td>Whether an icon with the given name is registered.</td>
                </tr>
                <tr>
                    <td class="cb-api-table__name">GetDomain</td>
                    <td class="cb-api-table__type">static string? GetDomain(string name)</td>
                    <td>The documentation domain an icon belongs to (e.g. "clinical", "nav", "status"), or null.</td>
                </tr>
                <tr>
                    <td class="cb-api-table__name">AllNames</td>
                    <td class="cb-api-table__type">static IReadOnlyCollection&lt;string&gt; AllNames</td>
                    <td>Every registered icon name.</td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private sealed record IconDomainGroup(string Domain, IReadOnlyList<string> Names);

    // Maps each internal domain key to the official Figma Design System heading
    private static readonly Dictionary<string, string> FriendlyDomainNames = new(StringComparer.OrdinalIgnoreCase)
    {
        { "clinical-actions", "Actions & editing" },
        { "clinical", "Clinical controls & data" },
        { "comms", "Communication & messaging" },
        { "data", "Data & statistics" },
        { "device", "Device & hardware" },
        { "file", "Documents & files" },
        { "location", "Locations & organisations" },
        { "nav", "Navigation & UI controls" },
        { "people", "Patients & people" },
        { "schedule", "Scheduling & appointments" },
        { "status", "Status & feedback" },
        { "ui", "UI & appearance" },
    };

    private Tab _activeTab = Tab.Examples;
    private List<IconDomainGroup> _iconsByDomain = [];
    private string _selectedIcon = "search";
    private int _size = 24;
    private int _gallerySize = 24;
    private bool _asIconOnlyButton;
    private string _searchText = string.Empty;
    private string? _copiedIconName;

    private IReadOnlyList<string> _iconOptions = [];

    private readonly IReadOnlyList<int> _sizeOptions = [16, 20, 24, 32];

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _iconsByDomain = IconRegistry.AllNames
            .GroupBy(name => IconRegistry.GetDomain(name) ?? "other")
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => new IconDomainGroup(
                g.Key,
                g.OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList()))
            .ToList();

        _iconOptions = IconRegistry.AllNames.OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static string FriendlyDomainName(string domain) =>
        FriendlyDomainNames.TryGetValue(domain, out var friendly) ? friendly : domain;

    private IReadOnlyList<IconDomainGroup> FilteredGroups =>
        _iconsByDomain
            .Select(g => new IconDomainGroup(
                g.Domain,
                g.Names.Where(MatchesSearch).ToList()))
            .Where(g => g.Names.Count > 0)
            .ToList();

    private int FilteredIconCount => FilteredGroups.Sum(g => g.Names.Count);

    private bool MatchesSearch(string name)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            return true;
        }

        var domain = IconRegistry.GetDomain(name) ?? "other";
        var friendly = FriendlyDomainName(domain);

        return name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || domain.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || friendly.Contains(_searchText, StringComparison.OrdinalIgnoreCase);
    }

    private string TileTitle(string name) =>
        _copiedIconName == name
            ? "Copied!"
            : $"""Click to select and copy <CyIcon Name="{name}" />""";

    private void OnSearchInput(ChangeEventArgs args) =>
        _searchText = args.Value?.ToString() ?? string.Empty;

    private void ClearSearch() => _searchText = string.Empty;

    private async Task SelectAndCopyAsync(string name)
    {
        _selectedIcon = name;

        var snippet = $"<CyIcon Name=\"{name}\" />";

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", snippet);

            _copiedIconName = name;

            await Mediator.Publish(new LiveRegionAnnouncement(
                $"Copied {snippet} to clipboard.",
                LiveRegionPoliteness.Polite));
        }
        catch (JSException)
        {
            _copiedIconName = null;

            await Mediator.Publish(new LiveRegionAnnouncement(
                "Copying to clipboard failed.",
                LiveRegionPoliteness.Assertive));
        }

        StateHasChanged();

        await Task.Delay(1500);

        if (_copiedIconName == name)
        {
            _copiedIconName = null;
            StateHasChanged();
        }
    }

    private string GeneratedCode =>
        _asIconOnlyButton
            ? $"""
               <button aria-label="{_selectedIcon}">
                   <CyIcon Name="{_selectedIcon}" Size="{_size}" Label="{_selectedIcon}" />
               </button>
               """
            : $"""
               <CyIcon Name="{_selectedIcon}" Size="{_size}" />
               """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Name", "string", "-", "Required. Icon name - see IconRegistry.AllNames, or the full gallery above."),
        new("Size", "int", "24", "Width/height in pixels - 24 is the design system's native grid size."),
        new("StrokeWidth", "double", "2", "Stroke width of the icon lines in pixels, matching Lucide and the Welsh NHS standard."),
        new("Color", "string?", "null", "Stroke colour. Defaults to null, which resolves to currentColor so the icon inherits surrounding text colour."),
        new("Label", "string?", "null", "Accessible label. Leave unset for decorative icons paired with visible text.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Decorative by default", "Without Label, icons render aria-hidden=\"true\" with no role - screen readers skip them entirely, which is correct when adjacent visible text already conveys the meaning."),
        new("Label only for icon-only usage", "Set Label only when the icon is the sole conveyor of meaning (icon-only buttons/links). CyIcon then switches to role=\"img\" with aria-label set from Label."),
        new("Avoid double announcement", "Don't set Label when visible text already sits next to the icon - doing so causes the label to be announced twice."),
        new("Copy feedback is announced, not just shown", "Copying a tile's markup in the gallery below both shows a transient \"Copied\" badge on the tile and publishes a screen-reader announcement via CyLiveRegion, matching the pattern used by CyCodeBlock.")
    ];
}
