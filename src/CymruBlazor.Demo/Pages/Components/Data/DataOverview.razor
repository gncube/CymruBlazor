@page "/data"
@namespace CymruBlazor.Demo.Pages.Components.Data
@implements IDisposable
@using CymruBlazor.Components.Content
@using CymruBlazor.Components.Layout
@using CymruBlazor.Enums

@if (Strings.Language == AppLanguage.Welsh)
{
    <div class="cb-page-header">
        <h1 class="cb-page-title">Cydrannau Data</h1>
        <p class="cb-page-description">
            Cydrannau ar gyfer arddangos, sganio a thudalennu setiau data tablog mewn
            gwasanaethau clinigol, gweinyddol a chyhoeddus.
        </p>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Cydrannau</h2>
        <CyGrid Columns="GridColumns.Two" Gap="GridGap.Medium">
            <CyCard Href="/data/table">
                <Header><strong>CyTable</strong></Header>
                <ChildContent>Tablau data hygyrch gyda phenawdau, rhesi streipiog, ac amrywiadau ag ymylon.</ChildContent>
            </CyCard>
            <CyCard Href="/data/pagination">
                <Header><strong>CyPagination</strong></Header>
                <ChildContent>Rheolyddion tudalennu y gellir eu llywio â bysellfwrdd gyda chyhoeddiadau ARIA dwyieithog.</ChildContent>
            </CyCard>
        </CyGrid>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Egwyddorion dylunio</h2>
        <ul style="color:var(--cymru-color-text);line-height:1.75;padding-inline-start:var(--cymru-space-6)">
            <li>
                <strong>Strwythur hygyrch yn gyntaf.</strong> Mae angen capsiynau disgrifiadol
                a phenawdau colofn semantig (<code>&lt;th scope="col"&gt;</code>) ar dablau i sicrhau
                eglurder darllenydd sgrin ar draws data clinigol cymhleth.
            </li>
            <li>
                <strong>Tudalennu sy'n gyfeillgar i fysellfwrdd.</strong> Mae rheolyddion tudalennu yn
                cefnogi llywio Tab, dangosyddion cyflwr gweithredol clir, ac arddangos maint tudalen a ffiniau
                y gellir eu haddasu.
            </li>
            <li>
                <strong>Cyhoeddiadau statws dwyieithog.</strong> Mae rheolyddion a labeli tudalennu yn
                gwbl gyfieithadwy i'r Gymraeg trwy ddiystyriadau paramedr neu'r gwasanaeth <code>AppStrings</code>
                a rennir.
            </li>
        </ul>
    </div>
}
else
{
    <div class="cb-page-header">
        <h1 class="cb-page-title">Data Components</h1>
        <p class="cb-page-description">
            Components for displaying, scanning, and paginating tabular datasets in
            clinical, administrative, and public-facing services.
        </p>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Components</h2>
        <CyGrid Columns="GridColumns.Two" Gap="GridGap.Medium">
            <CyCard Href="/data/table">
                <Header><strong>CyTable</strong></Header>
                <ChildContent>Accessible data tables with captions, striped rows, and bordered variants.</ChildContent>
            </CyCard>
            <CyCard Href="/data/pagination">
                <Header><strong>CyPagination</strong></Header>
                <ChildContent>Keyboard-navigable pagination controls with bilingual ARIA announcements.</ChildContent>
            </CyCard>
        </CyGrid>
    </div>

    <div class="cb-section">
        <h2 class="cb-section-title">Design principles</h2>
        <ul style="color:var(--cymru-color-text);line-height:1.75;padding-inline-start:var(--cymru-space-6)">
            <li>
                <strong>Accessible structure first.</strong> Tables require descriptive captions
                and semantic column headers (<code>&lt;th scope="col"&gt;</code>) to ensure screen-reader
                clarity across complex clinical data.
            </li>
            <li>
                <strong>Keyboard-friendly paging.</strong> Pagination controls support Tab navigation,
                clear active-state indicators, and customizable page size and boundary display.
            </li>
            <li>
                <strong>Bilingual status announcements.</strong> Paging controls and labels are fully
                translatable into Cymraeg via parameter overrides or the shared <code>AppStrings</code> service.
            </li>
        </ul>
    </div>
}

@code {
    protected override void OnInitialized() => Strings.Changed += HandleStringsChanged;
    private void HandleStringsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Strings.Changed -= HandleStringsChanged;
}
