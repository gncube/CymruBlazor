@page "/feedback/confirm-dialog"
@namespace CymruBlazor.Demo.Pages.Components.Feedback
@using CymruBlazor.Demo.SharedComponents
@inject ICyConfirmService Confirm

<CyPageHeader Title="CyConfirmDialog" Subtitle="Ask for confirmation from code with ICyConfirmService.ConfirmAsync.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Feedback" Href="/feedback" />
            <CyBreadcrumbItem Text="CyConfirmDialog" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="@Strings.Nav.ComponentDocumentationTabs">
    <button type="button" role="tab" id="tab-examples" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" aria-selected="@(_activeTab == Tab.Examples)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">@Strings.Nav.Examples</button>
    <button type="button" role="tab" id="tab-api" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" aria-selected="@(_activeTab == Tab.Api)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">@Strings.Nav.Api</button>
    <button type="button" role="tab" id="tab-accessibility" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" aria-selected="@(_activeTab == Tab.Accessibility)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">@Strings.Nav.Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
    <span class="cb-panel-caption">Preview</span>
    <div class="cb-workbench-preview" style="justify-content: flex-start; align-items: stretch; flex-direction: column; gap: var(--cymru-space-4);">
        <div style="display:flex; flex-wrap:wrap; gap:var(--cymru-space-3);">
            <CyButton OnClick="PublishAsync">Publish</CyButton>
            <CyButton Variant="ComponentColour.Danger" OnClick="DiscardAsync">Discard draft</CyButton>
        </div>
        <p aria-live="polite" style="margin:0;">@_result</p>
    </div>

    <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
        <span class="cb-panel-caption">Code</span>
        <CyCodeBlock Code="@GeneratedCode" Language="razor" />
        <a class="cb-open-in-github"
           href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Accessibility/CyConfirmDialog.razor"
           target="_blank" rel="noopener noreferrer">
            Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
        </a>
    </div>
    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
    <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
    <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;

    private string _result = "No answer yet.";

    private async Task PublishAsync()
    {
        var yes = await Confirm.ConfirmAsync(
            "Publish questionnaire?",
            "Everyone with access will see it straight away.");

        _result = yes ? "Published." : "Not published.";
    }

    private async Task DiscardAsync()
    {
        var yes = await Confirm.ConfirmAsync(
            "Discard this draft?",
            "You cannot get it back.",
            destructive: true,
            confirmText: "Discard draft",
            cancelText: "Keep editing");

        _result = yes ? "Draft discarded." : "Draft kept.";
    }

    private string GeneratedCode => """
        @* Once, in MainLayout.razor: *@
        <CyConfirmDialog />

        @* Anywhere: *@
        @inject ICyConfirmService Confirm

        var yes = await Confirm.ConfirmAsync(
            "Discard this draft?",
            "You cannot get it back.",
            destructive: true,
            confirmText: "Discard draft",
            cancelText: "Keep editing");
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("ConfirmAsync(options, ct)", "Task<bool>", "-", "True only if the user pressed the confirm button."),
        new("ConfirmAsync(title, message, ...)", "Task<bool>", "-", "Extension overload: destructive, confirmText, cancelText."),
        new("CyConfirmOptions.Title", "string", "-", "Heading and accessible name. Required."),
        new("CyConfirmOptions.Message", "string?", "null", "Plain text consequence; also the accessible description."),
        new("CyConfirmOptions.Destructive", "bool", "false", "Danger button style and initial focus on Cancel."),
        new("CyConfirmOptions.Size", "ComponentSize", "Small", "Dialog width."),
        new("CyConfirmDialog.Text", "CyConfirmText?", "null", "Localised default Confirm and Cancel text.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Native modal", "Built on CyDialog: the page behind is inert, Tab stays inside, Escape closes, focus returns to the opener."),
        new("Safe default focus", "A destructive confirmation focuses Cancel so a stray Enter does not destroy work."),
        new("Words, not colour", "Give destructive actions explicit text such as \"Discard draft\"."),
        new("Always resolves", "Escape, the close button, Cancel and a cancelled token all answer false; the task never hangs."),
        new("One host", "Place one CyConfirmDialog in the layout. Without it ConfirmAsync throws a clear error.")
    ];
}
