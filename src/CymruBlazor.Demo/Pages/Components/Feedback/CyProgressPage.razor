@page "/feedback/progress"
@namespace CymruBlazor.Demo.Pages.Components.Feedback
@using CymruBlazor.Components.Feedback
@using CymruBlazor.Demo.SharedComponents
@using CymruBlazor.Enums

<CyPageHeader Title="CyProgress" Subtitle="A progress indicator built on the native <progress> element - determinate and indeterminate.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Feedback" />
            <CyBreadcrumbItem Text="CyProgress" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview" style="justify-content: flex-start;">
            <div style="inline-size: 100%; max-inline-size: 24rem;">
                @if (_indeterminate)
                {
                    <CyProgress Label="Checking bed availability" Colour="_colour" Size="_size" />
                }
                else
                {
                    <CyProgress Value="_value" Label="Medical Ward A" Colour="_colour" Size="_size" ShowValueText="_showValueText" />
                }
            </div>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertySelect Label="Colour" TValue="ComponentColour" @bind-Value="_colour" Options="_colourOptions" />
                <DemoPropertyToggleGroup Label="Size" @bind-Value="_size" Options="_sizeOptions" TValue="ComponentSize" />
                <DemoPropertySwitch Label="Indeterminate" @bind-Value="_indeterminate" />
                <DemoPropertySwitch Label="Show value text" @bind-Value="_showValueText" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Feedback/CyProgress.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private double _value = 42;
    private ComponentColour _colour = ComponentColour.Primary;
    private ComponentSize _size = ComponentSize.Medium;
    private bool _indeterminate;
    private bool _showValueText = true;

    private readonly IReadOnlyList<ComponentColour> _colourOptions =
    [
        ComponentColour.Primary,
        ComponentColour.Secondary,
        ComponentColour.Tertiary,
        ComponentColour.Success,
        ComponentColour.Warning,
        ComponentColour.Danger,
        ComponentColour.Info,
        ComponentColour.Surface,
        ComponentColour.Neutral
    ];

    private readonly IReadOnlyList<ComponentSize> _sizeOptions =
    [
        ComponentSize.Small,
        ComponentSize.Medium,
        ComponentSize.Large
    ];

    private string GeneratedCode => _indeterminate
        ? $"""
          <CyProgress Label="Checking bed availability" Colour="ComponentColour.{_colour}"{(_size != ComponentSize.Medium ? $" Size=\"ComponentSize.{_size}\"" : "")} />
          """
        : $"""
          <CyProgress Value="{_value}" Label="Medical Ward A" Colour="ComponentColour.{_colour}"{(_size != ComponentSize.Medium ? $" Size=\"ComponentSize.{_size}\"" : "")}{(_showValueText ? " ShowValueText=\"true\"" : "")} />
          """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Value", "double?", "null", "The current value, between 0 and Max. Leave null for an indeterminate bar - the underlying quantity is not yet known."),
        new("Max", "double", "100", "The value Value is measured against. Defaults to 100 so Value can be supplied directly as a percentage."),
        new("Colour", "ComponentColour", "Primary", "The progress bar's semantic colour. Any value except Unspecified."),
        new("Size", "ComponentSize", "Medium", "The bar's block-size (thickness)."),
        new("Label", "string?", "null", "Optional visible label above the bar, also used as the accessible name via aria-labelledby. Exactly one of Label/AriaLabel is required."),
        new("AriaLabel", "string?", "null", "Accessible name when there is no visible Label. Exactly one of Label/AriaLabel is required."),
        new("ShowValueText", "bool", "false", "Shows the computed percentage (e.g. \"42%\") next to Label. Ignored when ValueText is set, or when indeterminate."),
        new("ValueText", "string?", "null", "Overrides the displayed and announced value text (e.g. \"18 of 20 beds\") in place of the computed percentage.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Built on the native <progress> element", "Browsers expose a native <progress> as role=\"progressbar\" automatically, with aria-valuenow/min/max computed from its own value/max attributes - there is no hand-written ARIA to drift out of sync."),
        new("Always has an accessible name", "CyProgress requires exactly one of Label or AriaLabel - it throws rather than silently rendering an unnamed progress bar."),
        new("Warning contrast", "Colour=\"ComponentColour.Warning\" fills the bar with the warning accent colour (a non-text UI component, so WCAG 1.4.11 rather than the stricter text-contrast rule applies) - the same accent CyBadge and CyAlert avoid for their own text for a related reason.")
    ];
}
