@page "/branding/brand-logo"
@namespace CymruBlazor.Demo.Pages.Components.Branding
@using CymruBlazor.Components.Branding
@using CymruBlazor.Enums
@using CymruBlazor.Demo.SharedComponents

<CyPageHeader Title="CyBrandLogo"
              Subtitle="The built-in SVG mark/wordmark lockup, or a supplied image asset. Theme switching is CSS-only.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Branding" />
            <CyBreadcrumbItem Text="CyBrandLogo" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)"
            aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")"
            @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api"
            class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)"
            aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")"
            @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview">
            <CyBrandLogo Variant="_variant" SymbolOnly="_symbolOnly" Size="_size" Text="@_text"
                         Href="@(_asLink ? "/" : null)" />
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertyToggleGroup Label="Variant" @bind-Value="_variant" Options="_variantOptions"
                                         TValue="BrandLogoVariant" />
                <DemoPropertySwitch Label="Symbol Only" @bind-Value="_symbolOnly" />
                <DemoPropertyToggleGroup Label="Size" @bind-Value="_size" Options="_sizeOptions" TValue="ComponentSize" />
                <DemoPropertyTextInput Label="Text" @bind-Value="_text" />
                <DemoPropertySwitch Label="As a home link (Href)" @bind-Value="_asLink" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Branding/CyBrandLogo.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <div style="margin-top: var(--docs-section-gap);">
            <h3>ThemeService Integration Guidance</h3>
            <p class="cb-section-description">
                Consuming applications managing dark/light modes via a C# <code>ThemeService</code> can render reactive NHS
                Wales branding using the pattern below:
            </p>
            <CyCodeBlock Code="@ThemeServiceGuidanceCode" Language="razor" />
        </div>

        <div style="margin-top: var(--docs-section-gap);">
            <h3>Image-based logo with a dark-theme asset (CSS only)</h3>
            <p class="cb-section-description">
                When <code>LogoPath</code> is supplied, it takes precedence over the built-in lockup. Supply
                <code>DarkLogoPath</code> too, and both are rendered with CSS
                showing/hiding the correct one under <code>[data-theme="dark"]</code>.
            </p>
            <CyCodeBlock Code="@ImageLogoExampleCode" Language="razor" />
        </div>

        <div style="margin-top: var(--docs-section-gap);">
            <h3>Logo sizes</h3>
            <p class="cb-section-description">
                The <code>Size</code> parameter uses the shared <code>ComponentSize</code> enum. It sets the
                logo's height - the built-in mark's width and height, or the height of an image logo, whose width
                follows its aspect ratio. Both use the same scale:
            </p>
            <table class="cb-api-table" aria-label="Logo sizes">
                <thead><tr><th><code>ComponentSize</code></th><th>Height</th></tr></thead>
                <tbody>
                    <tr><td><code>ExtraSmall</code></td><td>18px</td></tr>
                    <tr><td><code>Small</code></td><td>32px</td></tr>
                    <tr><td><code>Medium</code> (default)</td><td>48px</td></tr>
                    <tr><td><code>Large</code></td><td>64px</td></tr>
                    <tr><td><code>ExtraLarge</code></td><td>72px</td></tr>
                </tbody>
            </table>
            <p class="cb-section-description" style="margin-top:1rem;">
                Image logos are drawn at exactly that height, whatever their intrinsic size, so SVG assets scale
                crisply; supply raster (PNG/JPG) assets at least as tall as the largest <code>Size</code> you use, or
                they will soften. If the space is narrower than the logo at that height, the logo shrinks to fit
                without distortion - so a wide lockup in a narrow sidebar can look smaller than its
                <code>Size</code> suggests; choose a smaller <code>Size</code> or use the icon
                (<code>SymbolOnly</code>) version there. For a height between the steps, override the asset's
                <code>height</code> in your own stylesheet:
            </p>
            <CyCodeBlock Code="@LogoSizeOverrideCode" Language="css" />
        </div>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private BrandLogoVariant _variant = BrandLogoVariant.Full;
    private bool _symbolOnly;
    private ComponentSize _size = ComponentSize.Medium;
    private string _text = "CymruBlazor";
    private bool _asLink = true;

    private readonly IReadOnlyList<BrandLogoVariant> _variantOptions =
    [
        BrandLogoVariant.Auto,
        BrandLogoVariant.Light,
        BrandLogoVariant.Dark,
        BrandLogoVariant.Full,
        BrandLogoVariant.Mark,
        BrandLogoVariant.Wordmark,
        BrandLogoVariant.Stacked
    ];

    private readonly IReadOnlyList<ComponentSize> _sizeOptions =
    [
        ComponentSize.Small, ComponentSize.Medium, ComponentSize.Large, ComponentSize.ExtraLarge
    ];

    private string GeneratedCode =>
        $"""
        <CyBrandLogo
            Variant="BrandLogoVariant.{_variant}"
            SymbolOnly="{_symbolOnly.ToString().ToLowerInvariant()}"
            Size="ComponentSize.{_size}"
            Text="{_text}"{(_asLink ? "\n    Href=\"/\"" : "\n    Href=\"null\"")} />
        """;

    private const string ThemeServiceGuidanceCode =
        """
        @implements IDisposable
        @inject ThemeService ThemeService

        <a href="/"
           class="inline-flex items-center gap-2 rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-sr-focus-ring"
           aria-label="NHS Wales Home">
            <img src="@LogoPath"
                 alt="NHS Wales Logo"
                 class="@(SymbolOnly ? "h-8 w-auto" : "h-15 w-auto") transition-opacity duration-150" />
        </a>

        @code {
            [Parameter]
            public BrandLogoVariant Variant { get; set; } = BrandLogoVariant.Auto;

            [Parameter]
            public bool SymbolOnly { get; set; }

            protected override void OnInitialized()
            {
                ThemeService.OnChange += HandleThemeChanged;
            }

            private string LogoPath
            {
                get
                {
                    var useDark = Variant switch
                    {
                        BrandLogoVariant.Dark => true,
                        BrandLogoVariant.Light => false,
                        _ => ThemeService.IsDark
                    };

                    return (useDark, SymbolOnly) switch
                    {
                        (true, true)   => "images/icon-dhcw-dark.svg",
                        (true, false)  => "images/logo-dhcw-dark.svg",
                        (false, true)  => "images/icon-dhcw-light.svg",
                        (false, false) => "images/logo-dhcw-light.svg"
                    };
                }
            }

            private void HandleThemeChanged()
            {
                _ = InvokeAsync(StateHasChanged);
            }

            public void Dispose()
            {
                ThemeService.OnChange -= HandleThemeChanged;
            }
        }
        """;

    private const string LogoSizeOverrideCode =
        """
        /* <CyBrandLogo Class="app-logo" LogoPath="/images/logo.svg" /> */
        .app-logo .cy-brand-logo__asset { height: 3.5rem; }
        """;

    private const string ImageLogoExampleCode =
        """
        <CyBrandLogo LogoPath="/images/logo-light.svg"
                     DarkLogoPath="/images/logo-dark.svg"
                     Href="/" />
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Variant", "BrandLogoVariant", "Full", "Which parts of the built-in lockup render (Full, Mark, Wordmark, Stacked) or theme asset mode (Auto, Light, Dark)."),
        new("SymbolOnly", "bool", "false", "When true, renders only the mark/symbol icon rather than the full logo lockup."),
        new("Size", "ComponentSize", "Medium", "Overall sizing from ComponentSize: 18 / 32 / 48 / 64 / 72px (ExtraSmall to ExtraLarge) - mark size, or height for image assets."),
        new("LogoPath", "string?", "null", "Light-theme (or single) logo asset. Takes precedence over the built-in lockup when set."),
        new("DarkLogoPath", "string?", "null", "Dark-theme logo asset. Falls back to LogoPath when omitted."),
        new("Text", "string", "\"CymruBlazor\"", "Organisation/product name rendered by the built-in wordmark."),
        new("Href", "string?", "\"/\"", "When set, renders the whole logo as a single anchor element."),
        new("AriaLabel", "string?", "null", "Accessible label. Defaults to \"{Text} Home\" (linked) or \"{Text}\" (unlinked).")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Single labelled unit", "Renders as an <a> when Href is set, or a <span role=\"img\"> otherwise - either way the logo is exposed to assistive technology as one labelled unit rather than separate icon/text nodes."),
        new("Focus indicators", "Features accessible focus rings using focus-visible:ring-2 focus-visible:ring-sr-focus-ring without suppressing default keyboard navigation."),
        new("No redundant announcements", "The built-in SVG mark carries aria-hidden=\"true\" and image assets use empty alt text, since the accessible label is already provided at the wrapping element via aria-label."),
        new("Theme-aware without JS", "Theme selection is CSS-only (data-theme), so the logo repaints correctly for high-contrast and dark themes without any additional wiring or a flash of the wrong asset.")
    ];
}
