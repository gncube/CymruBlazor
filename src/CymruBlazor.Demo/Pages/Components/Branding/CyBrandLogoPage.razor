@page "/branding/brand-logo"
@namespace CymruBlazor.Demo.Pages.Components.Branding
@using CymruBlazor.Components.Branding
@using CymruBlazor.Enums
@using CymruBlazor.Demo.Shared

<CyPageHeader Title="CyBrandLogo" Subtitle="The built-in SVG mark/wordmark lockup, or a supplied image asset. Theme switching is CSS-only.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Branding" />
            <CyBreadcrumbItem Text="CyBrandLogo" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview">
            <CyBrandLogo Variant="_variant" Size="_size" Text="@_text" Href="@(_asLink ? "/" : null)" />
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertyToggleGroup Label="Variant" @bind-Value="_variant" Options="_variantOptions" TValue="BrandLogoVariant" />
                <DemoPropertyToggleGroup Label="Size" @bind-Value="_size" Options="_sizeOptions" TValue="ComponentSize" />
                <DemoPropertyTextInput Label="Text" @bind-Value="_text" />
                <DemoPropertySwitch Label="As a home link (Href)" @bind-Value="_asLink" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <DemoCodeBlock Code="@GeneratedCode" Language="razor" />
            </div>
        </div>

        <div style="margin-top: var(--docs-section-gap);">
            <h3>Image-based logo with a dark-theme asset</h3>
            <p class="cb-section-description">
                When <code>LogoPath</code> is supplied, it takes precedence over the built-in lockup (the Variant
                control above has no effect). Supply <code>DarkLogoPath</code> too, and both are rendered with CSS
                showing/hiding the correct one under <code>[data-theme="dark"]</code> - no theme-change JavaScript
                is triggered, unlike the header's own theme toggle elsewhere in this demo.
            </p>
            <DemoCodeBlock Code="@ImageLogoExampleCode" Language="razor" />
        </div>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private BrandLogoVariant _variant = BrandLogoVariant.Full;
    private ComponentSize _size = ComponentSize.Medium;
    private string _text = "CymruBlazor";
    private bool _asLink;

    private readonly IReadOnlyList<BrandLogoVariant> _variantOptions =
    [
        BrandLogoVariant.Full, BrandLogoVariant.Mark, BrandLogoVariant.Wordmark, BrandLogoVariant.Stacked
    ];

    private readonly IReadOnlyList<ComponentSize> _sizeOptions =
    [
        ComponentSize.Small, ComponentSize.Medium, ComponentSize.Large, ComponentSize.ExtraLarge
    ];

    private string GeneratedCode =>
        $"""
        <CyBrandLogo
            Variant="BrandLogoVariant.{_variant}"
            Size="ComponentSize.{_size}"
            Text="{_text}"{(_asLink ? "\n    Href=\"/\"" : "")} />
        """;

    private const string ImageLogoExampleCode =
        """
        <CyBrandLogo LogoPath="/images/logo-light.svg"
                     DarkLogoPath="/images/logo-dark.svg"
                     Href="/" />
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Variant", "BrandLogoVariant", "Full", "Which parts of the built-in lockup render: Full, Mark, Wordmark, or Stacked. No effect when LogoPath is set."),
        new("Size", "ComponentSize", "Medium", "Overall sizing - mark/wordmark scale, or max height for image assets."),
        new("LogoPath", "string?", "null", "Light-theme (or single) logo asset. Takes precedence over the built-in lockup when set."),
        new("DarkLogoPath", "string?", "null", "Dark-theme logo asset. Falls back to LogoPath when omitted."),
        new("Text", "string", "\"CymruBlazor\"", "Organisation/product name rendered by the built-in wordmark."),
        new("Href", "string?", "null", "When set, renders the whole logo as a single anchor element."),
        new("AriaLabel", "string?", "null", "Accessible label. Defaults to \"{Text} home\" (linked) or \"{Text}\" (unlinked).")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Single labelled unit", "Renders as an <a> when Href is set, or a <span role=\"img\"> otherwise - either way the logo is exposed to assistive technology as one labelled unit rather than separate icon/text nodes."),
        new("No redundant announcements", "The built-in SVG mark carries aria-hidden=\"true\" and image assets use empty alt text, since the accessible label is already provided at the wrapping element via aria-label."),
        new("Theme-aware without JS", "Theme selection is CSS-only (data-theme), so the logo repaints correctly for high-contrast and dark themes without any additional wiring or a flash of the wrong asset.")
    ];
}
