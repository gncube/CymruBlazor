@page "/feedback/dialog"
@page "/accessibility/dialog"
@namespace CymruBlazor.Demo.Pages.Components.Accessibility

<div class="cb-page-header">
    <h1 class="cb-page-title">Dialog</h1>
    <a class="cb-open-in-github"
       href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Accessibility/CyDialog.razor"
       target="_blank" rel="noopener noreferrer">
        Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
    </a>
    <p class="cb-page-description">
        A modal dialog built on the native <code>&lt;dialog&gt;</code> element and
        <code>showModal()</code>. The browser makes the rest of the page inert, keeps
        <kbd>Tab</kbd> inside the dialog, closes it on <kbd>Escape</kbd> and draws it above
        everything. A small script (loaded on demand) reports closes back to .NET and returns
        focus to the control that opened it.
    </p>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Basic usage</h2>
    <p class="cb-section-description">
        Bind <code>Open</code>. The <code>Title</code> names the dialog; the optional
        <code>Description</code> describes it. Body content is rendered only while open.
        Open it from a button so focus can return there.
    </p>

    <div class="cb-example">
        <span class="cb-example__label">Interactive</span>
        <div class="cb-example__preview">
            <button id="open-basic-dialog" type="button" class="cb-demo-btn" @onclick="() => _basicOpen = true">
                Open dialog
            </button>

            <CyDialog @bind-Open="_basicOpen"
                      Title="Appointment details"
                      Description="Review the details below before you continue."
                      OnClosed="() => _closedCount++">
                <ChildContent>
                    <p>Press <kbd>Escape</kbd>, use the close button, or click a footer action.</p>
                    <p>Dialogs closed so far: <strong>@_closedCount</strong></p>
                </ChildContent>
                <Footer>
                    <button type="button" class="cb-demo-btn cb-demo-btn--secondary" @onclick="() => _basicOpen = false">Cancel</button>
                    <button type="button" class="cb-demo-btn" autofocus @onclick="() => _basicOpen = false">Confirm</button>
                </Footer>
            </CyDialog>
        </div>
        <pre class="cb-example__code"><code>&lt;CyDialog @@bind-Open="_open"
          Title="Appointment details"
          Description="Review the details below before you continue."&gt;
    &lt;ChildContent&gt;
        &lt;p&gt;...&lt;/p&gt;
    &lt;/ChildContent&gt;
    &lt;Footer&gt;
        &lt;button type="button" @@onclick="() =&gt; _open = false"&gt;Cancel&lt;/button&gt;
        &lt;button type="button" autofocus @@onclick="Confirm"&gt;Confirm&lt;/button&gt;
    &lt;/Footer&gt;
&lt;/CyDialog&gt;</code></pre>
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Sizes and non-dismissible dialogs</h2>
    <p class="cb-section-description">
        <code>Size</code> is <code>Small</code>, <code>Medium</code> or <code>Large</code>. With
        <code>Dismissible="false"</code> there is no close button and <kbd>Escape</kbd> does not close
        the dialog, so your own actions must. Use it sparingly: a user who cannot cancel is stuck.
    </p>

    <div class="cb-example">
        <span class="cb-example__label">Interactive</span>
        <div class="cb-example__preview">
            <button type="button" class="cb-demo-btn" @onclick="() => _strictOpen = true">
                Open non-dismissible dialog
            </button>

            <CyDialog @bind-Open="_strictOpen"
                      Title="Session expiring"
                      Size="ComponentSize.Small"
                      Dismissible="false">
                <ChildContent>
                    <p>Your session will end in one minute.</p>
                </ChildContent>
                <Footer>
                    <button type="button" class="cb-demo-btn" autofocus @onclick="() => _strictOpen = false">Stay signed in</button>
                </Footer>
            </CyDialog>
        </div>
        <pre class="cb-example__code"><code>&lt;CyDialog @@bind-Open="_open" Title="Session expiring"
          Size="ComponentSize.Small" Dismissible="false"&gt;
    ...
&lt;/CyDialog&gt;</code></pre>
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">API</h2>
    <table class="cb-api-table" aria-label="Dialog parameters">
        <thead>
            <tr><th>Parameter</th><th>Type</th><th>Default</th><th>Description</th></tr>
        </thead>
        <tbody>
            <tr><td class="cb-api-table__name">Open</td><td class="cb-api-table__type">bool</td><td class="cb-api-table__default">false</td><td>Whether the dialog is open. Two-way bindable (<code>@@bind-Open</code>)</td></tr>
            <tr><td class="cb-api-table__name">OnClosed</td><td class="cb-api-table__type">EventCallback</td><td class="cb-api-table__default">-</td><td>Raised once each time the dialog has closed, whatever the cause</td></tr>
            <tr><td class="cb-api-table__name">Title</td><td class="cb-api-table__type">string</td><td class="cb-api-table__default">required</td><td>Heading and accessible name (<code>aria-labelledby</code>)</td></tr>
            <tr><td class="cb-api-table__name">Description</td><td class="cb-api-table__type">string?</td><td class="cb-api-table__default">null</td><td>Plain-text description (<code>aria-describedby</code>)</td></tr>
            <tr><td class="cb-api-table__name">ChildContent</td><td class="cb-api-table__type">RenderFragment</td><td class="cb-api-table__default">-</td><td>The dialog body</td></tr>
            <tr><td class="cb-api-table__name">Footer</td><td class="cb-api-table__type">RenderFragment</td><td class="cb-api-table__default">-</td><td>Action area, typically buttons</td></tr>
            <tr><td class="cb-api-table__name">Dismissible</td><td class="cb-api-table__type">bool</td><td class="cb-api-table__default">true</td><td>Shows the close button and allows <kbd>Escape</kbd></td></tr>
            <tr><td class="cb-api-table__name">CloseOnBackdropClick</td><td class="cb-api-table__type">bool</td><td class="cb-api-table__default">false</td><td>Closes on a backdrop click (only when Dismissible)</td></tr>
            <tr><td class="cb-api-table__name">Size</td><td class="cb-api-table__type">ComponentSize</td><td class="cb-api-table__default">Medium</td><td>Small, Medium or Large</td></tr>
            <tr><td class="cb-api-table__name">CloseLabel</td><td class="cb-api-table__type">string?</td><td class="cb-api-table__default">"Close"</td><td>Accessible name of the close button (translate for Welsh)</td></tr>
        </tbody>
    </table>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Accessibility notes</h2>
    <ul style="color:var(--cymru-color-text);line-height:1.75;padding-inline-start:var(--cymru-space-6)">
        <li>Opened with <code>showModal()</code>: the page behind is inert, so it cannot be reached by keyboard, pointer or screen reader while the dialog is open.</li>
        <li>Named by its title and described by its description, so screen readers announce both on open.</li>
        <li>Focus goes to the <code>autofocus</code> element, otherwise the first focusable element (the close button). Put <code>autofocus</code> on the safest control for long or destructive dialogs.</li>
        <li>Closing returns focus to the control that opened the dialog (WCAG 2.4.3).</li>
        <li>Requires the browser's native <code>&lt;dialog&gt;</code> support (all evergreen browsers since 2022). See ADR-0001.</li>
    </ul>
</div>

@code {
    private bool _basicOpen;
    private bool _strictOpen;
    private int _closedCount;
}
