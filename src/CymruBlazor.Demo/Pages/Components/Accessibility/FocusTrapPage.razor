@page "/foundations/focus-trap"
@page "/accessibility/focus-trap"
@namespace CymruBlazor.Demo.Pages.Components.Accessibility
@inject IFocusManager FocusManager

<div class="cb-page-header">
    <h1 class="cb-page-title">FocusTrap</h1>
    <a class="cb-open-in-github"
       href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Accessibility/CyFocusTrap.razor"
       target="_blank" rel="noopener noreferrer">
        Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
    </a>
    <p class="cb-page-description">
        A wrapper that keeps keyboard focus inside its content: focus moves in when the
        trap activates, <kbd>Tab</kbd> and <kbd>Shift</kbd>+<kbd>Tab</kbd> wrap at both ends, and
        focus returns to where it came from when the trap is removed. For a modal dialog use
        <a href="/accessibility/dialog"><code>CyDialog</code></a> instead.
    </p>
</div>

<CyAlert Severity="ComponentColour.Info">
    <p style="margin:0">
        <strong>Since 1.3.0.</strong> The default <code>IFocusManager</code> (<code>JsFocusManager</code>) now really moves,
        restores and contains focus, using a small script loaded on demand (no
        <code>&lt;script&gt;</code> tag needed). In 1.2.x this component did nothing at runtime.
        It is a <em>focus</em> trap only: it does not make the rest of the page inert, add a
        dialog role or handle <kbd>Escape</kbd>.
    </p>
</CyAlert>

<div class="cb-section">
    <h2 class="cb-section-title">Basic usage</h2>
    <p class="cb-section-description">
        While <code>Enabled</code> is <code>true</code> (the default), the trap is active.
        With <code>AutoFocus</code> it moves focus to the first <code>autofocus</code> or
        tabbable element. Open the panel, then press <kbd>Tab</kbd> repeatedly: focus cycles
        inside the panel. Closing it returns focus to the button that opened it.
    </p>

    <div class="cb-example">
        <span class="cb-example__label">Interactive</span>
        <div class="cb-example__preview">
            @if (!_trapVisible)
            {
                <button id="open-trap-btn"
                        class="cb-demo-btn"
                        @onclick="OpenTrap">
                    Open focus trap panel
                </button>
            }
            else
            {
                <CyFocusTrap Enabled="true"
                           AutoFocus="true"
                           RestoreFocus="true"
                           Style="display:block;padding:var(--cymru-space-6);
                                  border:2px solid var(--cymru-color-primary);
                                  border-radius:var(--cymru-radius-md);
                                  background:var(--cymru-color-surface)">
                    <CyStack Orientation="Orientation.Vertical" Gap="ComponentSize.Medium">
                        <p style="margin:0;font-weight:600">This panel is wrapped in a CyFocusTrap.</p>
                        <p style="margin:0;font-size:var(--cymru-font-size-sm);
                                  color:var(--cymru-color-text-muted)">
                            Tab and Shift+Tab stay inside this panel.
                        </p>
                        <input type="text"
                               placeholder="First focusable element"
                               style="padding:var(--cymru-space-2);
                                      border:1px solid var(--cymru-color-border);
                                      border-radius:var(--cymru-radius-sm);
                                      width:100%;box-sizing:border-box" />
                        <input type="text"
                               placeholder="Second focusable element"
                               style="padding:var(--cymru-space-2);
                                      border:1px solid var(--cymru-color-border);
                                      border-radius:var(--cymru-radius-sm);
                                      width:100%;box-sizing:border-box" />
                        <button class="cb-demo-btn cb-demo-btn--secondary"
                                @onclick="CloseTrap">
                            Close panel
                        </button>
                    </CyStack>
                </CyFocusTrap>
            }
        </div>
        <pre class="cb-example__code"><code>&lt;CyFocusTrap Enabled="true"
             AutoFocus="true"
             RestoreFocus="true"&gt;
    &lt;input type="text" /&gt;
    &lt;button @@onclick="Close"&gt;Close&lt;/button&gt;
&lt;/CyFocusTrap&gt;</code></pre>
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Turning the trap on and off</h2>
    <p class="cb-section-description">
        Set <code>Enabled="false"</code> to release the trap (focus is restored if
        <code>RestoreFocus</code> is set); set it back to <code>true</code> to activate it again.
        The wrapper element is always rendered.
    </p>
    <pre><code>&lt;CyFocusTrap Enabled="@@_isOpen"&gt;
    ...
&lt;/CyFocusTrap&gt;</code></pre>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Providing your own focus manager</h2>
    <p class="cb-section-description">
        <code>CyFocusTrap</code> calls whatever <code>IFocusManager</code> is registered
        (the last registration wins). A custom manager that only implements
        <code>FocusAsync</code> and <code>RestoreFocusAsync</code> keeps working: the interface's
        default <code>TrapAsync</code> calls them, but does not contain <kbd>Tab</kbd>.
        Override <code>TrapAsync</code> to do that.
    </p>
    <pre><code>builder.Services.AddCymruBlazor();
builder.Services.AddScoped&lt;IFocusManager, MyFocusManager&gt;();</code></pre>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">API</h2>
    <table class="cb-api-table" aria-label="FocusTrap parameters">
        <thead>
            <tr>
                <th>Parameter</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="cb-api-table__name">Enabled</td>
                <td class="cb-api-table__type">bool</td>
                <td class="cb-api-table__default">true</td>
                <td>When true the trap is active; false releases it (restoring focus if RestoreFocus)</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">AutoFocus</td>
                <td class="cb-api-table__type">bool</td>
                <td class="cb-api-table__default">true</td>
                <td>Moves focus into the trap each time it activates</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">RestoreFocus</td>
                <td class="cb-api-table__type">bool</td>
                <td class="cb-api-table__default">true</td>
                <td>Returns focus to the previously focused element when the trap is released or removed</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">ChildContent</td>
                <td class="cb-api-table__type">RenderFragment</td>
                <td class="cb-api-table__default">—</td>
                <td>Content rendered inside the trap container</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">Class</td>
                <td class="cb-api-table__type">string?</td>
                <td class="cb-api-table__default">null</td>
                <td>Additional CSS classes on the root <code>&lt;div&gt;</code></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Accessibility notes</h2>
    <ul style="color:var(--cymru-color-text);line-height:1.75;
               padding-inline-start:var(--cymru-space-6)">
        <li>
            Helps meet WCAG 2.4.3 (Focus Order) for content that temporarily takes over
            interaction, such as a drawer: focus moves in, cannot Tab out, and returns afterwards.
        </li>
        <li>
            Traps nest: only the most recently activated trap acts.
        </li>
        <li>
            It does not hide the rest of the page from assistive technology. For a modal
            dialog use <a href="/accessibility/dialog"><code>CyDialog</code></a>, which uses the
            native <code>&lt;dialog&gt;</code> so the background is inert, <kbd>Escape</kbd> closes it and
            the dialog has a proper role and name.
        </li>
        <li>
            The component does not render its own <kbd>Escape</kbd> handler: add an
            <code>@@onkeydown</code> on the container to close on escape.
        </li>
    </ul>
</div>

@code {
    private bool _trapVisible;

    private void OpenTrap()  => _trapVisible = true;
    private void CloseTrap() => _trapVisible = false;
}
