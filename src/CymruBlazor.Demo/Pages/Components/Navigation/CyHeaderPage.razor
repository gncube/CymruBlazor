@page "/navigation/header"
@namespace CymruBlazor.Demo.Pages.Components.Navigation
@implements IDisposable
@using CymruBlazor.Components.Layout
@using CymruBlazor.Components.Branding
@using CymruBlazor.Components.Button
@using CymruBlazor.Demo.SharedComponents
@using CymruBlazor.Enums

<CyPageHeader Title="CyHeader" Subtitle="@(Strings.Language == AppLanguage.Welsh ? "Bar cromen pennawd lefel tudalen: brand, prif gynnwys, a gweithredoedd dilynol." : "The page-level header chrome bar: brand, primary content, and trailing actions.")">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="@(Strings.Language == AppLanguage.Welsh ? "Llywio" : "Navigation")" Href="/navigation" />
            <CyBreadcrumbItem Text="CyHeader" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="@Strings.Nav.ComponentDocumentationTabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">@Strings.Nav.Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">@Strings.Nav.Api</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">@Strings.Nav.Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">@(Strings.Language == AppLanguage.Welsh ? "Rhagolwg" : "Preview")</span>
        <div class="cb-workbench-preview" style="padding:0;">
            <CyHeader Background="_background" Sticky="false" Style="width:100%;">
                <Brand><CyBrandLogo Size="ComponentSize.Small" Text="MyApp" /></Brand>
                <ChildContent>
                    <a href="#">@(Strings.Language == AppLanguage.Welsh ? "Dangosfwrdd" : "Dashboard")</a>
                    <a href="#">@(Strings.Language == AppLanguage.Welsh ? "Cleifion" : "Patients")</a>
                    <a href="#">@(Strings.Language == AppLanguage.Welsh ? "Adroddiadau" : "Reports")</a>
                </ChildContent>
                <Actions><CyButton Variant="ComponentColour.Secondary" Size="ComponentSize.Small">@(Strings.Language == AppLanguage.Welsh ? "Allgofnodi" : "Sign out")</CyButton></Actions>
            </CyHeader>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertySelect Label="@(Strings.Language == AppLanguage.Welsh ? "Cefndir" : "Background")" @bind-Value="_background" Options="_backgroundOptions" TValue="ComponentColour" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">@(Strings.Language == AppLanguage.Welsh ? "Cod a gynhyrchwyd" : "Generated code")</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Layout/CyHeader.razor"
                   target="_blank" rel="noopener noreferrer">
                    @(Strings.Language == AppLanguage.Welsh ? "Agor yn GitHub" : "Open in GitHub")<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <div style="margin-top: var(--docs-section-gap);">
            <h3>@(Strings.Language == AppLanguage.Welsh ? "Pennawd y safle demo hwn ei hun" : "This demo site's own header")</h3>
            <p class="cb-section-description">
                @if (Strings.Language == AppLanguage.Welsh)
                {
                    <text>Mae'r pennawd ar frig pob tudalen yn y demo hwn (<code>DemoHeader.razor</code>) yn <code>CyHeader</code> go iawn - mae'r botwm hamburger a'r logo yn eistedd yn <code>Brand</code>, y prif ddolenni llywio yn <code>ChildContent</code>, a'r botymau chwilio/toglo thema yn <code>Actions</code>. Mae'n haenu ei ddosbarthiadau penodol ei hun ar ei ben drwy <code>Class="cb-shell-header"</code> yn hytrach nag ailosod steilio CyHeader ei hun, ac yn gosod <code>Sticky="true"</code> fel ei fod yn aros yn weladwy wrth sgrolio.</text>
                }
                else
                {
                    <text>The header at the top of every page in this demo (<code>DemoHeader.razor</code>) is a real <code>CyHeader</code> - the hamburger and logo sit in <code>Brand</code>, the primary nav links in <code>ChildContent</code>, and the search/theme-toggle buttons in <code>Actions</code>. It layers its own demo-specific classes on top via <code>Class="cb-shell-header"</code> rather than replacing CyHeader's own styling, and sets <code>Sticky="true"</code> so it stays visible while scrolling.</text>
                }
            </p>
        </div>

        <div style="margin-top: 2rem;">
            <h3>@(Strings.Language == AppLanguage.Welsh ? "Cyfansoddi gyda CyNavigation" : "Composing with CyNavigation")</h3>
            <p class="cb-section-description">
                @if (Strings.Language == AppLanguage.Welsh)
                {
                    <text>Nid yw CyHeader yn delio'n fwriadol â chwympo llywio symudol ei hun - dyna waith <code>CyNavigation</code>. Rhowch CyNavigation y tu mewn i ChildContent pan fyddwch eisiau dewislen gwympo adeiledig yn lle creu togl eich hun (fel y mae pennawd y demo hwn yn ei wneud, i gadw botwm hamburger y drôr symudol yn rheoli'r bar ochr yn hytrach nag ail ddewislen ar wahân):</text>
                }
                else
                {
                    <text>CyHeader deliberately doesn't handle mobile nav collapse itself - that's <code>CyNavigation</code>'s job. Put a CyNavigation inside ChildContent when you want a built-in collapsible menu instead of rolling your own toggle (as this demo's own header does, to keep the mobile drawer's hamburger controlling the sidebar rather than a second, separate menu):</text>
                }
            </p>
            <CyCodeBlock Code="@ComposedExampleCode" Language="razor" />
        </div>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="ApiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="A11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private ComponentColour _background = ComponentColour.Primary;

    protected override void OnInitialized() => Strings.Changed += HandleStringsChanged;
    private void HandleStringsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Strings.Changed -= HandleStringsChanged;

    private readonly IReadOnlyList<ComponentColour> _backgroundOptions =
    [
        ComponentColour.Primary, ComponentColour.Secondary, ComponentColour.Surface, ComponentColour.Neutral
    ];

    private string GeneratedCode => Strings.Language == AppLanguage.Welsh
        ? $"""
        <CyHeader Background="ComponentColour.{_background}">
            <Brand><CyBrandLogo Text="FyAp" /></Brand>
            <ChildContent>
                <a href="/dashboard">Dangosfwrdd</a>
                <a href="/patients">Cleifion</a>
            </ChildContent>
            <Actions><CyButton Variant="ComponentColour.Secondary">Allgofnodi</CyButton></Actions>
        </CyHeader>
        """
        : $"""
        <CyHeader Background="ComponentColour.{_background}">
            <Brand><CyBrandLogo Text="MyApp" /></Brand>
            <ChildContent>
                <a href="/dashboard">Dashboard</a>
                <a href="/patients">Patients</a>
            </ChildContent>
            <Actions><CyButton Variant="ComponentColour.Secondary">Sign out</CyButton></Actions>
        </CyHeader>
        """;

    private string ComposedExampleCode => Strings.Language == AppLanguage.Welsh
        ? """
        <CyHeader Sticky="true">
            <Brand><CyBrandLogo /></Brand>
            <ChildContent>
                <CyNavigation>
                    <CyNavigationItem Text="Dangosfwrdd" Href="/dashboard" />
                    <CyNavigationItem Text="Cleifion" Href="/patients" />
                </CyNavigation>
            </ChildContent>
            <Actions><CyButton Variant="ComponentColour.Secondary">Allgofnodi</CyButton></Actions>
        </CyHeader>
        """
        : """
        <CyHeader Sticky="true">
            <Brand><CyBrandLogo /></Brand>
            <ChildContent>
                <CyNavigation>
                    <CyNavigationItem Text="Dashboard" Href="/dashboard" />
                    <CyNavigationItem Text="Patients" Href="/patients" />
                </CyNavigation>
            </ChildContent>
            <Actions><CyButton Variant="ComponentColour.Secondary">Sign out</CyButton></Actions>
        </CyHeader>
        """;

    private IReadOnlyList<DemoApiTable.ApiParameterDoc> ApiDocs => Strings.Language == AppLanguage.Welsh
        ? [
            new("Brand", "RenderFragment?", "null", "Wedi'i rendro'n gyntaf - fel arfer CyBrandLogo."),
            new("ChildContent", "RenderFragment?", "null", "Prif gynnwys y bar rhwng Brand ac Actions - dolenni plaen, neu CyNavigation ar gyfer cwympo symudol adeiledig."),
            new("Actions", "RenderFragment?", "null", "Wedi'i rendro ddiwethaf ac wedi'i wthio i ddiwedd y bar - fel arfer botymau eicon (chwilio, toglo thema, dewislen cyfrif)."),
            new("Background", "ComponentColour", "Primary", "Rhaid iddo fod yn Primary, Secondary, Surface, neu Neutral. Yn cyfateb i gonfensiwn Cefndir CyFooter, fel bod pâr pennawd+troedyn sy'n defnyddio'r un gwerth yn darllen fel un paru bwriadol."),
            new("Sticky", "bool", "false", "Pan fydd yn wir, yn glynu wrth frig yr ardal wylio wrth i'r dudalen sgrolio (position: sticky; top: 0).")
        ]
        : [
            new("Brand", "RenderFragment?", "null", "Rendered first - typically a CyBrandLogo."),
            new("ChildContent", "RenderFragment?", "null", "Primary bar content between Brand and Actions - plain links, or a CyNavigation for built-in mobile collapse."),
            new("Actions", "RenderFragment?", "null", "Rendered last and pushed to the end of the bar - typically icon buttons (search, theme toggle, account menu)."),
            new("Background", "ComponentColour", "Primary", "Must be Primary, Secondary, Surface, or Neutral. Matches CyFooter's Background convention, so a header+footer pair using the same value reads as one deliberate pairing."),
            new("Sticky", "bool", "false", "When true, sticks to the top of the viewport while the page scrolls (position: sticky; top: 0).")
        ];

    private IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> A11yItems => Strings.Language == AppLanguage.Welsh
        ? [
            new("Tirnod semantig", "Yn rendro fel elfen <header> go iawn, gan roi tirnod baner eglur i dechnoleg gynorthwyol."),
            new("Dolenni darllenadwy ar bob cefndir", "Mae plant <a> plaen yn rhagosod lliw i etifeddu (inherit) gydag islinell, gan aros yn ddarllenadwy yn erbyn pob un o'r pedwar gwerth Cefndir heb steilio ychwanegol."),
            new("Cyfansoddi yn hytrach na dyblygu", "Nid yw'n gweithredu ei dogl llywio symudol ei hun yn fwriadol - mae cyfansoddi CyNavigation ar gyfer hynny yn osgoi dau ymddygiad cwympo gwahanol ac anghyson o fewn yr un bar.")
        ]
        : [
            new("Semantic landmark", "Renders as a real <header> element, giving assistive tech a clear banner landmark."),
            new("Readable links on every background", "Plain <a> children default to colour: inherit with an underline, staying readable against all four Background values without extra styling."),
            new("Composes rather than duplicates", "Deliberately doesn't implement its own mobile nav toggle - composing CyNavigation for that avoids two different, possibly inconsistent collapse behaviours living in the same bar.")
        ];
}
