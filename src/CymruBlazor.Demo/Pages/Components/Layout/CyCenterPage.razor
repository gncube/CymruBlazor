@page "/layouts/center"
@namespace CymruBlazor.Demo.Pages.Components.Layout
@using CymruBlazor.Demo.SharedComponents

<CyPageHeader Title="CyCenter" Subtitle="Centers child content horizontally and/or vertically using flexbox.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Layout" Href="/layouts" />
            <CyBreadcrumbItem Text="CyCenter" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="@Strings.Nav.ComponentDocumentationTabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="@(_activeTab == Tab.Examples ? "panel-examples" : null)" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">@Strings.Nav.Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="@(_activeTab == Tab.Api ? "panel-api" : null)" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">@Strings.Nav.Api</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="@(_activeTab == Tab.Accessibility ? "panel-accessibility" : null)" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">@Strings.Nav.Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview" style="padding:0;">
            <CyCenter Horizontal="_horizontal" Vertical="_vertical" FullHeight="_fullHeight"
                      Style="height:200px; width:100%; background:var(--cymru-color-surface-alt); border-radius:var(--docs-code-radius);">
                <div style="padding:var(--cymru-space-4); background:var(--cymru-color-primary); color:var(--cymru-color-text-inverse); border-radius:var(--cymru-radius-sm);">
                    Centered content
                </div>
            </CyCenter>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertySwitch Label="Horizontal" @bind-Value="_horizontal" />
                <DemoPropertySwitch Label="Vertical" @bind-Value="_vertical" />
                <DemoPropertySwitch Label="FullHeight" @bind-Value="_fullHeight" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Layout/CyCenter.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <p class="cb-section-description" style="margin-top:1.5rem;">
            A common combination: <code>FullHeight="true"</code> with a nested <code>CyStack</code> for an empty-state
            panel or loading screen -
        </p>
        <CyCodeBlock Code="@EmptyStateExampleCode" Language="razor" />

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private bool _horizontal = true;
    private bool _vertical = true;
    private bool _fullHeight;

    private string GeneratedCode =>
        $"""
        <CyCenter{(!_horizontal ? " Horizontal=\"false\"" : "")}{(!_vertical ? " Vertical=\"false\"" : "")}{(_fullHeight ? " FullHeight=\"true\"" : "")}>
            <div>Centered content</div>
        </CyCenter>
        """;

    private const string EmptyStateExampleCode =
        """
        <CyCenter FullHeight="true">
            <CyStack Orientation="Orientation.Vertical" Gap="ComponentSize.Small" AlignItems="AlignItems.Center">
                <span aria-hidden="true">📋</span>
                <strong>No records found</strong>
                <span>Adjust your filters and try again.</span>
            </CyStack>
        </CyCenter>
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Horizontal", "bool", "true", "Applies justify-content: center."),
        new("Vertical", "bool", "true", "Applies align-items: center."),
        new("FullHeight", "bool", "false", "Sets min-height: 100% on the root element - use for empty states or loading screens that should fill their parent."),
        new("ChildContent", "RenderFragment", "-", "The content to center.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Neutral wrapper", "Renders a plain <div> with no interactive or landmark semantics of its own, so it never interferes with the page's structure."),
        new("Visual centering only", "Centering is purely presentational (flexbox) and doesn't affect the DOM order or reading order of its content, so tab order and screen reader order stay predictable regardless of visual position.")
    ];
}
