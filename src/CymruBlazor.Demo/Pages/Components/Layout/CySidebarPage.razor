@page "/layouts/sidebar"
@namespace CymruBlazor.Demo.Pages.Components.Layout
@using CymruBlazor.Components.Layout
@using CymruBlazor.Demo.SharedComponents
@using CymruBlazor.Enums

<CyPageHeader Title="CySidebar"
              Subtitle="A composable, responsive sidebar layout component supporting multi-state cycling and mobile drawer presentation.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Layout" Href="/layouts" />
            <CyBreadcrumbItem Text="CySidebar" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)"
            aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")"
            @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api"
            class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)"
            aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")"
            @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <p class="cb-section-description">
            Use the chevrons in the sidebar header to step through the configured <code>States</code>:
            <strong>Expanded</strong> &harr; <strong>Compact</strong> &harr; <strong>IconOnly</strong> &harr;
            <strong>Hidden</strong>. The narrow chevron moves towards Hidden and the widen chevron moves back
            (neither wraps around). When in the <code>Hidden</code> state, a reveal handle sits along the sidebar's
            edge to bring it back without creating a keyboard focus trap.
        </p>

        <div class="cb-workbench-preview">
            <div class="cb-sidebar-stage">
                <CySidebar @ref="_sidebarRef" Position="_position" Width="_width" States="_cyclingStates"
                           @bind-State="_state" @bind-MobileOpen="_mobileOpen"
                           ShowBrandWhenCollapsed="_railLogo" CollapsedBrand="@(_railLogo ? RailBrand : null)">
                    <Brand>
                        <CyBrandLogo Variant="_logoVariant" Size="_logoSize" Text="@_logoText" Href="@null" />
                    </Brand>
                    <ChildContent>
                        <nav aria-label="Preview navigation">
                            @foreach (var (text, icon, current) in _previewItems)
                            {
                                <a href="#" class="cy-sidebar__item" title="@text"
                                   aria-current="@(current ? "page" : null)" @onclick:preventDefault>
                                    <CyIcon Name="@icon" Size="20" />
                                    <span class="cy-sidebar__label">@text</span>
                                </a>
                            }
                        </nav>
                    </ChildContent>
                </CySidebar>

                <div class="cb-sidebar-stage__main">
                    <p class="cb-sidebar-stage__title">Main content area</p>
                    <div class="cb-sidebar-stage__status">
                        <span class="cb-sidebar-stage__chip">State <strong>@_state</strong></span>
                        <span class="cb-sidebar-stage__chip">Mobile drawer <strong>@(_mobileOpen ? "Open" : "Closed")</strong></span>
                    </div>
                    <div class="cb-sidebar-stage__actions">
                        <CyButton Size="ComponentSize.Small" OnClick="NarrowSidebarAsync">Narrow</CyButton>
                        <CyButton Size="ComponentSize.Small" Variant="ComponentColour.Secondary" OnClick="WidenSidebarAsync">Widen</CyButton>
                        <CyButton Size="ComponentSize.Small" Variant="ComponentColour.Secondary" OnClick="ExpandSidebarAsync">Expand</CyButton>
                        <CyButton Size="ComponentSize.Small" Variant="ComponentColour.Secondary" OnClick="SetHiddenAsync">Hide</CyButton>
                        <CyButton Size="ComponentSize.Small" Variant="ComponentColour.Secondary" OnClick="ToggleDrawer">Toggle mobile drawer</CyButton>
                    </div>
                    <p class="cb-sidebar-stage__hint">
                        The mobile drawer only appears when the browser window is narrower than the mobile breakpoint
                        (<code>47.99rem</code> by default).
                    </p>
                </div>
            </div>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <p class="cb-property-group-title">Sidebar</p>
                <DemoPropertyToggleGroup Label="Position" @bind-Value="_position" Options="_positionOptions"
                                         TValue="SidebarPosition" />
                <DemoPropertyToggleGroup Label="Width" @bind-Value="_width" Options="_widthOptions" TValue="SidebarWidth" />

                <p class="cb-property-group-title">Brand logo (CyBrandLogo)</p>
                <DemoPropertyToggleGroup Label="Variant" @bind-Value="_logoVariant" Options="_logoVariantOptions"
                                         TValue="BrandLogoVariant" />
                <DemoPropertyToggleGroup Label="Size" @bind-Value="_logoSize" Options="_logoSizeOptions"
                                         TValue="ComponentSize" />
                <DemoPropertyTextInput Label="Text (built-in lockup)" @bind-Value="_logoText" />

                <p class="cb-property-group-title">Rail logo (CollapsedBrand)</p>
                <DemoPropertySwitch Label="Show icon logo in the Compact and IconOnly rails" @bind-Value="_railLogo" />
                @if (_railLogo)
                {
                    <DemoPropertyToggleGroup Label="Rail logo size" @bind-Value="_railLogoSize"
                                             Options="_railLogoSizeOptions" TValue="ComponentSize" />
                    <p class="cb-property-hint">
                        The IconOnly rail is 5rem wide, so keep the rail logo at Large (64px) or smaller.
                    </p>
                }
                else
                {
                    <p class="cb-property-hint">
                        With no icon logo, the rails show only the two size chevrons
                        (<code>ShowBrandWhenCollapsed="false"</code>).
                    </p>
                }
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Layout/CySidebar.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <p class="cb-section-description" style="margin-top:1.5rem;">
            <code>CySidebar</code> supports composable multi-state cycling via the <code>States</code> parameter.
            By binding
            <code>[SidebarState.Expanded, SidebarState.Compact, SidebarState.IconOnly, SidebarState.Hidden]</code>,
            the header shows two chevrons - one to narrow the sidebar a step and one to widen it - and the
            sidebar can also be driven programmatically via <code>NarrowAsync()</code>, <code>WidenAsync()</code>
            or <code>CycleNextAsync()</code>. In the Compact and IconOnly rails the header shows the icon-sized
            <code>CollapsedBrand</code> when supplied (or just the two chevrons when
            <code>ShowBrandWhenCollapsed="false"</code>). With one or two states the original single toggle is kept.
        </p>
        <CyCodeBlock Code="@MultiStateRecipeCode" Language="csharp" />

        <div style="margin-top: var(--docs-section-gap);">
            <h3>Customizing widths</h3>
            <p class="cb-section-description">
                Only the <strong>Expanded</strong> width is a parameter: <code>Width</code> picks one of three
                presets (the default is <code>SidebarWidth.Medium</code>). The Compact and IconOnly rails have
                fixed widths of their own, because a rail's width is set by its content - icon size, the two size
                chevrons, wrapped labels - not by how wide the expanded sidebar is. So changing
                <code>Width</code> does <em>not</em> resize the rails.
            </p>
            <table class="cb-api-table" aria-label="Sidebar widths by state">
                <thead><tr><th>State</th><th>Default width</th><th>How to change it</th></tr></thead>
                <tbody>
                    <tr><td><code>Expanded</code></td><td>14rem (<code>Small</code>), 18rem (<code>Medium</code>), 22rem (<code>Large</code>)</td><td><code>Width</code> parameter, or override <code>.cy-sidebar--sm</code> / <code>--md</code> / <code>--lg</code> in CSS</td></tr>
                    <tr><td><code>Compact</code></td><td>6.5rem</td><td>Override <code>.cy-sidebar--compact</code> in CSS</td></tr>
                    <tr><td><code>IconOnly</code></td><td>5rem</td><td>Override <code>.cy-sidebar--icon-only</code> in CSS</td></tr>
                    <tr><td><code>Hidden</code></td><td>0</td><td>Fixed - the sidebar collapses to nothing and a reveal handle is shown</td></tr>
                    <tr><td>Mobile drawer</td><td><code>min(85vw, 20rem)</code></td><td>Applies only below the mobile breakpoint, whatever the state</td></tr>
                </tbody>
            </table>
            <p class="cb-section-description" style="margin-top:1rem;">
                To change a width, add rules to your own stylesheet and target the sidebar with the
                <code>Class</code> you gave it. Set both <code>flex-basis</code> and <code>width</code>:
            </p>
            <CyCodeBlock Code="@WidthOverrideCode" Language="css" />
            <h4>Cautions</h4>
            <ul class="cb-section-description">
                <li>
                    <strong>Use a stylesheet, not the <code>Style</code> parameter.</strong> An inline style applies in
                    every state, so a width set there would also apply to the Compact and IconOnly rails.
                </li>
                <li>
                    <strong>Set both <code>flex-basis</code> and <code>width</code>.</strong> The library sets both, and
                    setting only one leaves the other at the default. Your own CSS wins without
                    <code>!important</code>, because the library's styles live in a CSS cascade layer and unlayered
                    styles always beat layered ones.
                </li>
                <li>
                    <strong>Keep IconOnly at about 4.8rem or wider.</strong> The two size chevrons need 4.25rem plus the
                    header padding, and anything narrower is clipped.
                </li>
                <li>
                    <strong>Size the logo to fit the rail.</strong> A logo is limited by the rail's inner width, so pick a
                    <code>CyBrandLogo</code> <code>Size</code> that fits (see the
                    <a href="/branding/brand-logo">CyBrandLogo</a> page for the pixel scale).
                </li>
            </ul>
        </div>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private CySidebar? _sidebarRef;
    private SidebarPosition _position = SidebarPosition.Left;
    private SidebarWidth _width = SidebarWidth.Medium;
    private SidebarState _state = SidebarState.Expanded;
    private bool _mobileOpen;
    private BrandLogoVariant _logoVariant = BrandLogoVariant.Auto;
    private ComponentSize _logoSize = ComponentSize.Medium;
    private string _logoText = "CymruBlazor";
    private bool _railLogo = true;
    private ComponentSize _railLogoSize = ComponentSize.Medium;

    private static readonly (string Text, string Icon, bool Current)[] _previewItems =
    [
        ("Dashboard", "dashboard", true),
        ("Appointments", "appointment", false),
        ("Wards", "ward", false),
        ("Reports", "chart", false)
    ];

    // The icon-sized logo shown in the Compact and IconOnly rails.
    private RenderFragment RailBrand =>
        @<CyBrandLogo Variant="_logoVariant" SymbolOnly="true" Size="_railLogoSize" Text="@_logoText" Href="@null" />;

    private static readonly IReadOnlyList<SidebarState> _cyclingStates =
    [
        SidebarState.Expanded,
        SidebarState.Compact,
        SidebarState.IconOnly,
        SidebarState.Hidden
    ];

    private readonly IReadOnlyList<SidebarPosition> _positionOptions =
    [
        SidebarPosition.Left, SidebarPosition.Right
    ];

    private readonly IReadOnlyList<SidebarWidth> _widthOptions =
    [
        SidebarWidth.Small, SidebarWidth.Medium, SidebarWidth.Large
    ];

    private readonly IReadOnlyList<BrandLogoVariant> _logoVariantOptions =
    [
        BrandLogoVariant.Auto, BrandLogoVariant.Full, BrandLogoVariant.Mark, BrandLogoVariant.Wordmark
    ];

    private readonly IReadOnlyList<ComponentSize> _logoSizeOptions =
    [
        ComponentSize.Small, ComponentSize.Medium, ComponentSize.Large, ComponentSize.ExtraLarge
    ];

    private readonly IReadOnlyList<ComponentSize> _railLogoSizeOptions =
    [
        ComponentSize.ExtraSmall, ComponentSize.Small, ComponentSize.Medium, ComponentSize.Large
    ];

    private async Task NarrowSidebarAsync()
    {
        if (_sidebarRef is not null)
        {
            await _sidebarRef.NarrowAsync();
        }
    }

    private async Task WidenSidebarAsync()
    {
        if (_sidebarRef is not null)
        {
            await _sidebarRef.WidenAsync();
        }
    }

    private async Task ExpandSidebarAsync()
    {
        if (_sidebarRef is not null)
        {
            await _sidebarRef.ExpandAsync();
        }
    }

    private async Task SetHiddenAsync()
    {
        if (_sidebarRef is not null)
        {
            await _sidebarRef.SetStateAsync(SidebarState.Hidden);
        }
    }

    private void ToggleDrawer()
    {
        _mobileOpen = !_mobileOpen;
    }

    private string GeneratedCode
    {
        get
        {
            var usesBuiltInText = _logoVariant is BrandLogoVariant.Full or BrandLogoVariant.Wordmark;
            var textAttribute = usesBuiltInText ? $" Text=\"{_logoText}\"" : string.Empty;

            var lines = new List<string>
            {
                "<CySidebar",
                $"    Position=\"SidebarPosition.{_position}\"",
                $"    Width=\"SidebarWidth.{_width}\"",
                "    States=\"[SidebarState.Expanded, SidebarState.Compact, SidebarState.IconOnly, SidebarState.Hidden]\"",
                "    @bind-State=\"_state\"",
                "    @bind-MobileOpen=\"_mobileOpen\">",
                "    <Brand>",
                $"        <CyBrandLogo Variant=\"BrandLogoVariant.{_logoVariant}\" Size=\"ComponentSize.{_logoSize}\"{textAttribute} />",
                "    </Brand>"
            };

            if (_railLogo)
            {
                lines.Add("    <CollapsedBrand>");
                lines.Add($"        <CyBrandLogo Variant=\"BrandLogoVariant.{_logoVariant}\" SymbolOnly=\"true\" Size=\"ComponentSize.{_railLogoSize}\"{textAttribute} />");
                lines.Add("    </CollapsedBrand>");
            }
            else
            {
                // Replace the opening tag's last attribute so ShowBrandWhenCollapsed sits with the others.
                lines[5] = "    @bind-MobileOpen=\"_mobileOpen\"";
                lines.Insert(6, "    ShowBrandWhenCollapsed=\"false\">");
            }

            lines.Add("    <ChildContent>");
            lines.Add("        <nav aria-label=\"Primary\">");
            lines.Add("            <a href=\"/\" class=\"cy-sidebar__item\" aria-current=\"page\">");
            lines.Add("                <CyIcon Name=\"dashboard\" Size=\"20\" /><span class=\"cy-sidebar__label\">Dashboard</span>");
            lines.Add("            </a>");
            lines.Add("            <a href=\"/appointments\" class=\"cy-sidebar__item\">");
            lines.Add("                <CyIcon Name=\"appointment\" Size=\"20\" /><span class=\"cy-sidebar__label\">Appointments</span>");
            lines.Add("            </a>");
            lines.Add("        </nav>");
            lines.Add("    </ChildContent>");
            lines.Add("</CySidebar>");

            return string.Join(Environment.NewLine, lines);
        }
    }

    private const string WidthOverrideCode =
        """
        /* <CySidebar Class="app-shell__nav-sidebar" Width="SidebarWidth.Small" ... /> */
        .app-shell__nav-sidebar.cy-sidebar--sm        { flex-basis: 16rem;  width: 16rem;  } /* Expanded (Small) */
        .app-shell__nav-sidebar.cy-sidebar--compact   { flex-basis: 7.5rem; width: 7.5rem; } /* Compact rail */
        .app-shell__nav-sidebar.cy-sidebar--icon-only { flex-basis: 5.5rem; width: 5.5rem; } /* IconOnly rail */
        """;

    private const string MultiStateRecipeCode =
        """
        // In your component or page:
        private CySidebar? _sidebar;
        private SidebarState _state = SidebarState.Expanded;
        private bool _mobileOpen;

        private readonly IReadOnlyList<SidebarState> _states =
        [
            SidebarState.Expanded,
            SidebarState.Compact,
            SidebarState.IconOnly,
            SidebarState.Hidden
        ];

        // Programmatic progression:
        private async Task OnCycleClicked() => await (_sidebar?.CycleNextAsync() ?? Task.CompletedTask);
        private async Task OnExpandClicked() => await (_sidebar?.ExpandAsync() ?? Task.CompletedTask);
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("States", "IReadOnlyList<SidebarState>", "[Expanded, Compact]", "List of states through which the sidebar cycles when toggled."),
        new("State", "SidebarState", "Expanded", "Active display state: Expanded, Compact, IconOnly, or Hidden. Two-way bindable via @bind-State."),
        new("StateChanged", "EventCallback<SidebarState>", "-", "Raised when State changes."),
        new("MobileOpen", "bool", "false", "Whether the responsive off-canvas drawer is open. Two-way bindable via @bind-MobileOpen."),
        new("MobileOpenChanged", "EventCallback<bool>", "-", "Raised when MobileOpen changes."),
        new("MobileBreakpoint", "string", "47.99rem", "CSS media query breakpoint below which off-canvas drawer rules apply."),
        new("ShowMobileBackdrop", "bool", "true", "Whether the dismissible overlay backdrop is rendered while MobileOpen is true."),
        new("Position", "SidebarPosition", "Left", "Which edge the sidebar docks to: Left or Right."),
        new("Width", "SidebarWidth", "Medium", "Expanded width: Small, Medium, or Large."),
        new("Brand", "RenderFragment?", "null", "Optional brand lockup rendered in the header row."),
        new("CollapsedBrand", "RenderFragment?", "null", "Brand shown instead of Brand in the Compact and IconOnly rails - typically the icon-sized logo."),
        new("ShowBrandWhenCollapsed", "bool", "true", "When false and no CollapsedBrand is set, the rails show only the size chevrons."),
        new("ChildContent", "RenderFragment?", "null", "The navigation items rendered in the sidebar."),
        new("Collapsed (Obsolete)", "bool", "false", "Legacy collapsed flag. Deprecated in favor of States and State."),
        new("CollapseMode (Obsolete)", "SidebarCollapseMode", "Compact", "Legacy appearance mode. Deprecated in favor of States and State.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Complementary landmark", "Renders as an <aside> landmark for assistive technology navigation."),
        new("Keyboard escape from Hidden state", "When in the Hidden state, an exterior reveal handle (.cy-sidebar__reveal-handle) is rendered with aria-label=\"Reveal sidebar\", preventing keyboard focus traps."),
        new("Inert hidden content", "When Hidden, zero-width clipped internal header elements receive aria-hidden=\"true\" and tabindex=\"-1\" so screen readers bypass inaccessible controls."),
        new("Accessible mobile drawer", "The off-canvas mobile drawer renders a mutually exclusive close button with aria-label=\"Close sidebar\" and a backdrop overlay marked aria-hidden=\"true\".")
    ];
}
