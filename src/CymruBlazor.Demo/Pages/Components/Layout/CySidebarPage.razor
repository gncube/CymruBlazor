@page "/layouts/sidebar"
@namespace CymruBlazor.Demo.Pages.Components.Layout
@using CymruBlazor.Demo.Shared

<CyPageHeader Title="CySidebar" Subtitle="A collapsible, responsive sidebar panel.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Layout" Href="/layouts" />
            <CyBreadcrumbItem Text="CySidebar" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <div class="cb-workbench-preview">
            <div style="display:flex; gap:0; height:180px; width:100%; overflow:hidden; border:1px solid var(--cymru-color-border); border-radius:var(--cymru-radius-md);">
                @if (_position == SidebarPosition.Left)
                {
                    <CySidebar Position="_position" Width="_width" Collapsed="_collapsed" CollapseMode="_collapseMode">
                        <Brand>
                            @if (!_collapsed)
                            {
                                <CyBrandLogo Variant="BrandLogoVariant.Mark" Size="ComponentSize.Small" />
                            }
                        </Brand>
                        <ChildContent>
                            <div class="cy-sidebar__item"><span class="cy-sidebar__label">Home</span></div>
                            <div class="cy-sidebar__item"><span class="cy-sidebar__label">Appointments</span></div>
                        </ChildContent>
                    </CySidebar>
                }
                <div style="flex:1; padding:var(--cymru-space-4); font-size:var(--cymru-font-size-sm); color:var(--cymru-color-text-muted);">
                    Main content area
                </div>
                @if (_position == SidebarPosition.Right)
                {
                    <CySidebar Position="_position" Width="_width" Collapsed="_collapsed" CollapseMode="_collapseMode">
                        <Brand>
                            @if (!_collapsed)
                            {
                                <CyBrandLogo Variant="BrandLogoVariant.Mark" Size="ComponentSize.Small" />
                            }
                        </Brand>
                        <ChildContent>
                            <div class="cy-sidebar__item"><span class="cy-sidebar__label">Home</span></div>
                            <div class="cy-sidebar__item"><span class="cy-sidebar__label">Appointments</span></div>
                        </ChildContent>
                    </CySidebar>
                }
            </div>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertyToggleGroup Label="Position" @bind-Value="_position" Options="_positionOptions" TValue="SidebarPosition" />
                <DemoPropertyToggleGroup Label="Width" @bind-Value="_width" Options="_widthOptions" TValue="SidebarWidth" />
                <DemoPropertySelect Label="Collapse mode" @bind-Value="_collapseMode" Options="_collapseModeOptions" TValue="SidebarCollapseMode" />
                <DemoPropertySwitch Label="Collapsed" @bind-Value="_collapsed" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <DemoCodeBlock Code="@GeneratedCode" Language="razor" />
            </div>
        </div>

        <p class="cb-section-description" style="margin-top:1.5rem;">
            <code>CollapseMode.Disabled</code> ignores <code>Collapsed</code> entirely (always renders expanded) -
            use it for a permanent, structural navigation rail. <code>Hidden</code> collapses to zero width with
            <code>overflow: hidden</code>, the most extreme "fully hidden" state; <code>Compact</code>/<code>IconOnly</code>
            (shown above) keep a visible icon rail instead.
        </p>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private SidebarPosition _position = SidebarPosition.Left;
    private SidebarWidth _width = SidebarWidth.Small;
    private SidebarCollapseMode _collapseMode = SidebarCollapseMode.Compact;
    private bool _collapsed;

    private readonly IReadOnlyList<SidebarPosition> _positionOptions =
    [
        SidebarPosition.Left, SidebarPosition.Right
    ];

    private readonly IReadOnlyList<SidebarWidth> _widthOptions =
    [
        SidebarWidth.Small, SidebarWidth.Medium, SidebarWidth.Large
    ];

    private readonly IReadOnlyList<SidebarCollapseMode> _collapseModeOptions =
    [
        SidebarCollapseMode.Compact, SidebarCollapseMode.IconOnly,
        SidebarCollapseMode.Disabled, SidebarCollapseMode.Hidden
    ];

    private string GeneratedCode =>
        $"""
        <CySidebar
            Position="SidebarPosition.{_position}"
            Width="SidebarWidth.{_width}"
            CollapseMode="SidebarCollapseMode.{_collapseMode}"{(_collapsed ? "\n    Collapsed=\"true\"" : "")}>
            <Brand><CyBrandLogo Variant="BrandLogoVariant.Mark" /></Brand>
            <ChildContent>
                <div class="cy-sidebar__item"><span class="cy-sidebar__label">Home</span></div>
            </ChildContent>
        </CySidebar>
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Position", "SidebarPosition", "Left", "Which edge the sidebar docks to: Left or Right."),
        new("Width", "SidebarWidth", "Medium", "Expanded width: Small, Medium, or Large."),
        new("Collapsed", "bool", "false", "Whether the sidebar is collapsed. Two-way bindable via @bind-Collapsed, or toggle programmatically with ToggleAsync()."),
        new("CollapsedChanged", "EventCallback<bool>", "-", "Raised when Collapsed changes, including via ToggleAsync()."),
        new("CollapseMode", "SidebarCollapseMode", "Compact", "Appearance used while collapsed: Compact, IconOnly, Disabled, or Hidden."),
        new("Brand", "RenderFragment?", "null", "Optional brand lockup rendered above ChildContent. Omitted entirely (not just hidden) while collapsed."),
        new("ChildContent", "RenderFragment?", "null", "The sidebar's navigation content.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Complementary landmark", "Renders as <aside>, a complementary landmark - screen readers announce it as a separate navigation region."),
        new("Toggle trigger is the consumer's responsibility", "CySidebar doesn't render its own toggle button; whatever triggers Collapsed must carry a descriptive aria-label or aria-expanded."),
        new("Labels survive IconOnly", "Item labels stay in the accessible tree (not aria-hidden) even in CollapseMode.IconOnly, where they're only hidden visually."),
        new("Transform, not display:none", "On mobile, the collapsed sidebar animates via transform: translateX rather than display: none, so it stays predictable for assistive tech during the transition.")
    ];
}
