@page "/layouts/sidebar"
@namespace CymruBlazor.Demo.Pages.Components.Layout
@using CymruBlazor.Components.Layout
@using CymruBlazor.Demo.SharedComponents
@using CymruBlazor.Enums

<CyPageHeader Title="CySidebar"
              Subtitle="A composable, responsive sidebar layout component supporting multi-state cycling and mobile drawer presentation.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Layout" Href="/layouts" />
            <CyBreadcrumbItem Text="CySidebar" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)"
            aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")"
            @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api"
            class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)"
            aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")"
            @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <p class="cb-section-description">
            Click the chevron in the sidebar header to advance cyclically through the configured <code>States</code>
            sequence:
            <strong>Expanded</strong> &rarr; <strong>Compact</strong> &rarr; <strong>IconOnly</strong> &rarr;
            <strong>Hidden</strong> &rarr; back to Expanded.
            When in the <code>Hidden</code> state, an exterior reveal handle button is positioned along the outer edge to
            restore the sidebar view without creating a keyboard focus trap.
        </p>

        <div class="cb-workbench-preview">
            <div
                style="display:flex; gap:0; min-height:260px; width:100%; position:relative; overflow:hidden; border:1px solid var(--cymru-color-border); border-radius:var(--cymru-radius-md);">
                @if (_position == SidebarPosition.Left)
                {
                    <CySidebar @ref="_sidebarRef" Position="_position" Width="_width" States="_cyclingStates"
                               @bind-State="_state" @bind-MobileOpen="_mobileOpen">
                        <Brand>
                            <CyBrandLogo Variant="BrandLogoVariant.Auto" SymbolOnly="@(_state != SidebarState.Expanded)"
                                         Size="ComponentSize.Small" />
                        </Brand>
                        <ChildContent>
                            <div class="cy-sidebar__item">
                                <CyIcon Name="home" Size="18" /><span class="cy-sidebar__label">Home</span>
                            </div>
                            <div class="cy-sidebar__item">
                                <CyIcon Name="appointment" Size="18" /><span class="cy-sidebar__label">Appointments</span>
                            </div>
                        </ChildContent>
                    </CySidebar>
                }
                <div
                    style="flex:1; padding:var(--cymru-space-4); font-size:var(--cymru-font-size-sm); color:var(--cymru-color-text-muted); background:var(--cymru-color-surface-subtle);">
                    <div>Main content area</div>
                    <div style="margin-top:var(--cymru-space-2);">Current State: <strong>@_state</strong></div>
                    <div style="margin-top:var(--cymru-space-1);">Mobile Drawer Open: <strong>@_mobileOpen</strong></div>

                    <div style="margin-top:var(--cymru-space-4); display:flex; flex-wrap:wrap; gap:0.5rem;">
                        <button type="button" class="cymru-btn" @onclick="() => _sidebarRef?.CycleNextAsync()">Cycle
                            Next</button>
                            <button type="button" class="cymru-btn" @onclick="() => _sidebarRef?.ExpandAsync()">Expand</button>
                            <button type="button" class="cymru-btn"
                                    @onclick="() => _sidebarRef?.SetStateAsync(SidebarState.IconOnly)">Icon Only</button>
                            <button type="button" class="cymru-btn"
                                    @onclick="() => _sidebarRef?.SetStateAsync(SidebarState.Hidden)">Hide</button>
                            <button type="button" class="cymru-btn" @onclick="() => _mobileOpen = !_mobileOpen">Toggle Mobile
                                Drawer</button>
                            </div>
                        </div>
                        @if (_position == SidebarPosition.Right)
                        {
                            <CySidebar @ref="_sidebarRef" Position="_position" Width="_width" States="_cyclingStates"
                                       @bind-State="_state" @bind-MobileOpen="_mobileOpen">
                                <Brand>
                                    <CyBrandLogo Variant="BrandLogoVariant.Auto" SymbolOnly="@(_state != SidebarState.Expanded)"
                                                 Size="ComponentSize.Small" />
                                </Brand>
                                <ChildContent>
                                    <div class="cy-sidebar__item">
                                        <CyIcon Name="home" Size="18" /><span class="cy-sidebar__label">Home</span>
                                    </div>
                                    <div class="cy-sidebar__item">
                                        <CyIcon Name="appointment" Size="18" /><span class="cy-sidebar__label">Appointments</span>
                                    </div>
                                </ChildContent>
                            </CySidebar>
                        }
                    </div>
                </div>

                <div class="cb-playground-grid">
                    <DemoPropertyControls>
                        <DemoPropertyToggleGroup Label="Position" @bind-Value="_position" Options="_positionOptions"
                                                 TValue="SidebarPosition" />
                        <DemoPropertyToggleGroup Label="Width" @bind-Value="_width" Options="_widthOptions" TValue="SidebarWidth" />
                    </DemoPropertyControls>

                    <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                        <span class="cb-panel-caption">Generated code</span>
                        <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                        <a class="cb-open-in-github"
                           href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Layout/CySidebar.razor"
                           target="_blank" rel="noopener noreferrer">
                            Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                        </a>
                    </div>
                </div>

                <p class="cb-section-description" style="margin-top:1.5rem;">
                    <code>CySidebar</code> supports composable multi-state cycling via the <code>States</code> parameter.
                    By binding
                    <code>[SidebarState.Expanded, SidebarState.Compact, SidebarState.IconOnly, SidebarState.Hidden]</code>,
                    clicking the header toggle advances automatically through each configured state or can be driven
                    programmatically via <code>CycleNextAsync()</code>.
                </p>
                <CyCodeBlock Code="@MultiStateRecipeCode" Language="csharp" />

            </div>
        }
else if (_activeTab == Tab.Api)
        {
            <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
                <DemoApiTable Parameters="_apiDocs" />
            </div>
        }
        else
        {
            <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
                <DemoAccessibilityChecklist Items="_a11yItems" />
            </div>
        }

@code {
    private enum Tab { Examples, Api, Accessibility }

    private Tab _activeTab = Tab.Examples;
    private CySidebar? _sidebarRef;
    private SidebarPosition _position = SidebarPosition.Left;
    private SidebarWidth _width = SidebarWidth.Medium;
    private SidebarState _state = SidebarState.Expanded;
    private bool _mobileOpen;

    private static readonly IReadOnlyList<SidebarState> _cyclingStates =
    [
        SidebarState.Expanded,
        SidebarState.Compact,
        SidebarState.IconOnly,
        SidebarState.Hidden
    ];

    private readonly IReadOnlyList<SidebarPosition> _positionOptions =
    [
        SidebarPosition.Left, SidebarPosition.Right
    ];

    private readonly IReadOnlyList<SidebarWidth> _widthOptions =
    [
        SidebarWidth.Small, SidebarWidth.Medium, SidebarWidth.Large
    ];

    private string GeneratedCode =>
        $"""
        <CySidebar
            Position="SidebarPosition.{_position}"
            Width="SidebarWidth.{_width}"
            States="[SidebarState.Expanded, SidebarState.Compact, SidebarState.IconOnly, SidebarState.Hidden]"
            @bind-State="_state"
            @bind-MobileOpen="_mobileOpen">
            <Brand>
                <CyBrandLogo Variant="BrandLogoVariant.Auto" SymbolOnly="@(_state != SidebarState.Expanded)" />
            </Brand>
            <ChildContent>
                <div class="cy-sidebar__item"><CyIcon Name="home" /><span class="cy-sidebar__label">Home</span></div>
                <div class="cy-sidebar__item"><CyIcon Name="appointment" /><span class="cy-sidebar__label">Appointments</span></div>
            </ChildContent>
        </CySidebar>
        """;

    private const string MultiStateRecipeCode =
        """
        // In your component or page:
        private CySidebar? _sidebar;
        private SidebarState _state = SidebarState.Expanded;
        private bool _mobileOpen;

        private readonly IReadOnlyList<SidebarState> _states =
        [
            SidebarState.Expanded,
            SidebarState.Compact,
            SidebarState.IconOnly,
            SidebarState.Hidden
        ];

        // Programmatic progression:
        private async Task OnCycleClicked() => await (_sidebar?.CycleNextAsync() ?? Task.CompletedTask);
        private async Task OnExpandClicked() => await (_sidebar?.ExpandAsync() ?? Task.CompletedTask);
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("States", "IReadOnlyList<SidebarState>", "[Expanded, Compact]", "List of states through which the sidebar cycles when toggled."),
        new("State", "SidebarState", "Expanded", "Active display state: Expanded, Compact, IconOnly, or Hidden. Two-way bindable via @bind-State."),
        new("StateChanged", "EventCallback<SidebarState>", "-", "Raised when State changes."),
        new("MobileOpen", "bool", "false", "Whether the responsive off-canvas drawer is open. Two-way bindable via @bind-MobileOpen."),
        new("MobileOpenChanged", "EventCallback<bool>", "-", "Raised when MobileOpen changes."),
        new("MobileBreakpoint", "string", "47.99rem", "CSS media query breakpoint below which off-canvas drawer rules apply."),
        new("ShowMobileBackdrop", "bool", "true", "Whether the dismissible overlay backdrop is rendered while MobileOpen is true."),
        new("Position", "SidebarPosition", "Left", "Which edge the sidebar docks to: Left or Right."),
        new("Width", "SidebarWidth", "Medium", "Expanded width: Small, Medium, or Large."),
        new("Brand", "RenderFragment?", "null", "Optional brand lockup rendered in the header row."),
        new("ChildContent", "RenderFragment?", "null", "The navigation items rendered in the sidebar."),
        new("Collapsed (Obsolete)", "bool", "false", "Legacy collapsed flag. Deprecated in favor of States and State."),
        new("CollapseMode (Obsolete)", "SidebarCollapseMode", "Compact", "Legacy appearance mode. Deprecated in favor of States and State.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Complementary landmark", "Renders as an <aside> landmark for assistive technology navigation."),
        new("Keyboard escape from Hidden state", "When in the Hidden state, an exterior reveal handle (.cy-sidebar__reveal-handle) is rendered with aria-label=\"Reveal sidebar\", preventing keyboard focus traps."),
        new("Inert hidden content", "When Hidden, zero-width clipped internal header elements receive aria-hidden=\"true\" and tabindex=\"-1\" so screen readers bypass inaccessible controls."),
        new("Accessible mobile drawer", "The off-canvas mobile drawer renders a mutually exclusive close button with aria-label=\"Close sidebar\" and a backdrop overlay marked aria-hidden=\"true\".")
    ];
}
