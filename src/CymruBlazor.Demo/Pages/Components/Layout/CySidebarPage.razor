@page "/layouts/sidebar"
@namespace CymruBlazor.Demo.Pages.Components.Layout
@using CymruBlazor.Demo.SharedComponents

<CyPageHeader Title="CySidebar" Subtitle="A collapsible, responsive sidebar panel.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Layout" Href="/layouts" />
            <CyBreadcrumbItem Text="CySidebar" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples)" aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">Examples</button>
    <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api)" aria-controls="panel-api" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">API</button>
    <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility)" aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">Accessibility</button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">

        <span class="cb-panel-caption">Preview</span>
        <p class="cb-section-description">
            Click the chevron in the sidebar's own header to cycle through its three
            visible states: <strong>Full</strong> &rarr; <strong>Compact</strong> &rarr;
            <strong>Icon-only</strong> &rarr; back to Full. The toggle button, and hiding/showing
            <code>Brand</code> as it collapses, are both built into <code>CySidebar</code> - this
            page only supplies the target <code>CollapseMode</code> for each step.
        </p>
        <div class="cb-workbench-preview">
            <div style="display:flex; gap:0; height:220px; width:100%; overflow:hidden; border:1px solid var(--cymru-color-border); border-radius:var(--cymru-radius-md);">
                @if (_position == SidebarPosition.Left)
                {
                    <CySidebar Position="_position" Width="_width" Collapsed="IsCollapsed" CollapseMode="EffectiveCollapseMode" CollapsedChanged="OnToggled">
                        <Brand>
                            <CyBrandLogo Variant="BrandLogoVariant.Auto" SymbolOnly="false" Size="ComponentSize.Small" />
                        </Brand>
                        <ChildContent>
                            <div class="cy-sidebar__item"><CyIcon Name="home" Size="18" /><span class="cy-sidebar__label">Home</span></div>
                            <div class="cy-sidebar__item"><CyIcon Name="appointment" Size="18" /><span class="cy-sidebar__label">Appointments</span></div>
                        </ChildContent>
                    </CySidebar>
                }
                <div style="flex:1; padding:var(--cymru-space-4); font-size:var(--cymru-font-size-sm); color:var(--cymru-color-text-muted);">
                    Main content area
                    <div style="margin-top:var(--cymru-space-2);">Current state: <strong>@_displayState</strong></div>
                </div>
                @if (_position == SidebarPosition.Right)
                {
                    <CySidebar Position="_position" Width="_width" Collapsed="IsCollapsed" CollapseMode="EffectiveCollapseMode" CollapsedChanged="OnToggled">
                        <Brand>
                            <CyBrandLogo Variant="BrandLogoVariant.Auto" SymbolOnly="false" Size="ComponentSize.Small" />
                        </Brand>
                        <ChildContent>
                            <div class="cy-sidebar__item"><CyIcon Name="home" Size="18" /><span class="cy-sidebar__label">Home</span></div>
                            <div class="cy-sidebar__item"><CyIcon Name="appointment" Size="18" /><span class="cy-sidebar__label">Appointments</span></div>
                        </ChildContent>
                    </CySidebar>
                }
            </div>
        </div>

        <div class="cb-playground-grid">
            <DemoPropertyControls>
                <DemoPropertyToggleGroup Label="Position" @bind-Value="_position" Options="_positionOptions" TValue="SidebarPosition" />
                <DemoPropertyToggleGroup Label="Width" @bind-Value="_width" Options="_widthOptions" TValue="SidebarWidth" />
            </DemoPropertyControls>

            <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
                <span class="cb-panel-caption">Generated code</span>
                <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                <a class="cb-open-in-github"
                   href="https://github.com/gncube/CymruBlazor/blob/main/src/CymruBlazor/Components/Layout/CySidebar.razor"
                   target="_blank" rel="noopener noreferrer">
                    Open in GitHub<span class="u-sr-only"> (opens in new tab)</span>
                </a>
            </div>
        </div>

        <p class="cb-section-description" style="margin-top:1.5rem;">
            <code>CySidebar</code> only exposes a single on/off <code>Collapsed</code> switch and a
            fixed <code>CollapseMode</code> for what "collapsed" looks like - cycling through
            <em>three</em> visible states, as above, is a thin pattern the host page builds on top:
            treat every <code>CollapsedChanged</code> firing as "advance to the next step" rather than
            reading the bool it carries, and hand the sidebar back whichever <code>CollapseMode</code>
            that step calls for.
        </p>
        <CyCodeBlock Code="@CycleRecipeCode" Language="csharp" />

        <p class="cb-section-description" style="margin-top:1.5rem;">
            <code>CollapseMode.Disabled</code> ignores <code>Collapsed</code> entirely (always renders expanded) -
            use it for a permanent, structural navigation rail, and note it also removes the header's chevron
            button entirely (there'd be nothing for it to do). <code>Hidden</code> collapses to zero width with
            <code>overflow: hidden</code>, the most extreme "fully hidden" state; <code>Compact</code>/<code>IconOnly</code>
            (cycled through above) keep a visible icon rail instead.
        </p>

    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab { Examples, Api, Accessibility }

    /// <summary>
    /// The three visible states this page cycles the sidebar through by
    /// treating every <c>CollapsedChanged</c> firing (i.e. every click of
    /// CySidebar's own built-in header chevron) as "advance one step" -
    /// see <see cref="OnToggled"/>.
    /// </summary>
    private enum SidebarDisplayState { Full, Compact, IconOnly }

    private Tab _activeTab = Tab.Examples;
    private SidebarPosition _position = SidebarPosition.Left;
    private SidebarWidth _width = SidebarWidth.Medium;
    private SidebarDisplayState _displayState = SidebarDisplayState.Full;

    private bool IsCollapsed => _displayState != SidebarDisplayState.Full;

    private SidebarCollapseMode EffectiveCollapseMode => _displayState switch
    {
        SidebarDisplayState.IconOnly => SidebarCollapseMode.IconOnly,
        _ => SidebarCollapseMode.Compact
    };

    /// <summary>
    /// Wired to CySidebar's <c>CollapsedChanged</c>. The bool it carries
    /// (whatever CySidebar's own <c>ToggleAsync</c> flipped its local
    /// <c>Collapsed</c> to) is deliberately ignored - this page owns a
    /// three-step state machine instead of a two-way on/off switch, so
    /// every callback just means "the chevron was clicked, advance the
    /// cycle" and this method recomputes <c>Collapsed</c>/<c>CollapseMode</c>
    /// from <see cref="_displayState"/> and hands them straight back down.
    /// </summary>
    private void OnToggled(bool _)
    {
        _displayState = _displayState switch
        {
            SidebarDisplayState.Full => SidebarDisplayState.Compact,
            SidebarDisplayState.Compact => SidebarDisplayState.IconOnly,
            _ => SidebarDisplayState.Full
        };
    }

    private readonly IReadOnlyList<SidebarPosition> _positionOptions =
    [
        SidebarPosition.Left, SidebarPosition.Right
    ];

    private readonly IReadOnlyList<SidebarWidth> _widthOptions =
    [
        SidebarWidth.Small, SidebarWidth.Medium, SidebarWidth.Large
    ];

    private string GeneratedCode =>
        $"""
        <CySidebar
            Position="SidebarPosition.{_position}"
            Width="SidebarWidth.{_width}"
            CollapseMode="SidebarCollapseMode.{EffectiveCollapseMode}"
            Collapsed="{IsCollapsed.ToString().ToLowerInvariant()}"
            CollapsedChanged="OnToggled">
            <Brand><CyBrandLogo Variant="BrandLogoVariant.Auto" /></Brand>
            <ChildContent>
                <div class="cy-sidebar__item"><CyIcon Name="home" /><span class="cy-sidebar__label">Home</span></div>
            </ChildContent>
        </CySidebar>
        """;

    private const string CycleRecipeCode =
        """
        private enum SidebarDisplayState { Full, Compact, IconOnly }

        private SidebarDisplayState _displayState = SidebarDisplayState.Full;

        private bool IsCollapsed => _displayState != SidebarDisplayState.Full;

        private SidebarCollapseMode EffectiveCollapseMode => _displayState switch
        {
            SidebarDisplayState.IconOnly => SidebarCollapseMode.IconOnly,
            _ => SidebarCollapseMode.Compact
        };

        // Wired to CySidebar's CollapsedChanged - ignore the bool it
        // carries and just advance the cycle.
        private void OnToggled(bool _)
        {
            _displayState = _displayState switch
            {
                SidebarDisplayState.Full => SidebarDisplayState.Compact,
                SidebarDisplayState.Compact => SidebarDisplayState.IconOnly,
                _ => SidebarDisplayState.Full
            };
        }
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Position", "SidebarPosition", "Left", "Which edge the sidebar docks to: Left or Right."),
        new("Width", "SidebarWidth", "Medium", "Expanded width: Small, Medium, or Large."),
        new("Collapsed", "bool", "false", "Whether the sidebar is collapsed. Two-way bindable via @bind-Collapsed, or toggle programmatically with ToggleAsync()."),
        new("CollapsedChanged", "EventCallback<bool>", "-", "Raised when Collapsed changes, including via ToggleAsync() or clicking the built-in header chevron button."),
        new("CollapseMode", "SidebarCollapseMode", "Compact", "Appearance used while collapsed: Compact, IconOnly, Disabled, or Hidden."),
        new("Brand", "RenderFragment?", "null", "Optional brand lockup (e.g. CyBrandLogo) rendered in the header row next to the chevron toggle. Omitted entirely (not just hidden) while collapsed."),
        new("ChildContent", "RenderFragment?", "null", "The sidebar's navigation content.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("Complementary landmark", "Renders as <aside>, a complementary landmark - screen readers announce it as a separate navigation region."),
        new("Built-in, labelled toggle", "CySidebar renders its own chevron button in the header row (unless CollapseMode is Disabled), with aria-expanded reflecting the current state and an aria-label of \"Expand sidebar\"/\"Collapse sidebar\" - consumers don't need to build their own trigger."),
        new("Labels survive IconOnly", "Item labels stay in the accessible tree (not aria-hidden) even in CollapseMode.IconOnly, where they're only hidden visually."),
        new("Transform, not display:none", "On mobile, the collapsed sidebar animates via transform: translateX rather than display: none, so it stays predictable for assistive tech during the transition.")
    ];
}
