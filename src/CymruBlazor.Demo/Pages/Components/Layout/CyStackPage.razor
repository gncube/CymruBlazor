@page "/layouts/stack"
@namespace CymruBlazor.Demo.Pages.Components.Layout

<div class="cb-page-header">
    <h1 class="cb-page-title">CyStack</h1>
    <p class="cb-page-description">
        Arranges child elements in a single-axis flexbox flow — vertical or
        horizontal — with consistent gap from the shared spacing scale.
        The most commonly used layout primitive.
    </p>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Vertical (default)</h2>

    <div class="cb-example">
        <span class="cb-example__label">Preview</span>
        <div class="cb-example__preview">
            <CyStack Orientation="Orientation.Vertical" Gap="ComponentSize.Medium">
                @foreach (var label in new[] { "First item", "Second item", "Third item" })
                {
                    <div style="padding:var(--cymru-space-2) var(--cymru-space-3);
                                background:var(--cymru-color-surface-alt);
                                border:1px solid var(--cymru-color-border);
                                border-radius:var(--cymru-radius-sm);
                                font-size:var(--cymru-font-size-sm)">
                        @label
                    </div>
                }
            </CyStack>
        </div>
        <pre class="cb-example__code"><code>&lt;CyStack Orientation="Orientation.Vertical"
         Gap="ComponentSize.Medium"&gt;
    &lt;div&gt;First item&lt;/div&gt;
    &lt;div&gt;Second item&lt;/div&gt;
    &lt;div&gt;Third item&lt;/div&gt;
&lt;/CyStack&gt;</code></pre>
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Horizontal</h2>

    <div class="cb-example">
        <span class="cb-example__label">Preview</span>
        <div class="cb-example__preview">
            <CyStack Orientation="Orientation.Horizontal"
                     Gap="ComponentSize.Medium"
                     AlignItems="AlignItems.Center">
                @foreach (var label in new[] { "Alpha", "Beta", "Gamma" })
                {
                    <div style="padding:var(--cymru-space-2) var(--cymru-space-3);
                                background:var(--cymru-color-primary-subtle);
                                border:1px solid var(--cymru-color-primary);
                                border-radius:var(--cymru-radius-sm);
                                font-size:var(--cymru-font-size-sm);
                                color:var(--cymru-color-primary)">
                        @label
                    </div>
                }
            </CyStack>
        </div>
        <pre class="cb-example__code"><code>&lt;CyStack Orientation="Orientation.Horizontal"
         Gap="ComponentSize.Medium"
         AlignItems="AlignItems.Center"&gt;
    &lt;div&gt;Alpha&lt;/div&gt;
    &lt;div&gt;Beta&lt;/div&gt;
    &lt;div&gt;Gamma&lt;/div&gt;
&lt;/CyStack&gt;</code></pre>
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">Gap scale</h2>
    <p class="cb-section-description">
        All gap values map to the shared 8-point spacing scale
        via <code>--cymru-space-*</code> tokens.
    </p>

    <div class="cb-example">
        <span class="cb-example__label">Preview — all gap sizes</span>
        <div class="cb-example__preview">
            <CyStack Orientation="Orientation.Vertical" Gap="ComponentSize.Large">
                @foreach (var (size, label) in new[]
                {
                    (ComponentSize.ExtraSmall, "ExtraSmall — 4px"),
                    (ComponentSize.Small,      "Small — 8px"),
                    (ComponentSize.Medium,     "Medium — 16px"),
                    (ComponentSize.Large,      "Large — 24px"),
                    (ComponentSize.ExtraLarge, "ExtraLarge — 32px"),
                })
                {
                    <div>
                        <span style="font-size:var(--cymru-font-size-xs);
                                     color:var(--cymru-color-text-muted);
                                     display:block;margin-block-end:4px">
                            @label
                        </span>
                        <CyStack Orientation="Orientation.Horizontal" Gap="@size">
                            <div style="width:48px;height:32px;background:var(--cymru-color-primary);
                                        border-radius:var(--cymru-radius-sm)"></div>
                            <div style="width:48px;height:32px;background:var(--cymru-color-primary);
                                        border-radius:var(--cymru-radius-sm)"></div>
                            <div style="width:48px;height:32px;background:var(--cymru-color-primary);
                                        border-radius:var(--cymru-radius-sm)"></div>
                        </CyStack>
                    </div>
                }
            </CyStack>
        </div>
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">API</h2>
    <table class="cb-api-table" aria-label="CyStack parameters">
        <thead>
            <tr>
                <th>Parameter</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="cb-api-table__name">Orientation</td>
                <td class="cb-api-table__type">Orientation</td>
                <td class="cb-api-table__default">Vertical</td>
                <td><code>Vertical</code> or <code>Horizontal</code> flex direction</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">Gap</td>
                <td class="cb-api-table__type">ComponentSize</td>
                <td class="cb-api-table__default">Medium</td>
                <td>Space between children from the 8-point grid</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">AlignItems</td>
                <td class="cb-api-table__type">AlignItems</td>
                <td class="cb-api-table__default">Default</td>
                <td>Cross-axis alignment: <code>Start</code>, <code>Center</code>, <code>End</code>, <code>Stretch</code></td>
            </tr>
            <tr>
                <td class="cb-api-table__name">JustifyContent</td>
                <td class="cb-api-table__type">JustifyContent</td>
                <td class="cb-api-table__default">Default</td>
                <td>Main-axis distribution of children</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">Wrap</td>
                <td class="cb-api-table__type">bool</td>
                <td class="cb-api-table__default">false</td>
                <td>Allows children to wrap to new lines</td>
            </tr>
            <tr>
                <td class="cb-api-table__name">ChildContent</td>
                <td class="cb-api-table__type">RenderFragment</td>
                <td class="cb-api-table__default">—</td>
                <td>The stacked content</td>
            </tr>
        </tbody>
    </table>
</div>
