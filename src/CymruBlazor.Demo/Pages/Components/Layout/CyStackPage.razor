@page "/layouts/stack"
@namespace CymruBlazor.Demo.Pages.Components.Layout
@using CymruBlazor.Components.Button
@using CymruBlazor.Components.Layout
@using CymruBlazor.Demo.Shared
@using CymruBlazor.Enums

<CyPageHeader Title="CyStack" Subtitle="Flexbox-based directional layout primitive.">
    <Breadcrumb>
        <CyBreadcrumb>
            <CyBreadcrumbItem Text="Layout" Href="/layouts" />
            <CyBreadcrumbItem Text="CyStack" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button"
            role="tab" id="tab-examples" aria-controls="panel-examples"
            aria-selected="@(_activeTab == Tab.Examples)"
            class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")"
            @onclick="() => _activeTab = Tab.Examples">
        Examples
    </button>
    <button type="button"
            role="tab" id="tab-api" aria-controls="panel-api"
            aria-selected="@(_activeTab == Tab.Api)"
            class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")"
            @onclick="() => _activeTab = Tab.Api">
        API
    </button>
    <button type="button"
            role="tab" id="tab-accessibility" aria-controls="panel-accessibility"
            aria-selected="@(_activeTab == Tab.Accessibility)"
            class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")"
            @onclick="() => _activeTab = Tab.Accessibility">
        Accessibility
    </button>
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
    <span class="cb-panel-caption">Preview</span>
    <div class="cb-workbench-preview">
        <CyStack Orientation="_orientation" Gap="_gap">
            <CyButton Variant="ComponentColour.Primary">Item 1</CyButton>
            <CyButton Variant="ComponentColour.Secondary">Item 2</CyButton>
            <CyButton Variant="ComponentColour.Primary">Item 3</CyButton>
        </CyStack>
    </div>

    <div class="cb-playground-grid">
        <div class="cb-playground-panel">
            <h4 style="margin-top:0; margin-bottom: 1rem;">Properties</h4>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <div>
                    <label for="stack-orientation-select" style="display:block; font-size: 0.85rem; font-weight:600; margin-bottom: 0.25rem;">
                        Orientation
                    </label>
                    <select id="stack-orientation-select" @bind="_orientation" style="width:100%; padding: 0.4rem; border-radius: 4px; border: 1px solid #cbd5e1;">
                        <option value="@Orientation.Horizontal">Horizontal</option>
                        <option value="@Orientation.Vertical">Vertical</option>
                    </select>
                </div>
                <div>
                    <label for="stack-gap-select" style="display:block; font-size: 0.85rem; font-weight:600; margin-bottom: 0.25rem;">
                        Gap
                    </label>
                    <select id="stack-gap-select" @bind="_gap" style="width:100%; padding: 0.4rem; border-radius: 4px; border: 1px solid #cbd5e1;">
                        <option value="@ComponentSize.Small">Small</option>
                        <option value="@ComponentSize.Medium">Medium</option>
                        <option value="@ComponentSize.Large">Large</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="cb-playground-panel" style="padding:0; background:none; border:none;">
            <span class="cb-panel-caption">Generated code</span>
            <DemoCodeBlock Code="@GeneratedCode" Language="razor" />
        </div>
    </div>
    </div>
}
else if (_activeTab == Tab.Api)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
    <DemoApiTable Parameters="_apiDocs" />
    </div>
}
else
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
    <DemoAccessibilityChecklist Items="_a11yItems" />
    </div>
}

@code {
    private enum Tab
    {
        Examples,
        Api,
        Accessibility
    }

    private Tab _activeTab = Tab.Examples;
    private Orientation _orientation = Orientation.Horizontal;
    private ComponentSize _gap = ComponentSize.Medium;

    private string GeneratedCode =>
        $"""
        <CyStack Orientation="Orientation.{_orientation}" Gap="ComponentSize.{_gap}">
            <CyButton Variant="ComponentColour.Primary">Item 1</CyButton>
            <CyButton Variant="ComponentColour.Secondary">Item 2</CyButton>
            <CyButton Variant="ComponentColour.Primary">Item 3</CyButton>
        </CyStack>
        """;

    private readonly IReadOnlyList<DemoApiTable.ApiParameterDoc> _apiDocs =
    [
        new("Orientation", "Orientation", "Orientation.Vertical", "Defines the directional flow (Horizontal or Vertical)."),
        new("Gap", "ComponentSize", "ComponentSize.Medium", "Spacing between stacked child elements."),
        new("ChildContent", "RenderFragment", "null", "Child content elements to layout within the stack.")
    ];

    private readonly IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion> _a11yItems =
    [
        new("DOM Order Alignment", "Visual flow strictly matches DOM order to maintain proper screen reader linearization."),
        new("Semantic Passthrough", "Container acts as a neutral layout wrapper without interfering with list or landmark roles.")
    ];
}
