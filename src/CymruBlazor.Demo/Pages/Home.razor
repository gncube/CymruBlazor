@page "/"

<PageTitle>CymruBlazor</PageTitle>

<CyContainer Size="ContainerSize.Large">

    <CyStack
        Orientation="Orientation.Vertical"
        Gap="ComponentSize.ExtraLarge">

        <section>

            <h1>CymruBlazor</h1>

            <p class="lead">
                A modern Blazor component library built for accessibility,
                performance and maintainability.
            </p>

            <p>
                CymruBlazor embraces a C# First, JavaScript Last philosophy,
                delivering accessible components, responsive layouts and
                compile-time optimisations for modern Blazor applications.
            </p>

        </section>

        <section>

            <h2>Getting Started</h2>

            <p>
                New to CymruBlazor? Start with the installation guide and build
                your first application in minutes.
            </p>

            <ul>
                <li><NavLink href="/getting-started">Getting Started</NavLink></li>
                <li><NavLink href="/installation">Installation</NavLink></li>
                <li><NavLink href="/layouts">Layouts</NavLink></li>
            </ul>

        </section>

        <section>

            <h2>Explore Components</h2>

            <p>
                Browse the complete component catalogue with interactive examples,
                accessibility guidance and API documentation.
            </p>

            <ul>
                <li><NavLink href="/components">Component Gallery</NavLink></li>
                <li><NavLink href="/playground">Playground</NavLink></li>
                <li><NavLink href="/design-tokens">Design Tokens</NavLink></li>
            </ul>

        </section>

        <section>

            <h2>Design Principles</h2>

            <ul>
                <li>Accessibility by default</li>
                <li>C# First, JavaScript Last</li>
                <li>Compile-time generation</li>
                <li>Strong typing</li>
                <li>Native WebAssembly optimisation</li>
            </ul>

        </section>

    </CyStack>

</CyContainer>
