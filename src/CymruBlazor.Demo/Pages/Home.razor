@page "/"
@namespace CymruBlazor.Demo.Pages
@using CymruBlazor.Components
@using CymruBlazor.Demo.Shared

<CyHeroBanner Title="CymruBlazor"
              Subtitle="Accessible, composable Blazor components for Welsh NHS digital services."
              Background="HeroBackground.Primary">
    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1.5rem;">
        <CyButton Variant="CyButtonVariant.Primary" Href="layouts/stack">Explore Components →</CyButton>
        <CyButton Variant="CyButtonVariant.Secondary" Href="getting-started">Get Started</CyButton>
    </div>
</CyHeroBanner>

<div style="margin-top: 2rem;">
    <CyCluster Gap="ComponentSize.Small" Justify="ClusterJustify.Center">
        <span class="cb-badge">.NET 10</span>
        <span class="cb-badge">Blazor WASM</span>
        <span class="cb-badge">WCAG 2.2 AA</span>
        <span class="cb-badge">MIT License</span>
    </CyCluster>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-top: 3rem;">
    <CyCard>
        <h3 style="margin-top:0;">♿ WCAG 2.2 AA</h3>
        <p style="color: var(--docs-text-muted); font-size: 0.9rem;">Accessible composability built for high standards across NHS Wales services.</p>
    </CyCard>
    <CyCard>
        <h3 style="margin-top:0;">🏴󠁧󠁢󠁷󠁬󠁳󠁿 Bilingual First</h3>
        <p style="color: var(--docs-text-muted); font-size: 0.9rem;">Native language support and toggling primitives for Welsh and English.</p>
    </CyCard>
    <CyCard>
        <h3 style="margin-top:0;">🎨 Design Tokens</h3>
        <p style="color: var(--docs-text-muted); font-size: 0.9rem;">Tokenized palettes and geometry adhering to Welsh NHS branding guidelines.</p>
    </CyCard>
</div>
