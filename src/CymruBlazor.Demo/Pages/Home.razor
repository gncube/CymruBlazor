@page "/"
@namespace CymruBlazor.Demo.Pages
@using CymruBlazor.Components.Content
@using CymruBlazor.Components.Layout
@using CymruBlazor.Demo.Shared
@using CymruBlazor.Enums

<CyHeroBanner Title="CymruBlazor"
              Subtitle="Accessible, composable Blazor components for Welsh NHS digital services."
              Background="HeroBackground.Primary">

    <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem;">
        <span class="cb-badge cb-badge--pill">.NET 10 · Blazor WebAssembly · Accessible</span>
    </div>

    <div style="display: flex; gap: 1rem; justify-content: center;">
        <a class="cb-demo-btn cb-demo-btn--primary" href="forms/button">Explore components →</a>
        <a class="cb-demo-btn cb-demo-btn--secondary" href="getting-started">Get started</a>
    </div>

    <CyCluster Gap="ComponentSize.Small" JustifyContent="JustifyContent.Center" Class="cb-tech-badges">
        <span class="cb-badge">.NET 10</span>
        <span class="cb-badge">C#</span>
        <span class="cb-badge">Blazor WASM</span>
        <span class="cb-badge">WCAG 2.2 AA</span>
        <span class="cb-badge">MIT License</span>
    </CyCluster>

</CyHeroBanner>

<div class="cb-feature-grid">
    @foreach (var feature in _features)
    {
        <CyCard>
            <div class="cb-feature-icon" style="background: @feature.IconBackground;">
                <CyIcon Name="@feature.Icon" Size="22" />
            </div>
            <h3 style="margin: 0.75rem 0 0.35rem;">@feature.Title</h3>
            <p style="color: var(--docs-text-muted); font-size: 0.9rem; margin: 0;">@feature.Description</p>
        </CyCard>
    }
</div>

<div style="margin-top: var(--docs-section-gap);">
    <h2>Quick start</h2>
    <DemoQuickStart Steps="_quickStartSteps" />
</div>
