@page "/"
@namespace CymruBlazor.Demo.Pages
@implements IDisposable
@inject CymruBlazor.Demo.Localisation.AppStrings Strings
@using CymruBlazor.Components.Button
@using CymruBlazor.Components.Content
@using CymruBlazor.Components.Layout
@using CymruBlazor.Demo.SharedComponents
@using CymruBlazor.Enums

<div class="cb-home">

    <section class="cb-home__hero">
        <div class="cb-home__hero-content">
            <div class="cb-home__hero-badge-wrap">
                <span class="cb-home__badge">.NET 10 · Blazor WebAssembly · @(Strings.Language == AppLanguage.Welsh ? "Hygyrch" : "Accessible")</span>
            </div>

            <h1 class="cb-home__title">CymruBlazor</h1>
            <p class="cb-home__subtitle">@(Strings.Language == AppLanguage.Welsh ? "Cydrannau Blazor hygyrch, cyfansoddadwy ar gyfer gwasanaethau digidol GIG Cymru." : "Accessible, composable Blazor components for Welsh NHS digital services.")</p>

            <div class="cb-home__actions">
                <CyButton Href="layouts/stack" Variant="ComponentColour.Tertiary" Class="cb-demo-btn cb-demo-btn--primary">@(Strings.Language == AppLanguage.Welsh ? "Archwilio'r cydrannau →" : "Explore components →")</CyButton>
                <CyButton Href="getting-started" Variant="ComponentColour.Tertiary" Class="cb-demo-btn cb-demo-btn--secondary">@(Strings.Language == AppLanguage.Welsh ? "Dechrau arni" : "Get started")</CyButton>
            </div>

            <CyCluster Gap="ComponentSize.Small" JustifyContent="JustifyContent.Center" Class="cb-home__tech-badges">
                <span class="cb-badge">.NET 10</span>
                <span class="cb-badge">C#</span>
                <span class="cb-badge">Blazor WASM</span>
                <span class="cb-badge">WCAG 2.2 AA</span>
                <span class="cb-badge">@(Strings.Language == AppLanguage.Welsh ? "Trwydded MIT" : "MIT License")</span>
            </CyCluster>
        </div>
    </section>

    <section class="cb-home__features">
        @foreach (var feature in Features)
        {
            <div class="cb-home__feature">
                <div class="cb-home__feature-icon" style="background: @feature.IconBackground;">
                    <CyIcon Name="@feature.Icon" Size="22" />
                </div>
                <h2 class="cb-home__feature-title">@feature.Title</h2>
                <p class="cb-home__feature-body">@feature.Description</p>
            </div>
        }
    </section>

    <section class="cb-home__quick-start">
        <h2 class="cb-home__section-title">@(Strings.Language == AppLanguage.Welsh ? "Dechrau cyflym" : "Quick start")</h2>
        <DemoQuickStart Steps="QuickStartSteps" />
    </section>

</div>

@code {
    protected override void OnInitialized() => Strings.Changed += HandleStringsChanged;
    private void HandleStringsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Strings.Changed -= HandleStringsChanged;
}

