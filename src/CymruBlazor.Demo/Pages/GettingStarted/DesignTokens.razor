@page "/foundations/tokens"
@page "/design-tokens"
@namespace CymruBlazor.Demo.Pages.GettingStarted
@implements IDisposable
@inject CymruBlazor.Demo.Localisation.AppStrings Strings
@using CymruBlazor.Enums

<div class="cb-page-header">
    <h1 class="cb-page-title">@(Strings.Language == AppLanguage.Welsh ? "Tocynnau Dylunio" : "Design Tokens")</h1>
    <p class="cb-page-description">
        @(Strings.Language == AppLanguage.Welsh
            ? "Tocynnau dylunio CymruBlazor, wedi'u tarddu o ffeil Figma \"System Dylunio Cofnod Sengl\" DHCW. Mae cydrannau'n defnyddio'r priodweddau personol CSS hyn yn uniongyrchol - dim cam adeiladu na Sass yn ofynnol."
            : "CymruBlazor's design tokens, sourced from the DHCW \"Single Record Design System\" Figma file. Components consume these CSS custom properties directly - no build step or Sass required.")
    </p>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">@(Strings.Language == AppLanguage.Welsh ? "Lliw" : "Colour")</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem;">
        @foreach (var swatch in Colours)
        {
            <div>
                <div style="height: 3rem; border-radius: 6px; border: 1px solid rgba(0,0,0,0.08); background: @swatch.Hex;"></div>
                <code style="font-size: 0.75rem; display:block; margin-top:0.35rem;">@swatch.Token</code>
                <span style="font-size: 0.75rem; color: var(--docs-text-muted);">@swatch.Hex · @swatch.Usage</span>
            </div>
        }
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">@(Strings.Language == AppLanguage.Welsh ? "Bylchiad" : "Spacing")</h2>
    <p class="cb-section-description">
        @if (Strings.Language == AppLanguage.Welsh)
        {
            @:Graddfa uned-sail 4px. Mae enw'r tocyn yn amgodio'r lluosydd: <code>--cymru-space-6</code> = 6 &times; 4px = 24px.
        }
        else
        {
            @:A 4px base-unit scale. The token name encodes the multiplier: <code>--cymru-space-6</code> = 6 &times; 4px = 24px.
        }
    </p>
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        @foreach (var space in _spacing)
        {
            <div style="display: flex; align-items: center; gap: 1rem;">
                <code style="width: 11rem; font-size: 0.8rem; flex-shrink:0;">@space.Token</code>
                <div style="height: 1rem; background: var(--cymru-color-primary, #325083); width: @(space.Px)px;"></div>
                <span style="font-size: 0.8rem; color: var(--docs-text-muted);">@(space.Px)px</span>
            </div>
        }
    </div>
</div>

<div class="cb-section">
    <h2 class="cb-section-title">@(Strings.Language == AppLanguage.Welsh ? "Teipograffeg" : "Typography")</h2>
    <p class="cb-section-description">@(Strings.Language == AppLanguage.Welsh ? "Teulu ffont: Roboto (mae Frutiger wedi'i eithrio ar gynhyrchion Cofnod Sengl am resymau trwyddedu)." : "Font family: Roboto (Frutiger is excluded on Single Record products for licensing reasons).")</p>
    <table class="cb-api-table" aria-label="@(Strings.Language == AppLanguage.Welsh ? "Graddfa deipograffeg" : "Typography scale")">
        <thead>
            @if (Strings.Language == AppLanguage.Welsh)
            {
                <tr><th>TypographyVariant</th><th>Maint bwrdd gwaith (&ge;768px)</th><th>Maint symudol (&lt;768px)</th><th>Tag rhagosodedig</th></tr>
            }
            else
            {
                <tr><th>TypographyVariant</th><th>Desktop size (&ge;768px)</th><th>Mobile size (&lt;768px)</th><th>Default tag</th></tr>
            }
        </thead>
        <tbody>
            <tr><td class="cb-api-table__name">H1</td><td>48px (3rem)</td><td>32px (2rem)</td><td>h1</td></tr>
            <tr><td class="cb-api-table__name">H2</td><td>36px (2.25rem)</td><td>27px (1.6875rem)</td><td>h2</td></tr>
            <tr><td class="cb-api-table__name">H3</td><td>26px (1.625rem)</td><td>22px (1.375rem)</td><td>h3</td></tr>
            <tr><td class="cb-api-table__name">H4</td><td>22px (1.375rem)</td><td>19px (1.1875rem)</td><td>h4</td></tr>
            <tr><td class="cb-api-table__name">H5 / H6</td><td>16px (1rem)</td><td>16px (1rem)</td><td>h5 / h6</td></tr>
            <tr><td class="cb-api-table__name">BodyLarge</td><td>19px (1.1875rem)</td><td>19px (1.1875rem)</td><td>p</td></tr>
            <tr><td class="cb-api-table__name">Body</td><td>16px (1rem)</td><td>16px (1rem)</td><td>p</td></tr>
            <tr><td class="cb-api-table__name">BodySmall</td><td>14px (0.875rem)</td><td>14px (0.875rem)</td><td>p</td></tr>
            <tr><td class="cb-api-table__name">Label</td><td>14px (0.875rem)</td><td>14px (0.875rem)</td><td>span</td></tr>
            <tr><td class="cb-api-table__name">Caption</td><td>12px (0.75rem)</td><td>12px (0.75rem)</td><td>span</td></tr>
        </tbody>
    </table>
    <p style="font-size: 0.85rem; color: var(--docs-text-muted); margin-top: 0.5rem;">
        @if (Strings.Language == AppLanguage.Welsh)
        {
            @:Gweler <a href="foundations/typography">Teipograffeg</a> am enghreifftiau byw drwy <code>CyTypography</code>.
        }
        else
        {
            @:See <a href="foundations/typography">Typography</a> for live examples via <code>CyTypography</code>.
        }
    </p>
</div>

@code {
    private sealed record ColourSwatch(string Token, string Hex, string Usage);
    private sealed record SpacingStep(string Token, int Px);

    protected override void OnInitialized() => Strings.Changed += HandleStringsChanged;
    private void HandleStringsChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Strings.Changed -= HandleStringsChanged;

    private readonly IReadOnlyList<ColourSwatch> _englishColours =
    [
        new("--cymru-color-primary", "#325083", "Brand primary"),
        new("--cymru-color-primary-hover", "#1e3050", "Primary hover state"),
        new("--cymru-color-secondary", "#1b294a", "Secondary / navy"),
        new("--cymru-color-danger", "#d5281b", "Critical / error"),
        new("--cymru-cyan-700", "#12a3c9", "Brand secondary accent"),
        new("--cymru-color-text", "#212b32", "Primary text"),
        new("--cymru-color-text-muted", "#4c6272", "Secondary text"),
        new("--cymru-color-border", "#d8dde0", "Default border"),
        new("--cymru-color-surface", "#ffffff", "Default surface"),
        new("--cymru-color-surface-alt", "#f4f5f8", "Alternate surface / wash")
    ];

    /// <summary>Illustrative Welsh; not translator-reviewed - see the v1.6.0 CHANGELOG entry.</summary>
    private readonly IReadOnlyList<ColourSwatch> _welshColours =
    [
        new("--cymru-color-primary", "#325083", "Prif liw'r brand"),
        new("--cymru-color-primary-hover", "#1e3050", "Cyflwr hofran y prif liw"),
        new("--cymru-color-secondary", "#1b294a", "Eilaidd / nefi"),
        new("--cymru-color-danger", "#d5281b", "Critigol / gwall"),
        new("--cymru-cyan-700", "#12a3c9", "Acen eilaidd y brand"),
        new("--cymru-color-text", "#212b32", "Prif destun"),
        new("--cymru-color-text-muted", "#4c6272", "Testun eilaidd"),
        new("--cymru-color-border", "#d8dde0", "Ymyl rhagosodedig"),
        new("--cymru-color-surface", "#ffffff", "Wyneb rhagosodedig"),
        new("--cymru-color-surface-alt", "#f4f5f8", "Wyneb amgen / golch")
    ];

    private IReadOnlyList<ColourSwatch> Colours => Strings.Language == AppLanguage.Welsh ? _welshColours : _englishColours;

    private readonly IReadOnlyList<SpacingStep> _spacing =
    [
        new("--cymru-space-1", 4),
        new("--cymru-space-2", 8),
        new("--cymru-space-4", 16),
        new("--cymru-space-6", 24),
        new("--cymru-space-8", 32),
        new("--cymru-space-12", 48),
        new("--cymru-space-16", 64)
    ];
}

