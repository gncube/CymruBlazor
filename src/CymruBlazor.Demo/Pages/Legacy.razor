@page "/legacy"
@using CymruBlazor.Components.Layout
@using CymruBlazor.Enums

<div class="demo-legacy-container">
    <h1>Legacy Page</h1>
    <p>Demonstrating CySidebar using modern State parameters.</p>

    <div style="display: flex; height: 300px; border: 1px solid var(--cy-color-border, #e2e8f0);">
        <CySidebar aria-label="Legacy sidebar" @bind-State="_state">
            <Brand>
                <div style="padding: 0.5rem; font-weight: bold;">Demo</div>
            </Brand>
            <ChildContent>
                <nav style="padding: 0.5rem;">
                    <a href="/legacy" class="cy-sidebar__item">Legacy Item</a>
                </nav>
            </ChildContent>
        </CySidebar>
        <div style="flex: 1; padding: 1rem;">
            <div>Current Sidebar State: <strong>@_state</strong></div>
        </div>
    </div>
</div>

@code {
    private SidebarState _state = SidebarState.Expanded;
}
