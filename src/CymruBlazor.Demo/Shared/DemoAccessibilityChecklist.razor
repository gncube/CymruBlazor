@namespace CymruBlazor.Demo.SharedComponents

<div class="cb-a11y-list">
    @foreach (var item in Items)
    {
        <div class="cb-a11y-item">
            <span class="cb-a11y-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </span>
            <div class="cb-a11y-content">
                <strong class="cb-a11y-title">@item.Criterion</strong>
                <p class="cb-a11y-desc">@item.Description</p>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<AccessibilityCriterion> Items { get; set; }

    public sealed record AccessibilityCriterion(string Criterion, string Description);
}
