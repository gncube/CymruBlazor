@namespace CymruBlazor.Demo.SharedComponents
@using CymruBlazor.Components.Layout
@using CymruBlazor.Components.Content

<CyPageHeader Title="@Title" Subtitle="@Subtitle">
    <Breadcrumb>
        <CyBreadcrumb>
            @if (!string.IsNullOrEmpty(Category))
            {
                <CyBreadcrumbItem Text="@Category" Href="@CategoryHref" />
            }
            <CyBreadcrumbItem Text="@Title" />
        </CyBreadcrumb>
    </Breadcrumb>
</CyPageHeader>

<div class="cb-tabs" role="tablist" aria-label="Component Documentation Tabs">
    <button type="button" role="tab" id="tab-examples" aria-selected="@(_activeTab == Tab.Examples ? "true" : "false")" aria-controls="panel-examples" class="cb-tab-btn @(_activeTab == Tab.Examples ? "active" : "")" @onclick="() => _activeTab = Tab.Examples">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.4rem; vertical-align:-2px;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        Examples
    </button>
    @if (ApiDocs is not null && ApiDocs.Count > 0)
    {
        <button type="button" role="tab" id="tab-api" aria-selected="@(_activeTab == Tab.Api ? "true" : "false")" aria-controls="panel-api" class="cb-tab-btn @(_activeTab == Tab.Api ? "active" : "")" @onclick="() => _activeTab = Tab.Api">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.4rem; vertical-align:-2px;"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            API Reference
        </button>
    }
    @if (A11yDocs is not null && A11yDocs.Count > 0)
    {
        <button type="button" role="tab" id="tab-accessibility" aria-selected="@(_activeTab == Tab.Accessibility ? "true" : "false")" aria-controls="panel-accessibility" class="cb-tab-btn @(_activeTab == Tab.Accessibility ? "active" : "")" @onclick="() => _activeTab = Tab.Accessibility">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.4rem; vertical-align:-2px;"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            Accessibility
        </button>
    }
</div>

@if (_activeTab == Tab.Examples)
{
    <div role="tabpanel" id="panel-examples" aria-labelledby="tab-examples" tabindex="0">
        @if (Preview is not null)
        {
            <div class="cb-workbench">
                <div class="cb-workbench-header">
                    <span class="cb-workbench-header__title">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:0.35rem; vertical-align:-1px;"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        Interactive Workbench
                    </span>
                    <span class="cb-workbench-header__badge">Live Preview</span>
                </div>
                <div class="cb-workbench-preview">
                    @Preview
                </div>
            </div>

            @if (Controls is not null || !string.IsNullOrEmpty(GeneratedCode))
            {
                <div class="cb-playground-grid">
                    @if (Controls is not null)
                    {
                        <DemoPropertyControls>
                            @Controls
                        </DemoPropertyControls>
                    }

                    @if (!string.IsNullOrEmpty(GeneratedCode))
                    {
                        <div class="cb-playground-code-panel">
                            <span class="cb-panel-caption">Generated Razor Code</span>
                            <CyCodeBlock Code="@GeneratedCode" Language="razor" />
                            @if (!string.IsNullOrEmpty(GitHubUrl))
                            {
                                <a class="cb-open-in-github" href="@GitHubUrl" target="_blank" rel="noopener noreferrer">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 0.35rem; vertical-align: -2px;">
                                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                                    </svg>
                                    View Source on GitHub<span class="u-sr-only"> (opens in new tab)</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        }

        @if (ExtraExamples is not null)
        {
            <div class="cb-extra-examples">
                @ExtraExamples
            </div>
        }

        @ChildContent
    </div>
}
else if (_activeTab == Tab.Api && ApiDocs is not null)
{
    <div role="tabpanel" id="panel-api" aria-labelledby="tab-api" tabindex="0">
        <DemoApiTable Parameters="@ApiDocs" />
    </div>
}
else if (_activeTab == Tab.Accessibility && A11yDocs is not null)
{
    <div role="tabpanel" id="panel-accessibility" aria-labelledby="tab-accessibility" tabindex="0">
        <DemoAccessibilityChecklist Items="@A11yDocs" />
    </div>
}

<DemoPageNav />

@code {
    private enum Tab { Examples, Api, Accessibility }
    private Tab _activeTab = Tab.Examples;

    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string CategoryHref { get; set; } = string.Empty;

    [Parameter]
    public string? GitHubUrl { get; set; }

    [Parameter]
    public RenderFragment? Preview { get; set; }

    [Parameter]
    public RenderFragment? Controls { get; set; }

    [Parameter]
    public string? GeneratedCode { get; set; }

    [Parameter]
    public IReadOnlyList<DemoApiTable.ApiParameterDoc>? ApiDocs { get; set; }

    [Parameter]
    public IReadOnlyList<DemoAccessibilityChecklist.AccessibilityCriterion>? A11yDocs { get; set; }

    [Parameter]
    public RenderFragment? ExtraExamples { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
