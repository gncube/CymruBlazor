@namespace CymruBlazor.Demo.SharedComponents

<table class="cb-api-table">
    <thead>
        <tr>
            <th>Parameter</th>
            <th>Type</th>
            <th>Default</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Parameters)
        {
            <tr>
                <td class="cb-api-table__name">@row.Name</td>
                <td class="cb-api-table__type"><code>@row.Type</code></td>
                <td class="cb-api-table__default">
                    @if (!string.IsNullOrEmpty(row.DefaultValue) && row.DefaultValue != "-")
                    {
                        <code>@row.DefaultValue</code>
                    }
                    else
                    {
                        <span class="cb-api-table__empty">-</span>
                    }
                </td>
                <td class="cb-api-table__desc">@row.Description</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<ApiParameterDoc> Parameters { get; set; }

    public sealed record ApiParameterDoc(string Name, string Type, string? DefaultValue, string Description);
}
