@namespace CymruBlazor.Demo.Layout
@implements IDisposable
@inject CymruBlazor.Demo.Localisation.AppStrings Strings

<aside class="cb-shell-toc">
    <div class="cb-toc-sticky">
        <h2 class="cb-toc-title">@Strings.Nav.OnThisPage</h2>
        <nav aria-label="@Strings.Nav.TableOfContents">
            <ul class="cb-toc-list">
                <li><a href="#examples">@Strings.Nav.Examples</a></li>
                <li><a href="#api">@Strings.Nav.ApiReference</a></li>
                <li><a href="#accessibility">@Strings.Nav.Accessibility</a></li>
            </ul>
        </nav>
    </div>
</aside>

@code {
    protected override void OnInitialized()
    {
        Strings.Changed += HandleStringsChanged;
    }

    private void HandleStringsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Strings.Changed -= HandleStringsChanged;
    }
}
