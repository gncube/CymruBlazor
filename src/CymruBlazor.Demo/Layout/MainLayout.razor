@inherits LayoutComponentBase

<CyContainer Size="ContainerSize.Fluid" RemovePadding="true">

    <header>

        <DemoHeader />

    </header>

    <CyStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Stretch" Gap="ComponentSize.Medium"
             Class="cy-stack--collapse-tablet">

        <CySidebar Width="SidebarWidth.Medium" aria-label="Documentation navigation">

            <DemoSidebar />

        </CySidebar>

        <main id="main-content" class="cb-demo-main" tabindex="-1">

            @Body

        </main>

    </CyStack>

    <footer>

        <DemoFooter />

    </footer>

    <CyLiveRegion />

</CyContainer>
