@namespace CymruBlazor.Demo.Layout

<div class="cb-footer">
    <div class="cb-footer__inner">

        <div class="cb-footer__brand">
            <span class="cb-footer__name">CymruBlazor</span>
            <span class="cb-footer__tagline">
                NHS Wales Design System for Blazor
            </span>
        </div>

        <nav class="cb-footer__nav" aria-label="Footer">
            <ul class="cb-footer__nav-list" role="list">
                <li>
                    <a href="https://github.com/gncube/CymruBlazor"
                       class="cb-footer__link"
                       target="_blank"
                       rel="noopener noreferrer">
                        GitHub
                        <span class="sr-only">(opens in new tab)</span>
                    </a>
                </li>
                <li>
                    <a href="/getting-started" class="cb-footer__link">
                        Docs
                    </a>
                </li>
                <li>
                    <a href="https://github.com/gncube/CymruBlazor/blob/main/LICENSE"
                       class="cb-footer__link"
                       target="_blank"
                       rel="noopener noreferrer">
                        MIT Licence
                        <span class="sr-only">(opens in new tab)</span>
                    </a>
                </li>
            </ul>
        </nav>

        <p class="cb-footer__copy">
            &copy; @DateTime.UtcNow.Year CymruBlazor Contributors
        </p>

    </div>
</div>
