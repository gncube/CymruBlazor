@namespace CymruBlazor.Demo.Layout
@implements IDisposable
@using CymruBlazor.Components.Branding
@using CymruBlazor.Enums
@using CymruBlazor.Themes
@inject IThemeService ThemeService
@inject CymruBlazor.Demo.Localisation.AppStrings Strings

<CyHeader Class="cb-shell-header" Sticky="true">
    <Brand>
        <button type="button"
                class="cb-shell-header__hamburger"
                aria-label="@(MobileMenuOpen ? Strings.Nav.CloseNavigationMenu : Strings.Nav.OpenNavigationMenu)"
                aria-expanded="@(MobileMenuOpen ? "true" : "false")"
                aria-controls="cb-mobile-sidebar"
                @onclick="OnToggleMobileMenu">
            <span aria-hidden="true">@(MobileMenuOpen ? "✕" : "☰")</span>
        </button>

        <div class="cb-shell-header__brand-group">
            <CyBrandLogo Size="ComponentSize.Small" Href="/" />
            <span class="cb-version-badge">v1.0</span>
        </div>
    </Brand>

    <ChildContent>
        <nav class="cb-shell-header__nav" aria-label="@Strings.Nav.PrimaryNavigation">
            <NavLink href="layouts/stack">@Strings.Nav.Components</NavLink>
            <NavLink href="getting-started">@Strings.Nav.Docs</NavLink>
            <a href="https://github.com/gncube/CymruBlazor" target="_blank" rel="noopener noreferrer">
                GitHub<span class="u-sr-only"> (opens in new tab)</span>
            </a>
            <a href="https://www.nuget.org/packages/CymruBlazor" target="_blank" rel="noopener noreferrer">
                NuGet<span class="u-sr-only"> (opens in new tab)</span>
            </a>
        </nav>
    </ChildContent>

    <Actions>
        <div class="cb-shell-header__actions">
            <button type="button" class="cb-shell-header__search-trigger" aria-label="@Strings.Nav.SearchAriaLabel" title="@Strings.Nav.SearchTitle" @onclick="OnOpenSearch">
                <CyIcon Name="search" Size="16" />
                <span class="search-text">@Strings.Nav.Search</span>
                <kbd class="search-kbd">Ctrl+K</kbd>
            </button>
            <CyLanguageToggle CurrentLanguage="Strings.Language" CurrentLanguageChanged="HandleLanguageChanged" />
            <button type="button"
                    class="cb-shell-header__icon-btn"
                    aria-label="@(ThemeService.CurrentTheme.Mode == ThemeMode.Dark ? Strings.Nav.SwitchToLightMode : Strings.Nav.SwitchToDarkMode)"
                    title="@Strings.Nav.ToggleDarkMode"
                    @onclick="async () => await ThemeService.ToggleDarkModeAsync()">
                <CyIcon Name="@(ThemeService.CurrentTheme.Mode == ThemeMode.Dark ? "sun" : "moon")" Size="18" />
            </button>
        </div>
    </Actions>
</CyHeader>

@code {
    /// <summary>Whether the mobile off-canvas sidebar is currently open.</summary>
    [Parameter]
    public bool MobileMenuOpen { get; set; }

    /// <summary>Raised when the hamburger button is activated.</summary>
    [Parameter]
    public EventCallback OnToggleMobileMenu { get; set; }

    /// <summary>Raised when the search button is activated.</summary>
    [Parameter]
    public EventCallback OnOpenSearch { get; set; }

    protected override void OnInitialized()
    {
        // The theme can change from elsewhere entirely (e.g. the Theme
        // Provider playground's own buttons) - DemoHeader is a separate
        // component instance living in MainLayout, so it needs its own
        // subscription to stay in sync rather than relying on this
        // click handler's own automatic re-render.
        ThemeService.ThemeChanged += HandleThemeChanged;
        Strings.Changed += HandleStringsChanged;
    }

    private void HandleThemeChanged(object? sender, ThemeChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleStringsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleLanguageChanged(AppLanguage newLanguage)
    {
        Strings.SetLanguage(newLanguage);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
        Strings.Changed -= HandleStringsChanged;
    }
}
