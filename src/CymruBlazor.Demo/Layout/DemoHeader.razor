@namespace CymruBlazor.Demo.Layout

<a class="cb-skip-link cymru-skip-link" href="#main-content">
    Skip to main content
</a>

<div class="cb-header">
    <div class="cb-header__inner">

        <a class="cb-header__logo" href="/" aria-label="CymruBlazor home">
            <svg class="cb-header__logo-mark"
                 width="32" height="32" viewBox="0 0 32 32"
                 aria-hidden="true" focusable="false"
                 xmlns="http://www.w3.org/2000/svg">
                <rect width="32" height="32" rx="6" fill="currentColor" />
                <text x="16" y="22" text-anchor="middle"
                      font-family="Segoe UI, Arial, sans-serif"
                      font-size="14" font-weight="700"
                      fill="white">Cy</text>
            </svg>
            <span class="cb-header__logo-text">CymruBlazor</span>
        </a>

        <nav class="cb-header__nav" aria-label="Primary">
            <ul class="cb-header__nav-list" role="list">
                <li>
                    <NavLink href="/components"
                             class="cb-header__nav-link"
                             ActiveClass="cb-header__nav-link--active">
                        Components
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/layouts"
                             class="cb-header__nav-link"
                             ActiveClass="cb-header__nav-link--active">
                        Layouts
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/design-tokens"
                             class="cb-header__nav-link"
                             ActiveClass="cb-header__nav-link--active">
                        Tokens
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/getting-started"
                             class="cb-header__nav-link"
                             ActiveClass="cb-header__nav-link--active">
                        Docs
                    </NavLink>
                </li>
            </ul>
        </nav>

        <div class="cb-header__actions">
            <a href="https://github.com/gncube/CymruBlazor"
               class="cb-header__github-link"
               target="_blank"
               rel="noopener noreferrer"
