    <details class="cb-nav-group" open>
        <summary>Forms</summary>
        <NavLink class="cb-nav-item" href="forms/button">Button</NavLink>
        <NavLink class="cb-nav-item" href="forms/textbox">TextBox</NavLink>
        <NavLink class="cb-nav-item" href="forms/select">Select</NavLink>
        <NavLink class="cb-nav-item" href="forms/checkbox">Checkbox</NavLink>
        <NavLink class="cb-nav-item" href="forms/validation-summary">Validation Summary</NavLink>
    </details>

    <details class="cb-nav-group">
        <summary>Content</summary>
        <NavLink class="cb-nav-item" href="content/alert">Alert</NavLink>
        <NavLink class="cb-nav-item" href="content/card">Card</NavLink>
        <NavLink class="cb-nav-item" href="content/icons">Icon</NavLink>
    </details>

    <details class="cb-nav-group">
        <summary>Branding</summary>
        <NavLink class="cb-nav-item" href="branding/brand-logo">Brand Logo</NavLink>
        <NavLink class="cb-nav-item" href="branding/language-toggle">Language Toggle</NavLink>
