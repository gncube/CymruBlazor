        </summary>
        <NavLink class="cb-nav-item" href="getting-started" Match="NavLinkMatch.All">@Strings.Nav.Overview</NavLink>
        <NavLink class="cb-nav-item" href="installation">Installation</NavLink>
    </details>

    <details class="cb-nav-group" open>
        <summary>
            <span class="cb-nav-group__title">@Strings.Nav.Foundations</span>
