    <details class="cb-nav-group" open>
        <summary>Layout</summary>
        <NavLink class="cb-nav-item" href="layouts/container">Container</NavLink>
        <NavLink class="cb-nav-item" href="layouts/stack">Stack</NavLink>
        <NavLink class="cb-nav-item" href="layouts/grid">Grid</NavLink>
        <NavLink class="cb-nav-item" href="layouts/cluster">Cluster</NavLink>
        <NavLink class="cb-nav-item" href="layouts/sidebar">Sidebar</NavLink>
        <NavLink class="cb-nav-item" href="layouts/center">Center</NavLink>
