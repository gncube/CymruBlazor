        <NavLink class="cb-nav-item" href="navigation/breadcrumb">Breadcrumb</NavLink>
        <NavLink class="cb-nav-item" href="navigation/header">Header</NavLink>
        <NavLink class="cb-nav-item" href="navigation/navigation">Navigation</NavLink>
        <NavLink class="cb-nav-item" href="navigation/page-header">Page Header</NavLink>
        <NavLink class="cb-nav-item" href="navigation/skip-link">Skip Link</NavLink>
        <NavLink class="cb-nav-item" href="navigation/footer">Footer</NavLink>
    </details>

    <details class="cb-nav-group">
        <summary>Accessibility</summary>
        <NavLink class="cb-nav-item" href="accessibility/focus-trap">Focus Trap</NavLink>
        <NavLink class="cb-nav-item" href="accessibility/live-region">Live Region</NavLink>
        <NavLink class="cb-nav-item" href="accessibility/screen-reader-only">Screen Reader Only</NavLink>
    </details>
</aside>

@code {
    /// <summary>Whether the sidebar is currently visible as a mobile off-canvas drawer.
    /// Has no effect at desktop widths, where the sidebar is always visible.</summary>
    [Parameter]
    public bool IsOpen { get; set; }
}
