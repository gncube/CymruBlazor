    <details class="cb-nav-group">
        <summary>
            <span class="cb-nav-group__title">@Strings.Nav.Data</span>
            <CyIcon Name="chevron-right" Class="cb-nav-group__chevron" Size="14" />
        </summary>
        <NavLink class="cb-nav-item" href="data/table">Table</NavLink>
        <NavLink class="cb-nav-item" href="data/pagination">Pagination</NavLink>
