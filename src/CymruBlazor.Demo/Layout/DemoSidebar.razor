@namespace CymruBlazor.Demo.Layout

<aside id="cb-mobile-sidebar" class="cb-shell-sidebar @(IsOpen ? "cb-shell-sidebar--open" : "")" aria-label="Documentation navigation">
    <details class="cb-nav-group" open>
        <summary>Getting Started</summary>
        <NavLink class="cb-nav-item" href="getting-started" Match="NavLinkMatch.All">Overview</NavLink>
        <NavLink class="cb-nav-item" href="installation">Installation</NavLink>
        <NavLink class="cb-nav-item" href="design-tokens">Design Tokens</NavLink>
    </details>

    <details class="cb-nav-group" open>
        <summary>Foundations</summary>
        <NavLink class="cb-nav-item" href="foundations/theme-provider">Theme Provider</NavLink>
        <NavLink class="cb-nav-item" href="foundations/typography">Typography</NavLink>
        <NavLink class="cb-nav-item" href="accessibility/focus-trap">Focus Trap</NavLink>
