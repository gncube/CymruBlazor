            <span class="cb-nav-group__title">@Strings.Nav.Accessibility</span>
            <CyIcon Name="chevron-right" Class="cb-nav-group__chevron" Size="14" />
        </summary>
        <NavLink class="cb-nav-item" href="accessibility" Match="NavLinkMatch.All">@Strings.Nav.Overview</NavLink>
        <NavLink class="cb-nav-item" href="accessibility/live-region">Live Region</NavLink>
        <NavLink class="cb-nav-item" href="accessibility/screen-reader-only">Screen Reader Only</NavLink>
    </details>
</aside>

@code {
    /// <summary>Whether the sidebar is currently visible as a mobile off-canvas drawer.
    /// Has no effect at desktop widths, where the sidebar is always visible.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    protected override void OnInitialized()
    {
        Strings.Changed += HandleStringsChanged;
    }

    private void HandleStringsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Strings.Changed -= HandleStringsChanged;
    }
}
