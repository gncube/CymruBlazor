@namespace CymruBlazor.Icons

<!-- Implementation detail: raw SVG icon path renderer. Consumers should use CymruBlazor.Components.Content.CyIcon instead. -->
<svg class="cy-icon @CssClass"
     width="@Size" height="@Size"
     viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round"
     role="@(string.IsNullOrEmpty(Title) ? "presentation" : "img")"
     aria-hidden="@(string.IsNullOrEmpty(Title) ? "true" : null)">
    @if (!string.IsNullOrEmpty(Title))
    {
        <title>@Title</title>
    }
    @GetPath(Name)
</svg>

@code {
    /// <summary>Which glyph to render.</summary>
    [Parameter, EditorRequired]
    public CyIconName Name { get; set; }

    /// <summary>Width/height in pixels. Defaults to 20 (matches CymruBlazor's default icon-in-text sizing).</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    /// <summary>
    /// Accessible name. Leave empty (the default) for a purely decorative icon —
    /// CymruBlazor then marks it <c>aria-hidden</c> so screen readers skip it, per
    /// PROMPT.md §8 ("ensure icons have appropriate accessible treatment").
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Additional CSS classes, e.g. colour utility classes.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    private static RenderFragment GetPath(CyIconName name) => builder =>
    {
        var i = 0;

        void Path(string d)
        {
            builder.OpenElement(i++, "path");
            builder.AddAttribute(i++, "d", d);
            builder.CloseElement();
        }

        void Circle(string cx, string cy, string r)
        {
            builder.OpenElement(i++, "circle");
            builder.AddAttribute(i++, "cx", cx);
            builder.AddAttribute(i++, "cy", cy);
            builder.AddAttribute(i++, "r", r);
            builder.CloseElement();
        }

        void Line(string x1, string y1, string x2, string y2)
        {
            builder.OpenElement(i++, "line");
            builder.AddAttribute(i++, "x1", x1);
            builder.AddAttribute(i++, "y1", y1);
            builder.AddAttribute(i++, "x2", x2);
            builder.AddAttribute(i++, "y2", y2);
            builder.CloseElement();
        }

        switch (name)
        {
            case CyIconName.ChevronDown:
                Path("M6 9l6 6 6-6");
                break;
            case CyIconName.Info:
                Circle("12", "12", "9");
                Line("12", "11", "12", "16");
                Circle("12", "8", "0.5");
                break;
            case CyIconName.ArrowRight:
                Line("5", "12", "19", "12");
                Path("M13 6l6 6-6 6");
                break;
            case CyIconName.Stethoscope:
                Path("M6 4v6a4 4 0 0 0 8 0V4");
                Path("M10 20a4 4 0 0 0 4-4v-3");
                Circle("18", "17", "3");
                Line("6", "4", "4.5", "4");
                Line("14", "4", "15.5", "4");
                break;
            case CyIconName.ArrowUpDown:
                Path("M8 3v18");
                Path("M4 7l4-4 4 4");
                Path("M16 21V3");
                Path("M12 17l4 4 4-4");
                break;
            case CyIconName.Watchlist:
                Path("M4 5h16");
                Path("M4 12h10");
                Path("M4 19h7");
                Circle("19", "16", "3");
                break;
            case CyIconName.Bed:
                Path("M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7");
                Path("M3 13v-3");
                Path("M21 13v-3");
                Path("M3 21v-3");
                Path("M21 21v-3");
                Circle("7", "9", "1.5");
                break;
            case CyIconName.UserPlus:
                Circle("9", "8", "4");
                Path("M2 21a7 7 0 0 1 14 0");
                Line("19", "8", "19", "14");
                Line("16", "11", "22", "11");
                break;
            case CyIconName.FileText:
                Path("M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z");
                Path("M14 3v6h6");
                Line("8", "13", "16", "13");
                Line("8", "17", "16", "17");
                break;
            case CyIconName.Plus:
                Line("12", "5", "12", "19");
                Line("5", "12", "19", "12");
                break;
            case CyIconName.Activity:
                Path("M22 12h-4l-3 9L9 3l-3 9H2");
                break;
            case CyIconName.Sun:
                Circle("12", "12", "4");
                Path("M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4");
                break;
            case CyIconName.Moon:
                Path("M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z");
                break;
            case CyIconName.Menu:
                Line("3", "6", "21", "6");
                Line("3", "12", "21", "12");
                Line("3", "18", "21", "18");
                break;
            case CyIconName.Close:
                Line("6", "6", "18", "18");
                Line("6", "18", "18", "6");
                break;
        }
    };
}
