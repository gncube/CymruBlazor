@namespace CymruBlazor.Components.Feedback
@using CymruBlazor.Components.Content
@implements IDisposable
@inject IToastService ToastService

<div class="cy-toast-container"
     role="region"
     aria-label="Notifications"
     aria-live="polite"
     aria-atomic="false">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="cy-toast cy-toast--@toast.Variant.ToString().ToLowerInvariant()"
             role="@GetAriaRole(toast.Variant)">
            <CyIcon Name="@GetIconName(toast.Variant)" Size="18" Class="cy-toast__icon" />
            <div class="cy-toast__content">
                <span class="cy-toast__message">@toast.Message</span>
            </div>
            <button type="button" class="cy-toast__close" aria-label="Close notification"
                    @onclick="() => ToastService.Remove(toast.Id)">
                <CyIcon Name="close" Size="14" />
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += OnToastsChanged;
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private static string GetIconName(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => "check",
        ToastVariant.Warning => "warning",
        ToastVariant.Danger => "alert",
        _ => "info"
    };

    private static string GetAriaRole(ToastVariant variant) => variant switch
    {
        ToastVariant.Warning or ToastVariant.Danger => "alert",
        _ => "status"
    };

    public void Dispose()
    {
        ToastService.OnChange -= OnToastsChanged;
    }
}
