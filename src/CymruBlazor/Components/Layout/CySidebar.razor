@inherits CyLayoutComponentBase
@using CymruBlazor.Components.Content
@using CymruBlazor.Enums

@if (MobileOpen && ShowMobileBackdrop)
{
    <div class="cy-sidebar__backdrop" @onclick="CloseMobileDrawerAsync" aria-hidden="true"></div>
}

<aside id="@Id" class="@CssClass" style="@CssStyle" data-collapse-mode="@CollapseModeAttribute"
       @attributes="AdditionalAttributes">

    @if (State == SidebarState.Hidden && !MobileOpen)
    {
        <button type="button" class="cy-sidebar__reveal-handle" @onclick="ExpandAsync" aria-label="Reveal sidebar">
            <CyIcon Name="@RevealIconName" Size="16" />
        </button>
    }

    @if (ShowHeader)
    {
        <div class="cy-sidebar__header" aria-hidden="@(State == SidebarState.Hidden && !MobileOpen ? "true" : null)"
             tabindex="@(State == SidebarState.Hidden && !MobileOpen ? "-1" : null)">

            @if (Brand is not null)
            {
                <div class="cy-sidebar__brand">
                    @Brand
                </div>
            }

            @if (MobileOpen)
            {
                <button type="button" class="cy-sidebar__close" @onclick="CloseMobileDrawerAsync" aria-label="Close sidebar">
                    <CyIcon Name="x" Size="16" />
                </button>
            }
            else if (CollapseMode != SidebarCollapseMode.NonCollapsible)
            {
                <button type="button" class="cy-sidebar__toggle"
                        @onclick="() => (States.Count > 1 ? CycleNextAsync() : ToggleAsync())"
                        aria-expanded="@(!EffectiveCollapsed)"
                        aria-label="@(EffectiveCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                        tabindex="@(State == SidebarState.Hidden ? "-1" : null)">
                    <CyIcon Name="@ToggleIconName" Size="16" />
                </button>
            }

        </div>
    }

    @ChildContent

</aside>
