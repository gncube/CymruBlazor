@inherits CyLayoutComponentBase
@using CymruBlazor.Components.Content
@using CymruBlazor.Enums

@if (MobileOpen && ShowMobileBackdrop)
{
    <div class="cy-sidebar__backdrop" @onclick="CloseMobileDrawerAsync" aria-hidden="true"></div>
}

<aside id="@Id" class="@CssClass" style="@CssStyle" data-collapse-mode="@CollapseModeAttribute"
       tabindex="@(MobileOpen ? "-1" : null)"
       @onkeydown="HandleKeyDownAsync"
       @attributes="AdditionalAttributes">

    @if (State == SidebarState.Hidden && !MobileOpen)
    {
        <button type="button" class="cy-sidebar__reveal-handle" @onclick="ExpandAsync" aria-label="@(RevealLabel ?? "Reveal sidebar")">
            <CyIcon Name="@RevealIconName" Size="16" />
        </button>
    }

    @if (ShowHeader)
    {
        <div class="cy-sidebar__header" aria-hidden="@(State == SidebarState.Hidden && !MobileOpen ? "true" : null)"
             tabindex="@(State == SidebarState.Hidden && !MobileOpen ? "-1" : null)">

            @if (HeaderBrand is not null)
            {
                <div class="cy-sidebar__brand">
                    @HeaderBrand
                </div>
            }

            @if (MobileOpen)
            {
                <button type="button" class="cy-sidebar__close" @onclick="CloseMobileDrawerAsync" aria-label="@(CloseLabel ?? "Close sidebar")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            }
            else if (UseStepControls)
            {
                <div class="cy-sidebar__steps" role="group" aria-label="@(SizeGroupLabel ?? "Sidebar size")">
                    @if (Position == SidebarPosition.Left)
                    {
                        if (CanNarrow)
                        {
                            <button type="button" class="cy-sidebar__step cy-sidebar__step--narrow" @onclick="NarrowAsync"
                                    aria-label="@NarrowLabel"
                                    tabindex="@(State == SidebarState.Hidden ? "-1" : null)">
                                <CyIcon Name="@NarrowIconName" Size="20" />
                            </button>
                        }
                        if (CanWiden)
                        {
                            <button type="button" class="cy-sidebar__step cy-sidebar__step--widen" @onclick="WidenAsync"
                                    aria-label="@WidenLabel"
                                    tabindex="@(State == SidebarState.Hidden ? "-1" : null)">
                                <CyIcon Name="@WidenIconName" Size="20" />
                            </button>
                        }
                    }
                    else
                    {
                        if (CanWiden)
                        {
                            <button type="button" class="cy-sidebar__step cy-sidebar__step--widen" @onclick="WidenAsync"
                                    aria-label="@WidenLabel"
                                    tabindex="@(State == SidebarState.Hidden ? "-1" : null)">
                                <CyIcon Name="@WidenIconName" Size="20" />
                            </button>
                        }
                        if (CanNarrow)
                        {
                            <button type="button" class="cy-sidebar__step cy-sidebar__step--narrow" @onclick="NarrowAsync"
                                    aria-label="@NarrowLabel"
                                    tabindex="@(State == SidebarState.Hidden ? "-1" : null)">
                                <CyIcon Name="@NarrowIconName" Size="20" />
                            </button>
                        }
                    }
                </div>
            }
            else if (ShowCycleOrToggle)
            {
                <button type="button" class="cy-sidebar__toggle"
                        @onclick="() => (States.Count > 1 ? CycleNextAsync() : ToggleAsync())"
                        aria-expanded="@(!EffectiveCollapsed)"
                        aria-label="@(EffectiveCollapsed ? ExpandText : CollapseText)"
                        tabindex="@(State == SidebarState.Hidden ? "-1" : null)">
                    <CyIcon Name="@ToggleIconName" Size="16" />
                </button>
            }

        </div>
    }

    @ChildContent

</aside>

@code {
#pragma warning disable CS0618
    private bool ShowCycleOrToggle => CollapseMode != SidebarCollapseMode.NonCollapsible;
#pragma warning restore CS0618

}
