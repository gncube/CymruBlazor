@inherits CyLayoutComponentBase

<aside
    id="@Id"
    class="@CssClass"
    style="@CssStyle"
    data-collapse-mode="@CollapseModeAttribute"
    @attributes="AdditionalAttributes">

    @if (Brand is not null && !EffectiveCollapsed)
    {
        <div class="cy-sidebar__brand">
            @Brand
        </div>
    }

    @ChildContent

</aside>
