@inherits CyComponentBase
@implements IDisposable
@using CymruBlazor.Components.Content

<li role="none" class="cy-menu__item-wrapper">
    <button @ref="_button"
            id="@Id"
            type="button"
            role="menuitem"
            class="@CssClass"
            style="@CssStyle"
            tabindex="@(Menu?.IsActive(this) == true ? 0 : -1)"
            aria-disabled="@(Disabled ? "true" : null)"
            @onclick="ActivateAsync"
            @attributes="AdditionalAttributes">

        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <CyIcon Name="@Icon" Size="18" />
        }

        <span class="cy-menu__item-text">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Text
            }
        </span>

    </button>
</li>
