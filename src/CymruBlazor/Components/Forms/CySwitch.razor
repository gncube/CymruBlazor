@inherits CyFormFieldComponentBase<bool>

<div class="@BuildFieldCssClass("cy-field cy-field--switch")">

    <div class="cy-switch">

        <button
            id="@FieldId"
            type="button"
            role="switch"
            class="cy-switch__control"
            aria-checked="@(CurrentValue ? "true" : "false")"
            aria-labelledby="@LabelId"
            aria-describedby="@ComputedAriaDescribedBy"
            disabled="@Disabled"
            @onclick="ToggleAsync"
            @attributes="AdditionalAttributes">

            <span class="cy-switch__track" aria-hidden="true">
                <span class="cy-switch__thumb"></span>
            </span>

        </button>

        @RenderFieldLabel("cy-switch__label", labelId: LabelId)

    </div>

    @RenderFieldHint()

    @RenderFieldError()

</div>
