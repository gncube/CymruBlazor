@inherits CyFormFieldComponentBase<bool>

<div class="@BuildFieldCssClass("cy-field cy-field--switch")">

    <div class="cy-switch">

        <button
            id="@FieldId"
            type="button"
            role="switch"
            class="cy-switch__control"
            aria-checked="@(CurrentValue ? "true" : "false")"
            aria-labelledby="@LabelId"
            aria-describedby="@ComputedAriaDescribedBy"
            disabled="@Disabled"
            @onclick="ToggleAsync"
            @attributes="AdditionalAttributes">

            <span class="cy-switch__track" aria-hidden="true">
                <span class="cy-switch__thumb"></span>
            </span>

        </button>

        <label id="@LabelId" for="@FieldId" class="cy-switch__label">
            @Label
            @if (Required)
            {
                <span class="cy-field__required-indicator" aria-hidden="true">*</span>
            }
        </label>

    </div>

    @if (!string.IsNullOrWhiteSpace(HintText))
    {
        <p id="@HintId" class="cy-field__hint">@HintText</p>
    }

    @if (HasValidationError)
    {
        <p id="@ErrorId" class="cy-field__error" role="alert">
            @ValidationMessageText
        </p>
    }

</div>
