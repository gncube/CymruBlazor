@typeparam TValue
@inherits CyFormFieldComponentBase<TValue>

<fieldset class="@BuildFieldCssClass("cy-field cy-radio-group")" aria-describedby="@ComputedAriaDescribedBy"
          @attributes="AdditionalAttributes">

    @RenderFieldLegend()

    @RenderFieldHint()

    <div class="cy-radios">
        <CascadingValue Value="(ICyRadioGroup)this">
            @if (Items is not null)
            {
                @foreach (var item in Items)
                {
                    <CyRadio Value="@(FormatValueAsString(item.Value) ?? string.Empty)"
                             Label="@item.Text"
                             HintText="@item.Hint"
                             Disabled="@item.Disabled" />
                }
            }

            @ChildContent
        </CascadingValue>
    </div>

    @RenderFieldError()

</fieldset>
