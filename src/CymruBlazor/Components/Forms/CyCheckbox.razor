@inherits CyFormFieldComponentBase<bool>

<div class="@BuildFieldCssClass("cy-field cy-field--checkbox")">

    <div class="cy-checkbox">

        <input
            id="@FieldId"
            type="checkbox"
            class="cy-checkbox__input"
            @bind="CurrentValue"
            aria-required="@Required"
            aria-invalid="@HasValidationError"
            aria-describedby="@ComputedAriaDescribedBy"
            disabled="@Disabled"
            @attributes="AdditionalAttributes" />

        @RenderFieldLabel("cy-checkbox__label")

    </div>

    @RenderFieldHint()

    @RenderFieldError()

</div>
