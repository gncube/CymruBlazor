@inherits CyFormFieldComponentBase<string>

<div class="@BuildFieldCssClass("cy-field")">

    <label for="@FieldId" class="cy-field__label">
        @Label
        @if (Required)
        {
            <span class="cy-field__required-indicator" aria-hidden="true">*</span>
        }
    </label>

    @if (!string.IsNullOrWhiteSpace(HintText))
    {
        <p id="@HintId" class="cy-field__hint">@HintText</p>
    }

    <textarea
        @attributes="AdditionalAttributes"
        id="@FieldId"
        class="cy-textarea"
        rows="@Rows"
        maxlength="@MaxLength"
        aria-required="@(Required ? "true" : "false")"
        aria-invalid="@(HasValidationError ? "true" : "false")"
        aria-describedby="@DescribedBy"
        disabled="@Disabled"
        @bind="CurrentValueAsString"
        @bind:event="oninput"></textarea>

    @if (ShowCharacterCount && MaxLength.HasValue)
    {
        <p id="@CountId" class="cy-field__hint cy-textarea__count" aria-live="polite">@CharacterCountMessage</p>
    }

    @if (HasValidationError)
    {
        <p id="@ErrorId" class="cy-field__error" role="alert">
            @string.Join(' ', EditContext.GetValidationMessages(FieldIdentifier))
        </p>
    }

</div>
