@typeparam TValue
@inherits CyFormFieldComponentBase<IEnumerable<TValue>>
@using CymruBlazor.Components.Content

<div class="@BuildFieldCssClass("cy-field cy-combobox cy-combobox--multiple")" style="@ListStyle">

    <label for="@FieldId" id="@LabelId" class="cy-field__label">
        @Label
        @if (Required)
        {
            <span class="cy-field__required-indicator" aria-hidden="true">*</span>
        }
    </label>

    @if (!string.IsNullOrWhiteSpace(HintText))
    {
        <p id="@HintId" class="cy-field__hint">@HintText</p>
    }

    @if (_chips.Count > 0)
    {
        <ul class="cy-combobox__chips" aria-label="@SelectedListLabel">
            @foreach (var chip in _chips)
            {
                var item = chip;

                <li class="cy-combobox__chip">
                    <span class="cy-combobox__chip-text">@item.Text</span>
                    @if (!Disabled && !ReadOnly)
                    {
                        <button type="button" class="cy-combobox__chip-remove" aria-label="@RemoveLabel(item)" @onclick="() => OnRemoveChipAsync(item)">
                            <CyIcon Name="close" Size="14" />
                        </button>
                    }
                </li>
            }
        </ul>
    }

    <div class="cy-combobox__control">

        <input
            @attributes="AdditionalAttributes"
            @ref="_input"
            id="@FieldId"
            type="text"
            role="combobox"
            class="cy-textbox cy-combobox__input"
            autocomplete="off"
            spellcheck="false"
            placeholder="@Placeholder"
            value="@_core.InputText"
            aria-autocomplete="list"
            aria-expanded="@(_core.Expanded ? "true" : "false")"
            aria-controls="@ListId"
            aria-activedescendant="@_core.ActiveDescendantId(ListId)"
            aria-required="@(Required ? "true" : "false")"
            aria-invalid="@(HasValidationError ? "true" : "false")"
            aria-describedby="@ComputedAriaDescribedBy"
            disabled="@Disabled"
            readonly="@ReadOnly"
            @oninput="OnInputAsync"
            @onkeydown="_core.HandleKeyDownAsync"
            @onblur="_core.HandleBlurAsync" />

        <span class="cy-combobox__chevron" aria-hidden="true">
            <CyIcon Name="chevron-down" Size="16" />
        </span>

        <div class="cy-combobox__popup" hidden="@(!_core.PopupVisible)">

            @if (_core.Message.Length > 0)
            {
                <p class="cy-combobox__message" aria-hidden="true">@_core.Message</p>
            }

            <ul
                id="@ListId"
                role="listbox"
                class="cy-combobox__list"
                aria-labelledby="@LabelId"
                aria-multiselectable="true"
                hidden="@(_core.Results.Count == 0)"
                @onmousedown="OnListMouseDown"
                @onmousedown:preventDefault>

                @for (var i = 0; i < _core.Results.Count; i++)
                {
                    var index = i;
                    var option = _core.Results[i];
                    var selected = IsSelectedValue(option.Value);

                    <li
                        id="@OptionId(index)"
                        role="option"
                        class="@OptionClass(selected, index == _core.ActiveIndex, option.Disabled)"
                        aria-selected="@(selected ? "true" : "false")"
                        aria-disabled="@(option.Disabled ? "true" : null)"
                        @onclick="() => _core.SelectAsync(option)">
                        <span class="cy-combobox__option-text">@option.Text</span>
                        @if (selected)
                        {
                            <CyIcon Name="check" Size="16" />
                        }
                    </li>
                }

            </ul>

        </div>

    </div>

    <div class="u-sr-only" role="status" aria-live="polite" aria-atomic="true">@_core.StatusText</div>

    @if (HasValidationError)
    {
        <p id="@ErrorId" class="cy-field__error" role="alert">
            @ValidationMessageText
        </p>
    }

</div>
