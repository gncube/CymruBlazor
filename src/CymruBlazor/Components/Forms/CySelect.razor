@typeparam TValue
@inherits CyFormFieldComponentBase<TValue>

<div class="@BuildFieldCssClass("cy-field")">

    <label for="@FieldId" class="cy-field__label">
        @Label
        @if (Required)
        {
            <span class="cy-field__required-indicator" aria-hidden="true">*</span>
        }
    </label>

    @if (!string.IsNullOrWhiteSpace(HintText))
    {
        <p id="@HintId" class="cy-field__hint">@HintText</p>
    }

    <select
        id="@FieldId"
        class="cy-select"
        @bind="CurrentValueAsString"
        aria-required="@Required"
        aria-invalid="@HasValidationError"
        aria-describedby="@ComputedAriaDescribedBy"
        disabled="@Disabled"
        @attributes="AdditionalAttributes">

        @ChildContent

    </select>

    @if (HasValidationError)
    {
        <p id="@ErrorId" class="cy-field__error" role="alert">
            @string.Join(' ', EditContext.GetValidationMessages(FieldIdentifier))
        </p>
    }

</div>
