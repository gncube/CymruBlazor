@typeparam TValue
@inherits CyFormFieldComponentBase<TValue>

<div class="@BuildFieldCssClass("cy-field cy-field--number")">

    @RenderFieldLabel()

    @RenderFieldHint()

    <div class="cy-input-affix">

        <input
            @attributes="AdditionalAttributes"
            id="@FieldId"
            type="text"
            class="cy-textbox cy-number-input"
            placeholder="@Placeholder"
            inputmode="@ResolvedInputMode"
            autocomplete="off"
            @bind="CurrentValueAsString"
            aria-required="@(Required ? "true" : "false")"
            aria-invalid="@(HasValidationError ? "true" : "false")"
            aria-describedby="@DescribedBy"
            disabled="@Disabled" />

        @if (!string.IsNullOrWhiteSpace(Unit))
        {
            <span id="@UnitId" class="cy-input-affix__suffix">@Unit</span>
        }

    </div>

    @RenderFieldError()

</div>
