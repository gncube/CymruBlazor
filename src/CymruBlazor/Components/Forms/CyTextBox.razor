@inherits CyFormFieldComponentBase<string>

<div class="@BuildFieldCssClass("cy-field")">

    @RenderFieldLabel()

    @RenderFieldHint()

    <input
        @attributes="AdditionalAttributes"
        id="@FieldId"
        type="@Type"
        class="cy-textbox"
        placeholder="@Placeholder"
        maxlength="@MaxLength"
        inputmode="@InputMode"
        autocomplete="@Autocomplete"
        @bind="CurrentValueAsString"
        aria-required="@(Required ? "true" : "false")"
        aria-invalid="@(HasValidationError ? "true" : "false")"
        aria-describedby="@ComputedAriaDescribedBy"
        disabled="@Disabled" />

    @RenderFieldError()

</div>
