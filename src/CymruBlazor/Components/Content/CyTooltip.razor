@inherits CyLayoutComponentBase

<span id="@Id" class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">
    <span class="cy-tooltip__trigger"
          tabindex="@(Focusable ? "0" : null)"
          aria-describedby="@(Focusable ? ContentId : null)">@ChildContent</span>
    <span id="@ContentId" class="cy-tooltip__content" role="tooltip">@Text</span>
</span>
