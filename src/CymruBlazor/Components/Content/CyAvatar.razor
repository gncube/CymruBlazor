@namespace CymruBlazor.Components.Content
@inherits CyComponentBase

@if (OnClick.HasDelegate)
{
    <button id="@Id"
            type="button"
            class="@CssClass"
            style="@CssStyle"
            aria-label="@(Decorative ? null : AccessibleLabel)"
            aria-hidden="@(Decorative ? "true" : null)"
            @onclick="OnClick"
            @attributes="AdditionalAttributes">
        @Content
        @if (Status != AvatarStatus.None)
        {
            <span class="@StatusCssClass" aria-hidden="true"></span>
        }
    </button>
}
else if (Decorative)
{
    <span id="@Id"
          class="@CssClass"
          style="@CssStyle"
          aria-hidden="true"
          @attributes="AdditionalAttributes">
        @Content
        @if (Status != AvatarStatus.None)
        {
            <span class="@StatusCssClass" aria-hidden="true"></span>
        }
    </span>
}
else
{
    <span id="@Id"
          class="@CssClass"
          style="@CssStyle"
          role="img"
          aria-label="@AccessibleLabel"
          @attributes="AdditionalAttributes">
        @Content
        @if (Status != AvatarStatus.None)
        {
            <span class="@StatusCssClass" aria-hidden="true"></span>
        }
    </span>
}

@code {
    private RenderFragment Content => __builder =>
    {
        if (HasActiveImage)
        {
            <img class="cy-avatar__image" src="@ImageUrl" alt="" @onerror="HandleImageError" />
        }
        else
        {
            <span class="cy-avatar__initials" aria-hidden="true">@InitialsText</span>
        }
    };
}
