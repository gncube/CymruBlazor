@using CymruBlazor.Icons
@inherits CyLayoutComponentBase

<svg
    id="@Id"
    class="@CssClass"
    style="@CssStyle"
    width="@Size"
    height="@Size"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    role="@AriaRole"
    aria-hidden="@AriaHidden"
    aria-label="@Label"
    @attributes="AdditionalAttributes">

    @((MarkupString)IconMarkup)

</svg>
