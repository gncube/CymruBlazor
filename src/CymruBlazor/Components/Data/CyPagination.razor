@inherits CyComponentBase
@using CymruBlazor.Components.Content

@if (TotalPages > 1)
{
    <nav
        id="@Id"
        class="@CssClass"
        style="@CssStyle"
        aria-label="@(AriaLabel ?? "Pagination")"
        @attributes="AdditionalAttributes">

        <ul class="cy-pagination__list">

            <li>
                <button
                    type="button"
                    class="cy-pagination__control cy-pagination__control--previous"
                    disabled="@(CurrentPage <= 1)"
                    @onclick="() => GoToAsync(CurrentPage - 1)">
                    <CyIcon Name="chevron-left" Size="16" />
                    <span>@(PreviousLabel ?? "Previous")</span>
                </button>
            </li>

            @foreach (var pageNumber in PageItems)
            {
                <li>
                    @if (pageNumber is null)
                    {
                        <span class="cy-pagination__ellipsis" aria-hidden="true">&hellip;</span>
                    }
                    else if (pageNumber == CurrentPage)
                    {
                        <span
                            class="cy-pagination__page cy-pagination__page--current"
                            aria-current="page"
                            aria-label="@FormatCurrentPageLabel(pageNumber.Value)">
                            @pageNumber
                        </span>
                    }
                    else
                    {
                        <button
                            type="button"
                            class="cy-pagination__page"
                            aria-label="@FormatPageLabel(pageNumber.Value)"
                            @onclick="() => GoToAsync(pageNumber.Value)">
                            @pageNumber
                        </button>
                    }
                </li>
            }

            <li>
                <button
                    type="button"
                    class="cy-pagination__control cy-pagination__control--next"
                    disabled="@(CurrentPage >= TotalPages)"
                    @onclick="() => GoToAsync(CurrentPage + 1)">
                    <span>@(NextLabel ?? "Next")</span>
                    <CyIcon Name="chevron-right" Size="16" />
                </button>
            </li>

        </ul>

    </nav>
}
