@typeparam TItem
@inherits CyComponentBase
@using CymruBlazor.Components.Content
@using CymruBlazor.Components.Feedback
@using CymruBlazor.Components.Forms

<div id="@Id" class="@CssClass" style="@CssStyle" @attributes="AdditionalAttributes">

    @if (Toolbar is not null)
    {
        <div class="cy-data-table__toolbar">@Toolbar</div>
    }

    @if (ShowSearch || HasActiveFilters)
    {
        <div class="cy-data-table__filter-bar">
            @if (ShowSearch)
            {
                <div class="cy-data-table__search">
                    <CyIcon Name="search" Size="16" Class="cy-data-table__search-icon" />
                    <input
                        type="search"
                        class="cy-data-table__search-input"
                        placeholder="@EffectiveText.SearchPlaceholder"
                        aria-label="@EffectiveText.SearchLabel"
                        value="@_searchQuery"
                        @oninput="HandleSearchInputAsync" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button type="button"
                                class="cy-data-table__search-clear"
                                aria-label="@EffectiveText.ClearAllFilters"
                                @onclick="ClearSearchAsync">
                            <CyIcon Name="close" Size="14" />
                        </button>
                    }
                </div>
            }

            @if (HasActiveFilters)
            {
                <button type="button"
                        class="cy-data-table__clear-filters-btn"
                        @onclick="ClearAllFiltersAsync">
                    <CyIcon Name="close" Size="14" />
                    <span>@EffectiveText.ClearAllFilters</span>
                </button>
            }
        </div>
    }

    @if (SelectionMode != CyDataSelectionMode.None && SelectedCount > 0)
    {
        <div class="cy-data-table__bulk-bar" role="region" aria-label="@Format(EffectiveText.SelectedCount, SelectedCount)">
            <div class="cy-data-table__bulk-info">
                <span class="cy-data-table__selection cy-data-table__bulk-count">
                    @Format(EffectiveText.SelectedCount, SelectedCount)
                </span>

                @if (ShowSelectAllAcrossPages && Items is not null && _total > _view.Count && SelectedCount < _total)
                {
                    <button type="button"
                            class="cy-data-table__bulk-link"
                            @onclick="SelectAllRecordsAsync">
                        @Format(EffectiveText.SelectAllAcrossPages, _total)
                    </button>
                }
            </div>

            <div class="cy-data-table__bulk-actions">
                @if (BulkActions is not null)
                {
                    @BulkActions(SelectedItemsList)
                }

                <button type="button"
                        class="cy-data-table__bulk-clear"
                        @onclick="ClearSelectionAsync">
                    @EffectiveText.ClearSelection
                </button>
            </div>
        </div>
    }

    <CyTable Caption="@Caption" CaptionVisuallyHidden="CaptionVisuallyHidden" Wrap="Wrap" aria-busy="@(Busy ? "true" : "false")">

        <thead>
            <tr>
                @if (SelectionMode != CyDataSelectionMode.None)
                {
                    <th scope="col" class="cy-data-table__select-cell">
                        @if (SelectionMode == CyDataSelectionMode.Multiple)
                        {
                            <input
                                type="checkbox"
                                class="@(SomePageSelected ? "cy-data-table__checkbox cy-data-table__checkbox--header cy-data-table__checkbox--indeterminate" : "cy-data-table__checkbox cy-data-table__checkbox--header")"
                                checked="@AllPageSelected"
                                disabled="@(_view.Count == 0)"
                                aria-label="@SelectAllHeaderLabel"
                                @onchange="e => TogglePageAsync(e.Value is true)" />
                        }
                        else
                        {
                            <span class="u-sr-only">@EffectiveText.SelectColumn</span>
                        }
                    </th>
                }

                @if (DetailTemplate is not null)
                {
                    <th scope="col" class="cy-data-table__expand-cell">
                        <span class="u-sr-only">@EffectiveText.ExpandColumn</span>
                    </th>
                }

                @foreach (var column in Columns)
                {
                    var col = column;

                    <th scope="col" class="@HeaderClass(col)" style="@WidthStyle(col)" aria-sort="@AriaSort(col)">
                        @if (col.Sortable)
                        {
                            <button type="button" class="cy-data-table__sort" @onclick="() => SortAsync(col)">
                                <span class="@(col.HeaderVisuallyHidden ? "u-sr-only" : null)">@col.Header</span>
                                <CyIcon Name="@SortIcon(col)" Size="14" />
                            </button>
                        }
                        else if (col.HeaderVisuallyHidden)
                        {
                            <span class="u-sr-only">@col.Header</span>
                        }
                        else
                        {
                            @col.Header
                        }
                    </th>
                }

                @if (RowActions is not null)
                {
                    <th scope="col"><span class="u-sr-only">@EffectiveText.ActionsHeader</span></th>
                }
            </tr>

            @if (HasColumnFilters)
            {
                <tr class="cy-data-table__filter-row">
                    @if (SelectionMode != CyDataSelectionMode.None)
                    {
                        <td class="cy-data-table__select-cell"></td>
                    }

                    @if (DetailTemplate is not null)
                    {
                        <td class="cy-data-table__expand-cell"></td>
                    }

                    @foreach (var column in Columns)
                    {
                        var col = column;
                        <td class="@CellClass(col)">
                            @if (col.FilterTemplate is not null)
                            {
                                @col.FilterTemplate(new CyColumnFilterContext(
                                    col.EffectiveFilterKey,
                                    GetFilterValue(col.EffectiveFilterKey),
                                    EventCallback.Factory.Create<string?>(this, val => SetColumnFilterAsync(col.EffectiveFilterKey, val)),
                                    EventCallback.Factory.Create(this, () => ClearColumnFilterAsync(col.EffectiveFilterKey))
                                ))
                            }
                            else if (col.Filterable)
                            {
                                <input
                                    type="text"
                                    class="cy-data-table__column-filter-input"
                                    placeholder="@(col.FilterPlaceholder ?? Format(EffectiveText.FilterColumn, col.Header))"
                                    aria-label="@Format(EffectiveText.FilterColumn, col.Header)"
                                    value="@GetFilterValue(col.EffectiveFilterKey)"
                                    @oninput="e => HandleColumnFilterInputAsync(col.EffectiveFilterKey, e.Value?.ToString())" />
                            }
                        </td>
                    }

                    @if (RowActions is not null)
                    {
                        <td></td>
                    }
                </tr>
            }
        </thead>

        <tbody>
            @if (ShowSkeleton)
            {
                @for (var row = 0; row < SkeletonRows; row++)
                {
                    <tr class="cy-data-table__skeleton-row">
                        <td colspan="@ColumnSpan"><CySkeleton Announce="false" /></td>
                    </tr>
                }
            }
            else if (_loadError)
            {
                <tr>
                    <td colspan="@ColumnSpan" class="cy-data-table__message">
                        <p class="cy-data-table__error" role="alert">@EffectiveText.LoadError</p>
                        <button type="button" class="cy-data-table__retry" @onclick="RefreshAsync">@EffectiveText.Retry</button>
                    </td>
                </tr>
            }
            else if (_view.Count == 0)
            {
                <tr>
                    <td colspan="@ColumnSpan" class="cy-data-table__message">
                        @if (EmptyContent is not null)
                        {
                            @EmptyContent
                        }
                        else
                        {
                            <p class="cy-data-table__empty">@EffectiveText.NoResults</p>
                        }
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in _view)
                {
                    var current = item;
                    var selected = IsSelected(current);
                    var isExpanded = IsExpanded(current);

                    <tr class="@RowClass(selected, isExpanded)" @onkeydown="e => HandleRowKeyDownAsync(current, e)">

                        @if (SelectionMode != CyDataSelectionMode.None)
                        {
                            <td class="cy-data-table__select-cell" data-label="@EffectiveText.SelectColumn">
                                @if (SelectionMode == CyDataSelectionMode.Multiple)
                                {
                                    <input
                                        type="checkbox"
                                        class="cy-data-table__checkbox"
                                        checked="@selected"
                                        aria-label="@SelectRowLabel(current)"
                                        @onclick="e => HandleRowSelectClickAsync(current, e)"
                                        @onchange="e => ToggleAsync(current, e.Value is true)" />
                                }
                                else
                                {
                                    <input
                                        type="radio"
                                        class="cy-data-table__checkbox"
                                        name="@RadioName"
                                        checked="@selected"
                                        aria-label="@SelectRowLabel(current)"
                                        @onchange="() => SelectSingleAsync(current)" />
                                }
                            </td>
                        }

                        @if (DetailTemplate is not null)
                        {
                            <td class="cy-data-table__expand-cell" data-label="@EffectiveText.ExpandColumn">
                                <button
                                    type="button"
                                    id="@RowTriggerId(current)"
                                    class="cy-data-table__expand-button"
                                    aria-expanded="@(isExpanded ? "true" : "false")"
                                    aria-controls="@RowDetailId(current)"
                                    aria-label="@ExpandRowLabel(current, isExpanded)"
                                    @onclick="() => ToggleRowDetailsAsync(current)"
                                    @onclick:stopPropagation="true">
                                    <CyIcon Name="chevron-right" Class="@(isExpanded ? "cy-data-table__expand-icon cy-data-table__expand-icon--expanded" : "cy-data-table__expand-icon")" Size="16" />
                                </button>
                            </td>
                        }

                        @foreach (var column in Columns)
                        {
                            var col = column;

                            @if (col.RowHeader)
                            {
                                <th scope="row" class="@CellClass(col)" data-label="@col.Header">@CellContent(col, current)</th>
                            }
                            else
                            {
                                <td class="@CellClass(col)" title="@CellTitle(col, current)" data-label="@col.Header">@CellContent(col, current)</td>
                            }
                        }

                        @if (RowActions is not null)
                        {
                            <td class="cy-data-table__actions-cell" data-label="@EffectiveText.ActionsHeader">@RowActions(current)</td>
                        }

                    </tr>

                    @if (DetailTemplate is not null && isExpanded)
                    {
                        <tr id="@RowDetailId(current)" class="cy-data-table__detail-row">
                            <td colspan="@ColumnSpan" class="cy-data-table__detail-cell">
                                <div class="cy-data-table__detail-content">
                                    @DetailTemplate(current)
                                </div>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>

    </CyTable>

    @if (_pageSize > 0)
    {
        <div class="cy-data-table__footer">
            @if (_total > 0)
            {
                <p class="cy-data-table__range" tabindex="-1" @ref="_range">@RangeText</p>
            }

            @if (ShowPageSizes)
            {
                <div class="cy-data-table__page-size">
                    <CySelect TValue="int"
                              Label="@EffectiveText.RowsPerPage"
                              Items="PageSizeChoices"
                              Value="_pageSize"
                              ValueChanged="OnPageSizeChangedAsync"
                              ValueExpression="@(() => _pageSize)" />
                </div>
            }

            <CyPagination
                AriaLabel="@PaginationLabel"
                CurrentPage="_page"
                TotalPages="TotalPages"
                CurrentPageChanged="OnPageChangedAsync" />
        </div>
    }

    <div class="u-sr-only" role="status" aria-live="polite" aria-atomic="true">@_status</div>

</div>
