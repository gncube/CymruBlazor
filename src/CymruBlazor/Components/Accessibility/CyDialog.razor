@inherits CyLayoutComponentBase
@using CymruBlazor.Enums

<dialog @ref="_dialog"
        id="@Id"
        class="@CssClass"
        style="@CssStyle"
        aria-labelledby="@(Open ? TitleId : null)"
        aria-describedby="@(Open && HasDescription ? DescriptionId : null)"
        @attributes="AdditionalAttributes">

    @if (Open)
    {
        <div class="cy-dialog__panel">

            <div class="cy-dialog__header">
                <h2 id="@TitleId" class="cy-dialog__title">@Title</h2>

                @if (Dismissible)
                {
                    <button type="button"
                            class="cy-dialog__close"
                            aria-label="@(CloseLabel ?? "Close")"
                            @onclick="CloseFromUiAsync">
                        <span aria-hidden="true">&times;</span>
                    </button>
                }
            </div>

            <div class="cy-dialog__body">
                @if (HasDescription)
                {
                    <p id="@DescriptionId" class="cy-dialog__description">@Description</p>
                }

                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <div class="cy-dialog__footer">
                    @Footer
                </div>
            }

        </div>
    }

</dialog>
