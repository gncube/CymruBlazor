@inherits CyInteractiveComponentBase
@using CymruBlazor.Components.Content
@using CymruBlazor.Enums

@if (Href is not null && !Disabled)
{
    <a
        href="@Href"
        id="@Id"
        class="@CssClass"
        style="@CssStyle"
        aria-label="@AriaLabel"
        aria-labelledby="@AriaLabelledBy"
        aria-describedby="@AriaDescribedBy"
        tabindex="@ComputedTabIndex"
        @attributes="AdditionalAttributes">

        @Inner

    </a>
}
else
{
    <button
        type="@Type"
        id="@Id"
        class="@EffectiveCssClass"
        style="@CssStyle"
        disabled="@(Disabled || IsBusy)"
        aria-label="@AriaLabel"
        aria-labelledby="@AriaLabelledBy"
        aria-describedby="@AriaDescribedBy"
        aria-busy="@(IsBusy ? "true" : null)"
        tabindex="@ComputedTabIndex"
        @onclick="HandleClickAsync"
        @attributes="AdditionalAttributes">

        @Inner

    </button>
}

@code {
    // Shared by the <button> and <a> renderings so the two can't drift.
    private RenderFragment Inner => @<text>
        @if (IsBusy)
        {
            <span class="cy-button__spinner" aria-hidden="true"></span>
        }
        @if (HasIcon && IconPlacement == ButtonIconPlacement.Start)
        {
            <CyIcon Name="@(Icon!)" Size="@IconPixelSize" Class="cy-button__icon cy-button__icon--start" />
        }
        @if (IconOnly)
        {
            @if (ChildContent is not null)
            {
                <span class="u-sr-only">@ChildContent</span>
            }
        }
        else
        {
            <span class="cy-button__content">@ChildContent</span>
        }
        @if (HasIcon && IconPlacement == ButtonIconPlacement.End)
        {
            <CyIcon Name="@(Icon!)" Size="@IconPixelSize" Class="cy-button__icon cy-button__icon--end" />
        }
    </text>;
}
