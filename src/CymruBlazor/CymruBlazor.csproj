<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Target -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>

    <!-- NuGet metadata -->
    <PackageId>CymruBlazor</PackageId>
    <Title>CymruBlazor</Title>
    <Description>
      An open-source Blazor component library implementing the NHS Wales Design System.
      Provides accessible, enterprise-grade components aligned with WCAG 2.2 AA.
    </Description>

    <Authors>CymruBlazor Contributors</Authors>
    <Company>Digital Health and Care Wales Community</Company>
    <Copyright>Copyright © 2025 CymruBlazor Contributors</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PackageProjectUrl>https://github.com/gncube/CymruBlazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gncube/CymruBlazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageTags>
      blazor;
      nhs;
      nhswales;
      design-system;
      components;
      accessibility;
      wcag
    </PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      PackageIcon intentionally omitted until real artwork exists.
    -->

    <!--
      MinVer supplies PackageVersion, AssemblyVersion, FileVersion
      and InformationalVersion from the Git tag.
    -->

    <!-- SourceLink and symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Package validation: fail `dotnet pack` on accidental breaking API
      changes versus the last published release (1.x promises semver).
      Bump PackageValidationBaselineVersion when a release is published
      (see CONTRIBUTING.md). Opt out offline with
      -p:EnablePackageValidation=false; CI never does. Intentional breaks
      (2.0.0) are recorded in CompatibilitySuppressions.xml.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Trimming / AOT -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- CI quality gates -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Package README -->
  <ItemGroup>
    <None Include="..\..\README.md"
      Pack="true"
      PackagePath="\" />
  </ItemGroup>

  <!-- Build-time tooling -->
  <ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />

    <PackageReference Include="Mediator.SourceGenerator">
      <IncludeAssets>
        runtime; build; native; contentfiles; analyzers; buildtransitive
      </IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.SourceLink.GitHub"
      PrivateAssets="all" />

    <PackageReference Include="MinVer"
      PrivateAssets="all" />
  </ItemGroup>

  <!-- Runtime dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.JSInterop" />
  </ItemGroup>

  <!--
    Bundles wwwroot/css/cymrublazor.css into a single, runtime-import-free
    stylesheet on Release/Publish builds. See build/BundleCss.targets and
    CONTRIBUTING.md for details.
  -->
  <Import Project="build\BundleCss.targets" />

</Project>
