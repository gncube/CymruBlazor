<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>

    <!-- NuGet metadata -->
    <PackageId>CymruBlazor.Testing.Axe</PackageId>
    <Title>CymruBlazor.Testing.Axe</Title>
    <Description>
      Browser accessibility tests for apps built with CymruBlazor: renders a component with bUnit, loads it with the
      library's own CSS into Chromium through Playwright, and scans it with axe-core in the light, dark and
      high-contrast themes.
    </Description>

    <Authors>CymruBlazor Contributors</Authors>
    <Company>Digital Health and Care Wales Community</Company>
    <Copyright>Copyright © 2025 CymruBlazor Contributors</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PackageProjectUrl>https://github.com/gncube/CymruBlazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gncube/CymruBlazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageTags>
      blazor;
      nhs;
      nhswales;
      bunit;
      playwright;
      axe;
      testing;
      accessibility
    </PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      MinVer supplies the version from the same Git tag as CymruBlazor, so the packages are released in
      lock-step: CymruBlazor.Testing.Axe X.Y.Z depends on CymruBlazor.Testing X.Y.Z, which depends on CymruBlazor X.Y.Z.
    -->

    <!-- SourceLink and symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Package validation compares this package with the last published version, so an accidental
      breaking API change fails `dotnet pack`. Bump the baseline when a release is published
      (see CONTRIBUTING.md). First published in 1.13.0.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.13.0</PackageValidationBaselineVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- CI quality gates -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.Playwright" />

    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />

    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CymruBlazor.AccessibilityTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CymruBlazor.Testing\CymruBlazor.Testing.csproj" />
  </ItemGroup>

</Project>
