<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Populated by New-LocalPackageFeed.ps1 (dotnet pack -o ./artifacts).
      The samples (samples/StarterApp, samples/Dashboard,
      samples/HealthcarePortal) restore CymruBlazor from here, never via
      a ProjectReference to src/CymruBlazor - see
      plan/active/rebuild-samples-vertical-slice.md.
    -->
    <add key="local" value="./artifacts" />
  </packageSources>
</configuration>
