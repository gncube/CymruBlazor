<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StarterApp</RootNamespace>

    <!-- Sample app, not a library - never packed. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No version here - resolved from ./artifacts via the "local" source
      in nuget.config, at whatever version New-LocalPackageFeed.ps1 wrote
      to local-package-versions.props. See CONTRIBUTING.md.
    -->
    <PackageReference Include="CymruBlazor" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      PrivateAssets="all" />
  </ItemGroup>

</Project>
