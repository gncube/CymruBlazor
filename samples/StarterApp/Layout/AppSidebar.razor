<CySidebar @ref="_sidebar"
           Collapsed="@Collapsed"
           CollapsedChanged="@CollapsedChanged"
           CollapseMode="SidebarCollapseMode.Compact"
           Width="SidebarWidth.Small"
           Class="app-shell__sidebar">

    <Brand>
        <CyBrandLogo Variant="BrandLogoVariant.Stacked"
                     Text="NHS Wales"
                     AriaLabel="GIG Cymru NHS Wales, Digital Health and Care Wales home"
                     Size="ComponentSize.Large"
                     Href="/" />
    </Brand>

    <ChildContent>

        @foreach (var section in MenuSections)
        {
            <span class="cy-sidebar__heading">@section.Heading</span>

            @foreach (var item in section.Items)
            {
                var isActive = string.Equals(ActiveHref, item.Href, StringComparison.OrdinalIgnoreCase)
                    || (item.Href == "/" && string.IsNullOrEmpty(ActiveHref));

                <a href="@item.Href"
                   class="cy-sidebar__item app-shell__nav-link @(isActive ? "cy-sidebar__item--active app-shell__nav-link--active" : string.Empty)">
                    <CyIcon Name="@item.IconName" Size="20" />
                    <span class="cy-sidebar__label">@item.Label</span>

                    @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                    {
                        <span class="app-shell__nav-badge">@item.BadgeText</span>
                    }

                    @if (item.HasSubmenu)
                    {
                        <CyIcon Name="chevron-down" Size="14" Class="app-shell__nav-chevron" />
                    }
                </a>
            }
        }

        <div class="app-shell__sidebar-footer">
            @foreach (var footerItem in FooterLinks)
            {
                <a href="@footerItem.Href" class="cy-sidebar__item app-shell__nav-link">
                    <CyIcon Name="@footerItem.IconName" Size="20" />
                    <span class="cy-sidebar__label">@footerItem.Label</span>
                </a>
            }
        </div>

    </ChildContent>

</CySidebar>
