@namespace CymruBlazor.Samples.Dashboard.Components

<CymruCard Title="Waiting List by Specialty" AriaLabel="Waiting list by specialty">
    <table class="dashboard-waiting-table">
        <caption class="cy-visually-hidden">Number of patients waiting and breach risk per specialty</caption>
        <thead>
            <tr>
                <th scope="col">Specialty</th>
                <th scope="col">Waiting</th>
                <th scope="col">Breach risk</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var specialty in Specialties)
            {
                <tr>
                    <th scope="row">@specialty.Name</th>
                    <td>@specialty.PatientsWaiting</td>
                    <td>
                        @if (specialty.BreachRiskCount > 0)
                        {
                            <CymruStatusBadge Text="@($"{specialty.BreachRiskCount} at risk")" Severity="specialty.Severity" />
                        }
                        else
                        {
                            <CymruStatusBadge Text="None" Severity="CymruSeverity.Success" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</CymruCard>

@code {
    /// <summary>Per-specialty waiting list figures.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Models.WaitingListSpecialty> Specialties { get; set; } = [];
}
