@namespace CymruBlazor.Samples.Dashboard.Components

<CyCard aria-label="Waiting list by specialty">
    <Header>
        <span class="dashboard-card__header-title">
            <CyTypography Variant="TypographyVariant.H2">Waiting List by Specialty</CyTypography>
            <CyTooltip Class="dashboard-info-tip" Text="Patients currently waiting, and how many are at risk of breaching the target wait time.">
                <CyIcon Name="info" Size="14" Label="About the waiting list" />
            </CyTooltip>
        </span>
    </Header>
    <ChildContent>
        <CyTable Caption="Number of patients waiting and breach risk per specialty" CaptionVisuallyHidden="true">
            <thead>
                <tr>
                    <th scope="col">Specialty</th>
                    <th scope="col">Waiting</th>
                    <th scope="col">Breach risk</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var specialty in Specialties)
                {
                    <tr>
                        <th scope="row">@specialty.Name</th>
                        <td>@specialty.PatientsWaiting</td>
                        <td>
                            @if (specialty.BreachRiskCount > 0)
                            {
                                <CyBadge Variant="specialty.Severity">@(specialty.BreachRiskCount) at risk</CyBadge>
                            }
                            else
                            {
                                <CyBadge Variant="ComponentColour.Success">None</CyBadge>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </CyTable>
    </ChildContent>
</CyCard>

@code {
    /// <summary>Per-specialty waiting list figures.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Models.WaitingListSpecialty> Specialties { get; set; } = [];
}
