@namespace CymruBlazor.Samples.Dashboard.Components

<CyCard aria-label="Ward occupancy">
    <Header>
        <span class="dashboard-card__header-title">
            <CyTypography Variant="TypographyVariant.H2">Ward Occupancy</CyTypography>
            <span class="dashboard-info-tip" tabindex="0" aria-label="Occupied beds out of total available beds, updated in real time.">
                <CyIcon Name="info" Size="14" />
            </span>
        </span>
    </Header>
    <ChildContent>
        <div class="dashboard-occupancy-list">
            @foreach (var area in Areas)
            {
                <div class="dashboard-progress" role="group" aria-label="@area.WardName">
                    <div class="dashboard-progress__label">
                        <span>@area.WardName</span>
                        <span>@area.OccupiedBeds / @area.TotalBeds beds</span>
                    </div>
                    <div class="dashboard-progress__track">
                        <div class="dashboard-progress__fill dashboard-progress__fill--@area.Severity.ToString().ToLowerInvariant()"
                             style="width: @(area.TotalBeds == 0 ? 0 : area.OccupiedBeds * 100 / area.TotalBeds)%">
                        </div>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</CyCard>

@code {
    /// <summary>Occupancy figures for each ward.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Models.OccupancyArea> Areas { get; set; } = [];
}
