@namespace CymruBlazor.Samples.Dashboard.Components

<CyCard aria-label="Ward occupancy">
    <Header>
        <span class="dashboard-card__header-title">
            <CyTypography Variant="TypographyVariant.H2">Ward Occupancy</CyTypography>
            <CyTooltip Class="dashboard-info-tip" Text="Occupied beds out of total available beds, updated in real time.">
                <CyIcon Name="info" Size="14" Label="About ward occupancy" />
            </CyTooltip>
        </span>
    </Header>
    <ChildContent>
        <div class="dashboard-occupancy-list">
            @foreach (var area in Areas)
            {
                <CyProgress
                    Label="@area.WardName"
                    Value="area.OccupiedBeds"
                    Max="@(area.TotalBeds == 0 ? 1 : area.TotalBeds)"
                    ValueText="@($"{area.OccupiedBeds} / {area.TotalBeds} beds")"
                    Colour="area.Severity" />
            }
        </div>
    </ChildContent>
</CyCard>

@code {
    /// <summary>Occupancy figures for each ward.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Models.OccupancyArea> Areas { get; set; } = [];
}
