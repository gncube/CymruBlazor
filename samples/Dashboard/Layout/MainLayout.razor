@inherits LayoutComponentBase
@inject ThemeService Theme

<CymruThemeProvider>
    <CySkipLink TargetId="main-content" />

    <CyNavigation Class="app-shell__nav">
        <Brand>
            <CymruIcon Name="CymruIconName.Stethoscope" Size="24" />
            <span>Bwrdd Iechyd Demo</span>
        </Brand>
        <ChildContent>
            @foreach (var item in _navItems)
            {
                <CyNavigationItem Text="@item.Text" Href="@item.Href" />
            }
        </ChildContent>
    </CyNavigation>

    <div class="app-shell">
        <header class="app-shell__topbar">
            <button type="button" class="cymru-btn app-shell__theme-toggle" @onclick="() => Theme.CycleTheme()">
                <CymruIcon Name="@ThemeIcon" Size="18" />
                @ThemeLabel
            </button>
        </header>

        <main id="main-content" class="app-shell__main" tabindex="-1">
            @Body
        </main>
    </div>
</CymruThemeProvider>

@code {
    private sealed record NavItem(string Text, string Href);

    private static readonly NavItem[] _navItems =
    [
        new("Dashboard", "/"),
        new("Appointments", "/appointments"),
        new("Wards", "/wards"),
        new("Reports", "/reports")
    ];

    private CymruIconName ThemeIcon => Theme.Theme switch
    {
        CymruTheme.Dark => CymruIconName.Moon,
        CymruTheme.Light => CymruIconName.Sun,
        _ => CymruIconName.Sun
    };

    private string ThemeLabel => Theme.Theme switch
    {
        CymruTheme.Dark => "Dark theme",
        CymruTheme.Light => "Light theme",
        _ => "System theme"
    };
}
