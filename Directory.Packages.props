<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CymruBlazorPackageVersion>2.0.1</CymruBlazorPackageVersion>
  </PropertyGroup>

  <!--
    Stamp the central package version into assembly metadata so the demo application
    and components can resolve the authoritative release version without preview suffixes.
  -->
  <ItemGroup Condition="'$(CymruBlazorPackageVersion)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CymruBlazorPackageVersion</_Parameter1>
      <_Parameter2>$(CymruBlazorPackageVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
    <!--
      MinVer computes a new CymruBlazor version on tag releases.
      CymruBlazorPackageVersion defines the authoritative central package version (2.0.1)
      consumed by samples and the demo application header.
    -->
    <PackageVersion Include="CymruBlazor" Version="$(CymruBlazorPackageVersion)" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Authentication.WebAssembly.Msal" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.JSInterop" Version="10.0.13" />
    <PackageVersion Include="Moq" Version="4.21.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>
  <ItemGroup Label="Source Link">
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>
  <!--
    Generated by New-LocalPackageFeed.ps1, git-ignored. Overrides the
    CymruBlazor placeholder above with whatever version was actually just
    packed to ./artifacts. Absent on a fresh clone until that script has
    been run once.
  -->
  <Import Project="local-package-versions.props" Condition="Exists('local-package-versions.props')" />
</Project>
